@page "/watchlist"
@rendermode InteractiveServer
@using BorsaAjani_Web.Services
@using Microsoft.AspNetCore.Components.Web
@inject FinansalAjanService Ajan
@inject NavigationManager Nav

<PageTitle>Watchlist — Borsa Ajanı</PageTitle>

<div class="ha-shell">

    @* ── Sidebar ── *@
    <nav class="ha-sidebar">
        <a href="/" class="ha-sb-logo" title="Ana Sayfa">B</a>
        <a href="/hisse-analizi" class="ha-sb-icon" title="Analiz">◎</a>
        <a href="/watchlist" class="ha-sb-icon active" title="Watchlist">☆</a>
        <a href="/paper-trading" class="ha-sb-icon" title="Paper Trading">▣</a>
        <a href="/gecmis" class="ha-sb-icon" title="Geçmiş">⌛</a>
        <div style="flex:1"></div>
        <a href="/" class="ha-sb-icon" title="Ana Sayfa">⌂</a>
    </nav>

    @* ── Main ── *@
    <main class="ha-main">

        @* Header *@
        <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:16px;">
            <div>
                <h1 style="font-family:var(--f-hand); font-size:28px; color:var(--wf-ink); margin:0;">⭐ Watchlist</h1>
                <span class="sk-tag" style="display:block; margin-top:4px;">Hermes haber pipeline takip listesi</span>
            </div>
            <div style="display:flex; gap:8px; align-items:center;">
                <input @bind="newSymbol" @bind:event="oninput" @onkeydown="HandleKey"
                       placeholder="Sembol — AAPL, BTC-USD"
                       class="sk-input" style="width:180px; text-transform:uppercase; font-family:var(--f-hand);" />
                <select @bind="newMode" class="sk-input" style="width:90px;">
                    <option value="STOCK">Hisse</option>
                    <option value="CRYPTO">Kripto</option>
                </select>
                <button @onclick="AddSymbol" disabled="@isAdding" class="wf-btn primary">
                    @(isAdding ? "Ekleniyor…" : "+ Ekle")
                </button>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(message))
        {
            <div class="sk-card" style="margin-bottom:14px; border-color:@(messageOk ? "var(--wf-buy)" : "var(--wf-sell)"); background:@(messageOk ? "var(--wf-buy-soft)" : "var(--wf-sell-soft)"); color:@(messageOk ? "var(--wf-buy)" : "var(--wf-sell)"); font-family:var(--f-hand); font-size:13px;">
                @message
            </div>
        }

        @if (isLoading)
        {
            <div style="text-align:center; padding:60px 0; font-family:var(--f-hand); color:var(--wf-ink-dim);">
                <div style="font-size:22px;">⏳</div>
                <div>Yükleniyor…</div>
            </div>
        }
        else if (items == null || !items.Any())
        {
            <div class="sk-card dashed" style="text-align:center; padding:50px 20px;">
                <div style="font-size:38px; opacity:0.3;">☆</div>
                <div style="font-family:var(--f-hand); font-size:18px; color:var(--wf-ink-dim); margin-top:8px;">Watchlist boş</div>
                <div style="font-family:var(--f-mono); font-size:11px; color:var(--wf-ink-mute); margin-top:6px;">
                    Yukarıdan sembol ekle — Hermes saatlik haber tarayacak
                </div>
            </div>
        }
        else
        {
            <div class="sk-card">
                <div class="sk-card-h">
                    <span class="sk-h-title">Takip Edilen Semboller</span>
                    <span class="sk-h-meta">@items.Count adet</span>
                </div>
                <table class="sk-table" style="width:100%; border-collapse:collapse;">
                    <thead>
                        <tr style="border-bottom:1px solid var(--wf-border);">
                            <th style="text-align:left; padding:8px 4px; font-family:var(--f-mono); font-size:10px; color:var(--wf-ink-mute); text-transform:uppercase;">Sembol</th>
                            <th style="text-align:left; padding:8px 4px; font-family:var(--f-mono); font-size:10px; color:var(--wf-ink-mute); text-transform:uppercase;">Tür</th>
                            <th style="text-align:left; padding:8px 4px; font-family:var(--f-mono); font-size:10px; color:var(--wf-ink-mute); text-transform:uppercase;">Eklendi</th>
                            <th style="text-align:right; padding:8px 4px; font-family:var(--f-mono); font-size:10px; color:var(--wf-ink-mute); text-transform:uppercase;">Aksiyon</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var it in items)
                        {
                            <tr style="border-bottom:1px dashed var(--wf-border);">
                                <td style="padding:10px 4px; font-family:var(--f-hand); font-size:16px; color:var(--wf-ink); font-weight:600;">@it.Symbol</td>
                                <td style="padding:10px 4px;">
                                    <span class="v-badge @(it.Mode == "CRYPTO" ? "hold" : "buy")" style="font-size:10px;">
                                        @(it.Mode == "CRYPTO" ? "KRİPTO" : "HİSSE")
                                    </span>
                                </td>
                                <td style="padding:10px 4px; font-family:var(--f-mono); font-size:11px; color:var(--wf-ink-mute);">
                                    @(string.IsNullOrEmpty(it.AddedAt) ? "—" : it.AddedAt.Substring(0, Math.Min(10, it.AddedAt.Length)))
                                </td>
                                <td style="padding:10px 4px; text-align:right;">
                                    <a href="/hisse-analizi/@it.Symbol" class="wf-btn xs">▶ Analiz</a>
                                    <button @onclick="@(() => RemoveSymbol(it.Symbol!))" class="wf-btn xs danger">✕</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </main>

    @* ── Mentor panel (sticky) ── *@
    <aside class="ha-mentor-col">
        <div class="mentor-card">
            <div class="mentor-head">
                <div class="mentor-avatar">M</div>
                <div>
                    <div style="font-family:var(--f-hand); font-size:14px; color:var(--wf-ink); font-weight:600;">Mentor · Doğa</div>
                    <span class="sk-tag" style="font-size:9px;">WATCHLIST AKLI</span>
                </div>
            </div>
            <div class="mentor-bubble">
                Watchlist'e ekledikleri Hermes haber pipeline tarafından her 30 dakikada bir taranır. Pozitif sürpriz haber → Bayes posterior güncelle → bildirim.
            </div>
            <div class="mentor-bubble">
                <strong>İpucu:</strong> 5-10 sembolden fazla ekleme — sinyaller dağılır. Her sembol için Kelly fraction takip et.
            </div>
        </div>
    </aside>
</div>

@code {
    private string newSymbol = "";
    private string newMode = "STOCK";
    private List<WatchlistItem>? items;
    private bool isLoading = true;
    private bool isAdding = false;
    private string message = "";
    private bool messageOk = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadWatchlist();
    }

    private async Task LoadWatchlist()
    {
        isLoading = true;
        try
        {
            items = await Ajan.GetWatchlistAsync();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task AddSymbol()
    {
        if (string.IsNullOrWhiteSpace(newSymbol))
        {
            message = "Sembol boş olamaz";
            messageOk = false;
            return;
        }
        isAdding = true;
        message = "";
        try
        {
            var sym = newSymbol.Trim().ToUpper();
            var ok = await Ajan.AddWatchlistAsync(sym, newMode);
            if (ok)
            {
                message = $"✓ {sym} watchlist'e eklendi";
                messageOk = true;
                newSymbol = "";
                await LoadWatchlist();
            }
            else
            {
                message = $"✕ {sym} eklenemedi (zaten var olabilir veya geçersiz)";
                messageOk = false;
            }
        }
        finally
        {
            isAdding = false;
        }
    }

    private async Task RemoveSymbol(string symbol)
    {
        var ok = await Ajan.RemoveWatchlistAsync(symbol);
        if (ok)
        {
            message = $"✓ {symbol} kaldırıldı";
            messageOk = true;
            await LoadWatchlist();
        }
        else
        {
            message = $"✕ {symbol} kaldırılamadı";
            messageOk = false;
        }
    }

    private async Task HandleKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !isAdding)
        {
            await AddSymbol();
        }
    }
}
