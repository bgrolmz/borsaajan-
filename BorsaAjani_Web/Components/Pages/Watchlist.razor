@page "/watchlist"
@rendermode InteractiveServer
@using BorsaAjani_Web.Services
@using Microsoft.AspNetCore.Components.Web
@using System.Net.Http
@using System.Text.Json
@inject FinansalAjanService Ajan
@inject NavigationManager Nav
@inject IHttpClientFactory HttpFactory
@using System.Threading
@implements IDisposable

<PageTitle>Watchlist — Borsa Ajanı</PageTitle>

<div class="ha-shell">

    @* ── Sidebar ── *@
    <nav class="ha-sidebar">
        <a href="/" class="ha-sb-logo" title="Ana Sayfa">B</a>
        <a href="/hisse-analizi" class="ha-sb-icon" title="Analiz">◎</a>
        <a href="/watchlist" class="ha-sb-icon active" title="Watchlist">☆</a>
        <a href="/paper-trading" class="ha-sb-icon" title="Paper Trading">▣</a>
        <a href="/gecmis" class="ha-sb-icon" title="Geçmiş">⌛</a>
        <div style="flex:1"></div>
        <a href="/" class="ha-sb-icon" title="Ana Sayfa">⌂</a>
    </nav>

    @* ── Main ── *@
    <main class="ha-main">

        @* Header *@
        <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:16px;">
            <div>
                <h1 style="font-family:var(--f-hand); font-size:28px; color:var(--wf-ink); margin:0;">⭐ Watchlist</h1>
                <span class="sk-tag" style="display:block; margin-top:4px;">Hermes haber pipeline takip listesi</span>
            </div>
            <div style="display:flex; gap:8px; align-items:center;">
                <input @bind="newSymbol" @bind:event="oninput" @onkeydown="HandleKey"
                       placeholder="Sembol — AAPL, BTC-USD"
                       class="sk-input" style="width:180px; text-transform:uppercase; font-family:var(--f-hand);" />
                <select @bind="newMode" class="sk-input" style="width:90px;">
                    <option value="STOCK">Hisse</option>
                    <option value="CRYPTO">Kripto</option>
                </select>
                <button @onclick="AddSymbol" disabled="@isAdding" class="wf-btn primary">
                    @(isAdding ? "Ekleniyor…" : "+ Ekle")
                </button>
                <button @onclick="ToggleBulk" class="wf-btn sm" title="Toplu ekle">@(showBulk ? "− Toplu" : "+ Toplu")</button>
            </div>
        </div>

        @if (showBulk)
        {
            <div class="sk-card dashed" style="margin-bottom:14px;">
                <div class="sk-card-h">
                    <span class="sk-h-title">Toplu Sembol Ekle</span>
                    <span class="sk-h-meta">virgül / boşluk / yeni satır ile ayır</span>
                </div>
                <textarea @bind="bulkText" rows="3" placeholder="AAPL, NVDA TSLA&#10;BTC-USD ETH-USD"
                          class="sk-input" style="width:100%; font-family:var(--f-mono); font-size:12px; text-transform:uppercase; resize:vertical;"></textarea>
                <div style="display:flex; gap:8px; align-items:center; margin-top:8px;">
                    <select @bind="bulkMode" class="sk-input" style="width:120px;">
                        <option value="STOCK">Hisse olarak</option>
                        <option value="CRYPTO">Kripto olarak</option>
                    </select>
                    <button @onclick="AddBulk" disabled="@isAdding" class="wf-btn primary sm">
                        @(isAdding ? "Ekleniyor…" : "↪ Tümünü Ekle")
                    </button>
                </div>
            </div>
        }

        @if (!string.IsNullOrEmpty(message))
        {
            <div class="sk-card" style="margin-bottom:14px; border-color:@(messageOk ? "var(--wf-buy)" : "var(--wf-sell)"); background:@(messageOk ? "var(--wf-buy-soft)" : "var(--wf-sell-soft)"); color:@(messageOk ? "var(--wf-buy)" : "var(--wf-sell)"); font-family:var(--f-hand); font-size:13px;">
                @message
            </div>
        }

        @if (isLoading)
        {
            <BorsaAjani_Web.Components.SkeletonRow Count="5" Height="56" />
        }
        else if (items == null || !items.Any())
        {
            <div class="sk-card dashed" style="text-align:center; padding:50px 20px;">
                <div style="font-size:38px; opacity:0.3;">☆</div>
                <div style="font-family:var(--f-hand); font-size:18px; color:var(--wf-ink-dim); margin-top:8px;">Watchlist boş</div>
                <div style="font-family:var(--f-mono); font-size:11px; color:var(--wf-ink-mute); margin-top:6px;">
                    Yukarıdan sembol ekle — Hermes saatlik haber tarayacak
                </div>
            </div>
        }
        else
        {
            var filtered = FilterAndSort(items);
            <div class="sk-card">
                <div class="sk-card-h">
                    <span class="sk-h-title">Takip Edilen Semboller</span>
                    <span class="sk-h-meta">@filtered.Count / @items.Count adet</span>
                </div>
                <div style="display:flex; gap:6px; padding:6px 0 10px 0; border-bottom:1px dashed var(--wf-border); margin-bottom:6px;">
                    <button @onclick='() => filterMode = "ALL"' class="wf-btn xs @(filterMode == "ALL" ? "primary" : "")">Tümü</button>
                    <button @onclick='() => filterMode = "STOCK"' class="wf-btn xs @(filterMode == "STOCK" ? "primary" : "")">Hisse</button>
                    <button @onclick='() => filterMode = "CRYPTO"' class="wf-btn xs @(filterMode == "CRYPTO" ? "primary" : "")">Kripto</button>
                    <div style="flex:1"></div>
                    <input @bind="searchText" @bind:event="oninput" placeholder="Ara..." class="sk-input" style="width:140px; font-size:12px; padding:4px 8px;" />
                </div>
                <table class="sk-table" style="width:100%; border-collapse:collapse;">
                    <thead>
                        <tr style="border-bottom:1px solid var(--wf-border);">
                            <th @onclick='() => SetSort("symbol")' style="cursor:pointer; text-align:left; padding:8px 4px; font-family:var(--f-mono); font-size:10px; color:var(--wf-ink-mute); text-transform:uppercase;">Sembol @SortArrow("symbol")</th>
                            <th @onclick='() => SetSort("mode")' style="cursor:pointer; text-align:left; padding:8px 4px; font-family:var(--f-mono); font-size:10px; color:var(--wf-ink-mute); text-transform:uppercase;">Tür @SortArrow("mode")</th>
                            <th @onclick='() => SetSort("price")' style="cursor:pointer; text-align:right; padding:8px 4px; font-family:var(--f-mono); font-size:10px; color:var(--wf-ink-mute); text-transform:uppercase;">Fiyat @SortArrow("price")</th>
                            <th @onclick='() => SetSort("change")' style="cursor:pointer; text-align:right; padding:8px 4px; font-family:var(--f-mono); font-size:10px; color:var(--wf-ink-mute); text-transform:uppercase;">Değişim% @SortArrow("change")</th>
                            <th style="text-align:left; padding:8px 4px; font-family:var(--f-mono); font-size:10px; color:var(--wf-ink-mute); text-transform:uppercase;">Sinyal</th>
                            <th @onclick='() => SetSort("added")' style="cursor:pointer; text-align:left; padding:8px 4px; font-family:var(--f-mono); font-size:10px; color:var(--wf-ink-mute); text-transform:uppercase;">Eklendi @SortArrow("added")</th>
                            <th style="text-align:right; padding:8px 4px; font-family:var(--f-mono); font-size:10px; color:var(--wf-ink-mute); text-transform:uppercase;">Aksiyon</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var it in filtered)
                        {
                            var hasQuote = quotes.TryGetValue(it.Symbol ?? "", out var q);
                            var changeCls = hasQuote && q.change >= 0 ? "var(--wf-buy)" : "var(--wf-sell)";
                            <tr style="border-bottom:1px dashed var(--wf-border);">
                                <td style="padding:10px 4px; font-family:var(--f-hand); font-size:16px; color:var(--wf-ink); font-weight:600;">@it.Symbol</td>
                                <td style="padding:10px 4px;">
                                    <span class="v-badge @(it.Mode == "CRYPTO" ? "hold" : "buy")" style="font-size:10px;">
                                        @(it.Mode == "CRYPTO" ? "KRİPTO" : "HİSSE")
                                    </span>
                                </td>
                                <td style="padding:10px 4px; text-align:right; font-family:var(--f-mono); font-size:13px; font-weight:600;">
                                    @(hasQuote ? $"${q.price:F2}" : (quotesLoading ? "…" : "—"))
                                </td>
                                <td style="padding:10px 4px; text-align:right; font-family:var(--f-mono); font-size:13px; font-weight:600; color:@changeCls;">
                                    @(hasQuote ? $"{(q.change >= 0 ? "+" : "")}{q.change:F2}%" : (quotesLoading ? "…" : "—"))
                                </td>
                                <td style="padding:10px 4px; font-family:var(--f-hand); font-size:11px; color:var(--wf-ink-mute);">
                                    @(hasQuote ? q.mentorTag : "—")
                                </td>
                                <td style="padding:10px 4px; font-family:var(--f-mono); font-size:11px; color:var(--wf-ink-mute);">
                                    @(string.IsNullOrEmpty(it.AddedAt) ? "—" : it.AddedAt.Substring(0, Math.Min(10, it.AddedAt.Length)))
                                </td>
                                <td style="padding:10px 4px; text-align:right;">
                                    <a href="/hisse-analizi/@it.Symbol" class="wf-btn xs">▶ Analiz</a>
                                    <button @onclick="@(() => RemoveSymbol(it.Symbol!))" class="wf-btn xs danger">✕</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </main>

    @* ── Mentor panel (sticky) ── *@
    <aside class="ha-mentor-col">
        <div class="mentor-card">
            <div class="mentor-head">
                <div class="mentor-avatar">M</div>
                <div>
                    <div style="font-family:var(--f-hand); font-size:14px; color:var(--wf-ink); font-weight:600;">Mentor · Doğa</div>
                    <span class="sk-tag" style="font-size:9px;">WATCHLIST AKLI</span>
                </div>
            </div>
            <div class="mentor-bubble">
                Watchlist'e ekledikleri Hermes haber pipeline tarafından her 30 dakikada bir taranır. Pozitif sürpriz haber → Bayes posterior güncelle → bildirim.
            </div>
            <div class="mentor-bubble">
                <strong>İpucu:</strong> 5-10 sembolden fazla ekleme — sinyaller dağılır. Her sembol için Kelly fraction takip et.
            </div>
        </div>
    </aside>
</div>

@code {
    private string newSymbol = "";
    private string newMode = "STOCK";
    private List<WatchlistItem>? items;
    private bool isLoading = true;
    private bool isAdding = false;
    private string message = "";
    private bool messageOk = true;

    // Filter / sort / bulk
    private string filterMode = "ALL";
    private string searchText = "";
    private string sortBy = "added";
    private bool sortDesc = true;
    private bool showBulk = false;
    private string bulkText = "";
    private string bulkMode = "STOCK";

    private void ToggleBulk() => showBulk = !showBulk;

    private void SetSort(string col)
    {
        if (sortBy == col) sortDesc = !sortDesc;
        else { sortBy = col; sortDesc = false; }
    }

    private string SortArrow(string col) => sortBy == col ? (sortDesc ? "▼" : "▲") : "";

    private List<WatchlistItem> FilterAndSort(List<WatchlistItem> src)
    {
        IEnumerable<WatchlistItem> q = src;
        if (filterMode != "ALL") q = q.Where(x => x.Mode == filterMode);
        if (!string.IsNullOrWhiteSpace(searchText))
        {
            var s = searchText.Trim().ToUpper();
            q = q.Where(x => (x.Symbol ?? "").ToUpper().Contains(s));
        }
        Func<WatchlistItem, IComparable> key = sortBy switch
        {
            "symbol" => x => x.Symbol ?? "",
            "mode"   => x => x.Mode ?? "",
            "price"  => x => quotes.TryGetValue(x.Symbol ?? "", out var qd) ? qd.price : double.MinValue,
            "change" => x => quotes.TryGetValue(x.Symbol ?? "", out var qd) ? qd.change : double.MinValue,
            "added"  => x => x.AddedAt ?? "",
            _        => x => x.Symbol ?? ""
        };
        q = sortDesc ? q.OrderByDescending(key) : q.OrderBy(key);
        return q.ToList();
    }

    private async Task AddBulk()
    {
        if (string.IsNullOrWhiteSpace(bulkText)) return;
        var symbols = bulkText
            .Split(new[] { ',', ' ', '\n', '\r', '\t', ';' }, StringSplitOptions.RemoveEmptyEntries)
            .Select(s => s.Trim().ToUpper())
            .Where(s => s.Length > 0)
            .Distinct()
            .ToList();
        if (!symbols.Any()) return;
        isAdding = true;
        int ok = 0, fail = 0;
        foreach (var sym in symbols)
        {
            try
            {
                var added = await Ajan.AddWatchlistAsync(sym, bulkMode);
                if (added) ok++; else fail++;
            }
            catch { fail++; }
        }
        message = $"✓ {ok} eklendi, {fail} başarısız";
        messageOk = ok > 0;
        bulkText = "";
        isAdding = false;
        await LoadWatchlist();
        await RefreshQuotes();
    }

    private record QuoteData(double price, double change, string mentorTag);
    private Dictionary<string, QuoteData> quotes = new();
    private bool quotesLoading = false;
    private Timer? refreshTimer;

    protected override async Task OnInitializedAsync()
    {
        await LoadWatchlist();
        await RefreshQuotes();
        refreshTimer = new Timer(async _ =>
        {
            await RefreshQuotes();
            await InvokeAsync(StateHasChanged);
        }, null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));
    }

    public void Dispose() => refreshTimer?.Dispose();

    private async Task RefreshQuotes()
    {
        if (items == null || !items.Any()) return;
        quotesLoading = true;
        try
        {
            var client = HttpFactory.CreateClient("BackendApi");
            var resp = await client.PostAsync("/api/watchlist/sync", null);
            if (resp.IsSuccessStatusCode)
            {
                var json = await resp.Content.ReadAsStringAsync();
                using var doc = JsonDocument.Parse(json);
                if (doc.RootElement.TryGetProperty("data", out var arr))
                {
                    quotes.Clear();
                    foreach (var el in arr.EnumerateArray())
                    {
                        var sym = el.TryGetProperty("symbol", out var s) ? s.GetString() ?? "" : "";
                        var price = el.TryGetProperty("price", out var p) && p.ValueKind == JsonValueKind.Number ? p.GetDouble() : 0.0;
                        var change = el.TryGetProperty("change_percent", out var c) && c.ValueKind == JsonValueKind.Number ? c.GetDouble() : 0.0;
                        var tag = el.TryGetProperty("mentor_tag", out var t) ? t.GetString() ?? "" : "";
                        if (!string.IsNullOrEmpty(sym))
                            quotes[sym] = new QuoteData(price, change, tag);
                    }
                }
            }
        }
        catch { }
        finally
        {
            quotesLoading = false;
        }
    }

    private async Task LoadWatchlist()
    {
        isLoading = true;
        try
        {
            items = await Ajan.GetWatchlistAsync();
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task AddSymbol()
    {
        if (string.IsNullOrWhiteSpace(newSymbol))
        {
            message = "Sembol boş olamaz";
            messageOk = false;
            return;
        }
        isAdding = true;
        message = "";
        try
        {
            var sym = newSymbol.Trim().ToUpper();
            var ok = await Ajan.AddWatchlistAsync(sym, newMode);
            if (ok)
            {
                message = $"✓ {sym} watchlist'e eklendi";
                messageOk = true;
                newSymbol = "";
                await LoadWatchlist();
                await RefreshQuotes();
            }
            else
            {
                message = $"✕ {sym} eklenemedi (zaten var olabilir veya geçersiz)";
                messageOk = false;
            }
        }
        finally
        {
            isAdding = false;
        }
    }

    private async Task RemoveSymbol(string symbol)
    {
        var ok = await Ajan.RemoveWatchlistAsync(symbol);
        if (ok)
        {
            message = $"✓ {symbol} kaldırıldı";
            messageOk = true;
            await LoadWatchlist();
        }
        else
        {
            message = $"✕ {symbol} kaldırılamadı";
            messageOk = false;
        }
    }

    private async Task HandleKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !isAdding)
        {
            await AddSymbol();
        }
    }
}
