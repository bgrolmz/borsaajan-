@page "/paper-trading"
@rendermode InteractiveServer
@using BorsaAjani_Web.Models
@using BorsaAjani_Web.Services
@using Microsoft.AspNetCore.Components.Web
@using System.Net.Http
@using System.Net.Http.Json
@using System.Text.Json
@using System.IO
@using Microsoft.AspNetCore.Components.Forms
@inject FinansalAjanService Ajan
@inject NavigationManager Nav
@inject IHttpClientFactory HttpFactory
@inject IJSRuntime JS

<PageTitle>Portföy — Borsa Ajanı</PageTitle>

<div class="ha-shell">

    <nav class="ha-sidebar">
        <a href="/" class="ha-sb-logo" title="Ana Sayfa">B</a>
        <a href="/hisse-analizi" class="ha-sb-icon" title="Analiz">◎</a>
        <a href="/watchlist" class="ha-sb-icon" title="Watchlist">☆</a>
        <a href="/paper-trading" class="ha-sb-icon active" title="Portföy">▣</a>
        <a href="/gecmis" class="ha-sb-icon" title="Geçmiş">⌛</a>
        <div style="flex:1"></div>
        <a href="/" class="ha-sb-icon" title="Ana Sayfa">⌂</a>
    </nav>

    <main class="ha-main">
        <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:16px;">
            <div>
                <h1 style="font-family:var(--f-hand); font-size:28px; color:var(--wf-ink); margin:0;">▣ Portföy</h1>
                <span class="sk-tag" style="display:block; margin-top:4px;">Gerçek ve simüle pozisyonlar</span>
            </div>
            @if (activeTab == "simule")
            {
                <button @onclick="ResetPortfolio" disabled="@isResetting" class="wf-btn sm danger">
                    @(isResetting ? "Sıfırlanıyor…" : "↺ Simülasyonu Sıfırla")
                </button>
            }
        </div>

        @* ── Tab bar ── *@
        <div style="display:flex; gap:0; margin-bottom:18px; border-bottom:2px solid var(--wf-border);">
            <button @onclick='() => activeTab = "gercek"'
                    style="padding:8px 20px; font-family:var(--f-hand); font-size:14px; font-weight:600; border:none; background:transparent; cursor:pointer;
                           color:@(activeTab=="gercek" ? "var(--wf-buy)" : "var(--wf-ink-mute)");
                           border-bottom:2px solid @(activeTab=="gercek" ? "var(--wf-buy)" : "transparent"); margin-bottom:-2px;">
                💼 Gerçek Portföy
            </button>
            <button @onclick='() => activeTab = "simule"'
                    style="padding:8px 20px; font-family:var(--f-hand); font-size:14px; font-weight:600; border:none; background:transparent; cursor:pointer;
                           color:@(activeTab=="simule" ? "var(--wf-acc)" : "var(--wf-ink-mute)");
                           border-bottom:2px solid @(activeTab=="simule" ? "var(--wf-acc)" : "transparent"); margin-bottom:-2px;">
                ▣ Simüle
            </button>
            <button @onclick='() => SwitchToHistory()'
                    style="padding:8px 20px; font-family:var(--f-hand); font-size:14px; font-weight:600; border:none; background:transparent; cursor:pointer;
                           color:@(activeTab=="history" ? "var(--wf-ink)" : "var(--wf-ink-mute)");
                           border-bottom:2px solid @(activeTab=="history" ? "var(--wf-ink)" : "transparent"); margin-bottom:-2px;">
                📜 Geçmiş İşlemler
            </button>
        </div>

        @if (!string.IsNullOrEmpty(message))
        {
            <div class="sk-card" style="margin-bottom:14px; border-color:@(messageOk ? "var(--wf-buy)" : "var(--wf-sell)"); background:@(messageOk ? "var(--wf-buy-soft)" : "var(--wf-sell-soft)"); color:@(messageOk ? "var(--wf-buy)" : "var(--wf-sell)"); font-family:var(--f-hand); font-size:13px;">
                @message
            </div>
        }

        @* ══════════════════════════════════════════════
           GERÇEK PORTFÖY TAB
           ══════════════════════════════════════════════ *@
        @if (activeTab == "gercek")
        {
            @* Add form + Import/Export *@
            <div class="sk-card dashed" style="margin-bottom:14px;">
                <div class="sk-card-h">
                    <span class="sk-h-title">Pozisyon Ekle</span>
                    <span style="margin-left:auto; display:flex; gap:6px;">
                        <button @onclick="LoadRealPortfolio" disabled="@isRealLoading" class="wf-btn xs">↻</button>
                        <button @onclick="ExportCsv" disabled="@(!realItems.Any())" class="wf-btn xs" title="CSV indir">⬇ CSV</button>
                        <label class="wf-btn xs" style="cursor:pointer; margin:0;" title="CSV içe aktar">
                            ⬆ CSV
                            <InputFile OnChange="OnCsvFileSelected" accept=".csv" style="display:none;" />
                        </label>
                    </span>
                </div>
                <div style="display:flex; gap:8px; align-items:flex-end; flex-wrap:wrap; margin-top:8px;">
                    <div>
                        <span class="sk-tag" style="display:block; margin-bottom:3px;">Sembol</span>
                        <input @bind="realSymbol" placeholder="AAPL" class="sk-input" style="width:100px; text-transform:uppercase;" />
                    </div>
                    <div>
                        <span class="sk-tag" style="display:block; margin-bottom:3px;">Adet</span>
                        <input type="number" @bind="realQty" step="0.01" class="sk-input" style="width:90px;" />
                    </div>
                    <div>
                        <span class="sk-tag" style="display:block; margin-bottom:3px;">Ort. Maliyet $</span>
                        <input type="number" @bind="realAvgCost" step="0.01" class="sk-input" style="width:110px;" />
                    </div>
                    <button @onclick="AddRealPosition" disabled="@isRealAdding" class="wf-btn primary">
                        @(isRealAdding ? "Ekleniyor…" : "+ Ekle")
                    </button>
                </div>
                @if (!string.IsNullOrEmpty(realImportMsg))
                {
                    <div style="margin-top:8px; font-family:var(--f-mono); font-size:12px; color:@(realImportOk ? "var(--wf-buy)" : "var(--wf-sell)");">
                        @realImportMsg
                    </div>
                }
            </div>

            @if (isRealLoading)
            {
                <div style="text-align:center; padding:40px 0; font-family:var(--f-hand); color:var(--wf-ink-dim);">⏳ Yükleniyor…</div>
            }
            else if (!realItems.Any())
            {
                <div class="sk-card dashed" style="text-align:center; padding:50px 20px;">
                    <div style="font-size:38px; opacity:0.3;">💼</div>
                    <div style="font-family:var(--f-hand); font-size:18px; color:var(--wf-ink-dim); margin-top:8px;">Gerçek portföy boş</div>
                    <div style="font-family:var(--f-mono); font-size:11px; color:var(--wf-ink-mute); margin-top:6px;">Yukarıdan pozisyon ekle</div>
                </div>
            }
            else
            {
                @* Summary *@
                var totalPnlColor = realTotalPnl >= 0 ? "var(--wf-buy)" : "var(--wf-sell)";
                <div class="sk-grid-3" style="margin-bottom:14px;">
                    <div class="sk-card">
                        <div class="sk-card-h"><span class="sk-h-title">Toplam Değer</span></div>
                        <span class="sk-num sk-num-xl">$@realTotalValue.ToString("F2")</span>
                        <div style="font-family:var(--f-mono); font-size:11px; color:var(--wf-ink-mute);">Maliyet: $@realTotalCost.ToString("F2")</div>
                    </div>
                    <div class="sk-card">
                        <div class="sk-card-h"><span class="sk-h-title">Toplam P&amp;L</span></div>
                        <span class="sk-num sk-num-xl" style="color:@totalPnlColor;">@(realTotalPnl >= 0 ? "+" : "")$@realTotalPnl.ToString("F2")</span>
                        <div style="font-family:var(--f-mono); font-size:11px; color:@totalPnlColor;">@(realTotalPnlPct >= 0 ? "+" : "")@realTotalPnlPct.ToString("F2")%</div>
                    </div>
                    <div class="sk-card">
                        <div class="sk-card-h"><span class="sk-h-title">Sembol Sayısı</span></div>
                        <span class="sk-num sk-num-xl">@realItems.Count</span>
                    </div>
                </div>

                <div class="sk-card">
                    <div class="sk-card-h">
                        <span class="sk-h-title">Pozisyonlar</span>
                        <span class="sk-h-meta">@realItems.Count adet · canlı fiyat</span>
                    </div>
                    <table style="width:100%; border-collapse:collapse;">
                        <thead>
                            <tr style="border-bottom:1px solid var(--wf-border);">
                                <th style="text-align:left; padding:8px 4px; font-family:var(--f-mono); font-size:10px; color:var(--wf-ink-mute); text-transform:uppercase;">Sembol</th>
                                <th style="text-align:right; padding:8px 4px; font-family:var(--f-mono); font-size:10px; color:var(--wf-ink-mute); text-transform:uppercase;">Adet</th>
                                <th style="text-align:right; padding:8px 4px; font-family:var(--f-mono); font-size:10px; color:var(--wf-ink-mute); text-transform:uppercase;">Ort. Maliyet</th>
                                <th style="text-align:right; padding:8px 4px; font-family:var(--f-mono); font-size:10px; color:var(--wf-ink-mute); text-transform:uppercase;">Şu An</th>
                                <th style="text-align:right; padding:8px 4px; font-family:var(--f-mono); font-size:10px; color:var(--wf-ink-mute); text-transform:uppercase;">Değer</th>
                                <th style="text-align:right; padding:8px 4px; font-family:var(--f-mono); font-size:10px; color:var(--wf-ink-mute); text-transform:uppercase;">P&amp;L</th>
                                <th style="text-align:left; padding:8px 4px; font-family:var(--f-mono); font-size:10px; color:var(--wf-ink-mute); text-transform:uppercase; min-width:120px;">Ağırlık</th>
                                <th style="text-align:right; padding:8px 4px; font-family:var(--f-mono); font-size:10px; color:var(--wf-ink-mute); text-transform:uppercase;">Aksiyon</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in realItems.OrderByDescending(x => x.Value))
                            {
                                var pColor = item.Pnl >= 0 ? "var(--wf-buy)" : "var(--wf-sell)";
                                var wColor = item.WeightPct >= 30 ? "var(--wf-sell)" : item.WeightPct >= 15 ? "var(--wf-acc)" : "var(--wf-buy)";
                                <tr style="border-bottom:1px dashed var(--wf-border);">
                                    <td style="padding:10px 4px; font-family:var(--f-hand); font-size:15px; font-weight:600;">@item.Symbol</td>
                                    <td style="padding:10px 4px; text-align:right; font-family:var(--f-mono); font-size:12px;">@item.Quantity.ToString("F4")</td>
                                    <td style="padding:10px 4px; text-align:right; font-family:var(--f-mono); font-size:12px;">$@item.AvgCost.ToString("F2")</td>
                                    <td style="padding:10px 4px; text-align:right; font-family:var(--f-mono); font-size:12px;">$@item.CurrentPrice.ToString("F2")</td>
                                    <td style="padding:10px 4px; text-align:right; font-family:var(--f-mono); font-size:12px;">$@item.Value.ToString("F2")</td>
                                    <td style="padding:10px 4px; text-align:right; font-family:var(--f-mono); font-size:12px; color:@pColor; font-weight:600;">
                                        @(item.Pnl >= 0 ? "+" : "")$@item.Pnl.ToString("F2")
                                        <div style="font-size:10px;">(@(item.PnlPct >= 0 ? "+" : "")@item.PnlPct.ToString("F2")%)</div>
                                    </td>
                                    <td style="padding:10px 4px;">
                                        <div style="display:flex; align-items:center; gap:6px;">
                                            <div style="flex:1; height:8px; background:var(--wf-border); border-radius:2px; overflow:hidden; min-width:60px;">
                                                <div style="height:100%; width:@(Math.Min(100,item.WeightPct).ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%; background:@wColor;"></div>
                                            </div>
                                            <span style="font-family:var(--f-mono); font-size:11px; color:var(--wf-ink-mute); min-width:42px; text-align:right;">@item.WeightPct.ToString("F1")%</span>
                                        </div>
                                    </td>
                                    <td style="padding:10px 4px; text-align:right;">
                                        <a href="/hisse-analizi/@item.Symbol" class="wf-btn xs">▶</a>
                                        <button @onclick="@(() => RemoveRealPosition(item.Symbol))" class="wf-btn xs danger">✕</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }

        @* ══════════════════════════════════════════════
           SİMÜLE TAB
           ══════════════════════════════════════════════ *@
        @if (activeTab == "simule")
        {
            @if (isLoading)
            {
                <div style="text-align:center; padding:60px 0; font-family:var(--f-hand); color:var(--wf-ink-dim);">
                    <div style="font-size:22px;">⏳</div>
                    <div>Yükleniyor…</div>
                </div>
            }
            else if (portfolio == null)
            {
                <div class="sk-card dashed" style="text-align:center; padding:50px 20px;">
                    <div style="font-size:38px; opacity:0.3;">▣</div>
                    <div style="font-family:var(--f-hand); font-size:18px; color:var(--wf-ink-dim);">Portföy yüklenemedi</div>
                </div>
            }
            else
            {
                @* AL/SAT Trade Form *@
                <div class="sk-card dashed" style="margin-bottom:14px;">
                    <div class="sk-card-h"><span class="sk-h-title">⚡ İşlem Yap</span></div>
                    <div style="display:flex; gap:8px; align-items:flex-end; flex-wrap:wrap; margin-top:8px;">
                        <div>
                            <span class="sk-tag" style="display:block; margin-bottom:3px;">Sembol</span>
                            <input @bind="simSymbol" placeholder="AAPL" class="sk-input" style="width:100px; text-transform:uppercase;" />
                        </div>
                        <div>
                            <span class="sk-tag" style="display:block; margin-bottom:3px;">Adet</span>
                            <input type="number" @bind="simShares" step="0.01" min="0.01" class="sk-input" style="width:90px;" />
                        </div>
                        <button @onclick="SimBuy" disabled="@(isSimTrading || string.IsNullOrWhiteSpace(simSymbol))" class="wf-btn primary">
                            @(isSimTrading ? "…" : "▲ AL")
                        </button>
                        <button @onclick="SimSell" disabled="@(isSimTrading || string.IsNullOrWhiteSpace(simSymbol))" class="wf-btn danger">
                            @(isSimTrading ? "…" : "▼ SAT")
                        </button>
                    </div>
                    @if (!string.IsNullOrEmpty(simTradeMsg))
                    {
                        <div style="margin-top:8px; font-family:var(--f-mono); font-size:12px; color:@(simTradeSuccess ? "var(--wf-buy)" : "var(--wf-sell)");">
                            @simTradeMsg
                        </div>
                    }
                </div>

                <div class="sk-grid-3" style="margin-bottom:14px;">
                    <div class="sk-card">
                        <div class="sk-card-h"><span class="sk-h-title">Toplam Sermaye</span></div>
                        <span class="sk-num sk-num-xl">$@portfolio.TotalEquity.ToString("F2")</span>
                    </div>
                    <div class="sk-card">
                        <div class="sk-card-h"><span class="sk-h-title">Nakit</span></div>
                        <span class="sk-num sk-num-xl" style="color:var(--wf-acc);">$@portfolio.Cash.ToString("F2")</span>
                    </div>
                    <div class="sk-card">
                        <div class="sk-card-h"><span class="sk-h-title">Pozisyon Değeri</span></div>
                        <span class="sk-num sk-num-xl">$@portfolio.PositionsValue.ToString("F2")</span>
                    </div>
                </div>

                <div class="sk-card">
                    <div class="sk-card-h">
                        <span class="sk-h-title">Açık Pozisyonlar</span>
                        <span class="sk-h-meta">@(portfolio.Positions?.Count ?? 0) sembol</span>
                    </div>
                    @if (portfolio.Positions == null || !portfolio.Positions.Any())
                    {
                        <div style="padding:30px 0; text-align:center; font-family:var(--f-hand); color:var(--wf-ink-dim);">
                            Açık pozisyon yok. Yukarıdan AL/SAT yapabilirsin.
                        </div>
                    }
                    else
                    {
                        <table style="width:100%; border-collapse:collapse;">
                            <thead>
                                <tr style="border-bottom:1px solid var(--wf-border);">
                                    <th style="text-align:left; padding:8px 4px; font-family:var(--f-mono); font-size:10px; color:var(--wf-ink-mute); text-transform:uppercase;">Sembol</th>
                                    <th style="text-align:right; padding:8px 4px; font-family:var(--f-mono); font-size:10px; color:var(--wf-ink-mute); text-transform:uppercase;">Adet</th>
                                    <th style="text-align:right; padding:8px 4px; font-family:var(--f-mono); font-size:10px; color:var(--wf-ink-mute); text-transform:uppercase;">Ort. Maliyet</th>
                                    <th style="text-align:right; padding:8px 4px; font-family:var(--f-mono); font-size:10px; color:var(--wf-ink-mute); text-transform:uppercase;">Şu An</th>
                                    <th style="text-align:right; padding:8px 4px; font-family:var(--f-mono); font-size:10px; color:var(--wf-ink-mute); text-transform:uppercase;">Değer</th>
                                    <th style="text-align:right; padding:8px 4px; font-family:var(--f-mono); font-size:10px; color:var(--wf-ink-mute); text-transform:uppercase;">P&amp;L</th>
                                    <th style="text-align:center; padding:8px 4px; font-family:var(--f-mono); font-size:10px; color:var(--wf-ink-mute); text-transform:uppercase;">SL / TP</th>
                                    <th style="text-align:right; padding:8px 4px; font-family:var(--f-mono); font-size:10px; color:var(--wf-ink-mute); text-transform:uppercase;">Aksiyon</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in portfolio.Positions)
                                {
                                    var pnlColor = p.Pnl >= 0 ? "var(--wf-buy)" : "var(--wf-sell)";
                                    var sym = p.Symbol ?? "";
                                    var st = stops.TryGetValue(sym, out var v) ? v : new StopThreshold();
                                    bool slHit = st.SL > 0 && p.CurrentPrice <= st.SL;
                                    bool tpHit = st.TP > 0 && p.CurrentPrice >= st.TP;
                                    string rowBg = slHit ? "background:var(--wf-sell-soft);" : tpHit ? "background:var(--wf-buy-soft);" : "";
                                    <tr style="border-bottom:1px dashed var(--wf-border); @rowBg">
                                        <td style="padding:10px 4px; font-family:var(--f-hand); font-size:15px; font-weight:600;">
                                            @p.Symbol
                                            @if (slHit) { <span style="margin-left:6px; font-size:11px; color:var(--wf-sell);">🛑 STOP</span> }
                                            else if (tpHit) { <span style="margin-left:6px; font-size:11px; color:var(--wf-buy);">🎯 TAKE</span> }
                                        </td>
                                        <td style="padding:10px 4px; text-align:right; font-family:var(--f-mono); font-size:12px;">@p.Shares.ToString("F2")</td>
                                        <td style="padding:10px 4px; text-align:right; font-family:var(--f-mono); font-size:12px;">$@p.AvgCost.ToString("F2")</td>
                                        <td style="padding:10px 4px; text-align:right; font-family:var(--f-mono); font-size:12px;">$@p.CurrentPrice.ToString("F2")</td>
                                        <td style="padding:10px 4px; text-align:right; font-family:var(--f-mono); font-size:12px;">$@p.MarketValue.ToString("F2")</td>
                                        <td style="padding:10px 4px; text-align:right; font-family:var(--f-mono); font-size:12px; color:@pnlColor; font-weight:600;">
                                            @(p.Pnl >= 0 ? "+" : "")$@p.Pnl.ToString("F2")
                                            <div style="font-size:10px;">(@(p.PnlPct >= 0 ? "+" : "")%@p.PnlPct.ToString("F2"))</div>
                                        </td>
                                        <td style="padding:6px 4px; text-align:center;">
                                            <div style="display:flex; flex-direction:column; gap:3px; align-items:center;">
                                                <input type="number" step="0.01" min="0" value="@(st.SL > 0 ? st.SL.ToString("F2") : "")"
                                                       @onchange="@(async (e) => await SetStop(sym, "sl", e.Value?.ToString()))"
                                                       placeholder="SL" class="sk-input" style="width:70px; font-size:11px; padding:2px 4px; border-color:var(--wf-sell);" />
                                                <input type="number" step="0.01" min="0" value="@(st.TP > 0 ? st.TP.ToString("F2") : "")"
                                                       @onchange="@(async (e) => await SetStop(sym, "tp", e.Value?.ToString()))"
                                                       placeholder="TP" class="sk-input" style="width:70px; font-size:11px; padding:2px 4px; border-color:var(--wf-buy);" />
                                            </div>
                                        </td>
                                        <td style="padding:10px 4px; text-align:right;">
                                            <a href="/hisse-analizi/@p.Symbol" class="wf-btn xs">▶</a>
                                            @if (slHit || tpHit)
                                            {
                                                <button @onclick="@(() => QuickSell(sym, p.Shares))" disabled="@isSimTrading" class="wf-btn xs danger" title="Tüm pozisyonu sat">SAT</button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            }
        }

        @* ══════════════════════════════════════════════
           İŞLEM GEÇMİŞİ TAB
           ══════════════════════════════════════════════ *@
        @if (activeTab == "history")
        {
            @if (isTradesLoading)
            {
                <div style="text-align:center; padding:40px 0; font-family:var(--f-hand); color:var(--wf-ink-dim);">⏳ Yükleniyor…</div>
            }
            else if (!trades.Any())
            {
                <div class="sk-card dashed" style="text-align:center; padding:50px 20px;">
                    <div style="font-size:38px; opacity:0.3;">📜</div>
                    <div style="font-family:var(--f-hand); font-size:18px; color:var(--wf-ink-dim);">Henüz işlem yok</div>
                    <div style="font-family:var(--f-mono); font-size:11px; color:var(--wf-ink-mute); margin-top:6px;">Simüle tabında AL/SAT yap</div>
                </div>
            }
            else
            {
                var buys = trades.Count(t => t.Action == "BUY");
                    var sells = trades.Count(t => t.Action == "SELL");
                    var realizedPnl = trades.Where(t => t.Action == "SELL").Sum(t => t.Pnl);
                    var winning = trades.Where(t => t.Action == "SELL" && t.Pnl > 0).Count();
                    var losing = trades.Where(t => t.Action == "SELL" && t.Pnl < 0).Count();
                    var winRate = (winning + losing) > 0 ? (double)winning / (winning + losing) * 100 : 0;
                    var pnlColor = realizedPnl >= 0 ? "var(--wf-buy)" : "var(--wf-sell)";

                    var sellTrades = trades.Where(t => t.Action == "SELL").OrderBy(t => t.ExecutedAt).ToList();
                    double cum = 0;
                    var cumPoints = sellTrades.Select(t => { cum += t.Pnl; return cum; }).ToList();

                <div class="sk-grid-3" style="margin-bottom:14px;">
                    <div class="sk-card">
                        <div class="sk-card-h"><span class="sk-h-title">Toplam İşlem</span></div>
                        <span class="sk-num sk-num-xl">@trades.Count</span>
                        <div style="font-family:var(--f-mono); font-size:11px; color:var(--wf-ink-mute);">@buys AL · @sells SAT</div>
                    </div>
                    <div class="sk-card">
                        <div class="sk-card-h"><span class="sk-h-title">Realized P&amp;L</span></div>
                        <span class="sk-num sk-num-xl" style="color:@pnlColor;">@(realizedPnl >= 0 ? "+" : "")$@realizedPnl.ToString("F2")</span>
                    </div>
                    <div class="sk-card">
                        <div class="sk-card-h"><span class="sk-h-title">Win Rate</span></div>
                        <span class="sk-num sk-num-xl">@winRate.ToString("F1")%</span>
                        <div style="font-family:var(--f-mono); font-size:11px; color:var(--wf-ink-mute);">@winning W · @losing L</div>
                    </div>
                </div>

                @if (cumPoints.Count >= 2)
                {
                    <div class="sk-card" style="margin-bottom:14px;">
                        <div class="sk-card-h"><span class="sk-h-title">Kümülatif Realized P&amp;L</span><span class="sk-h-meta">@cumPoints.Count satış</span></div>
                        @{
                            var w = 600.0; var h = 80.0; var pad = 4.0;
                            var minV = Math.Min(0, cumPoints.Min());
                            var maxV = Math.Max(0, cumPoints.Max());
                            var rng = maxV - minV; if (rng == 0) rng = 1;
                            var step = (w - 2 * pad) / Math.Max(1, cumPoints.Count - 1);
                            var pts = string.Join(" ", cumPoints.Select((v, i) => $"{(pad + i * step).ToString("F1", System.Globalization.CultureInfo.InvariantCulture)},{(h - pad - (v - minV) / rng * (h - 2 * pad)).ToString("F1", System.Globalization.CultureInfo.InvariantCulture)}"));
                            var zeroY = h - pad - (0 - minV) / rng * (h - 2 * pad);
                            var lineColor = cumPoints.Last() >= 0 ? "var(--wf-buy)" : "var(--wf-sell)";
                        }
                        <svg viewBox="0 0 @w.ToString("F0") @h.ToString("F0")" style="width:100%; height:80px; display:block;">
                            <line x1="0" y1="@zeroY.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)" x2="@w.ToString("F0")" y2="@zeroY.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)" stroke="var(--wf-border)" stroke-dasharray="3,3" stroke-width="1" />
                            <polyline fill="none" stroke="@lineColor" stroke-width="2" points="@pts" />
                        </svg>
                    </div>
                }

                <div class="sk-card">
                    <div class="sk-card-h">
                        <span class="sk-h-title">İşlemler</span>
                        <span class="sk-h-meta">en yeni → en eski</span>
                    </div>
                    <table style="width:100%; border-collapse:collapse;">
                        <thead>
                            <tr style="border-bottom:1px solid var(--wf-border);">
                                <th style="text-align:left; padding:8px 4px; font-family:var(--f-mono); font-size:10px; color:var(--wf-ink-mute); text-transform:uppercase;">Zaman</th>
                                <th style="text-align:left; padding:8px 4px; font-family:var(--f-mono); font-size:10px; color:var(--wf-ink-mute); text-transform:uppercase;">Sembol</th>
                                <th style="text-align:left; padding:8px 4px; font-family:var(--f-mono); font-size:10px; color:var(--wf-ink-mute); text-transform:uppercase;">Aksiyon</th>
                                <th style="text-align:right; padding:8px 4px; font-family:var(--f-mono); font-size:10px; color:var(--wf-ink-mute); text-transform:uppercase;">Adet</th>
                                <th style="text-align:right; padding:8px 4px; font-family:var(--f-mono); font-size:10px; color:var(--wf-ink-mute); text-transform:uppercase;">Fiyat</th>
                                <th style="text-align:right; padding:8px 4px; font-family:var(--f-mono); font-size:10px; color:var(--wf-ink-mute); text-transform:uppercase;">Toplam</th>
                                <th style="text-align:right; padding:8px 4px; font-family:var(--f-mono); font-size:10px; color:var(--wf-ink-mute); text-transform:uppercase;">P&amp;L</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var t in trades)
                            {
                                var isBuy = t.Action == "BUY";
                                var actColor = isBuy ? "var(--wf-buy)" : "var(--wf-sell)";
                                var pColor = t.Pnl >= 0 ? "var(--wf-buy)" : "var(--wf-sell)";
                                <tr style="border-bottom:1px dashed var(--wf-border);">
                                    <td style="padding:8px 4px; font-family:var(--f-mono); font-size:11px; color:var(--wf-ink-mute);">@FormatTime(t.ExecutedAt)</td>
                                    <td style="padding:8px 4px; font-family:var(--f-hand); font-size:14px; font-weight:600;">@t.Symbol</td>
                                    <td style="padding:8px 4px; font-family:var(--f-mono); font-size:11px; font-weight:700; color:@actColor;">@(isBuy ? "▲ AL" : "▼ SAT")</td>
                                    <td style="padding:8px 4px; text-align:right; font-family:var(--f-mono); font-size:12px;">@t.Shares.ToString("F2")</td>
                                    <td style="padding:8px 4px; text-align:right; font-family:var(--f-mono); font-size:12px;">$@t.Price.ToString("F2")</td>
                                    <td style="padding:8px 4px; text-align:right; font-family:var(--f-mono); font-size:12px;">$@t.Total.ToString("F2")</td>
                                    <td style="padding:8px 4px; text-align:right; font-family:var(--f-mono); font-size:12px; color:@(isBuy ? "var(--wf-ink-mute)" : pColor); font-weight:600;">
                                        @(isBuy ? "—" : (t.Pnl >= 0 ? "+" : "") + "$" + t.Pnl.ToString("F2"))
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
    </main>

    <aside class="ha-mentor-col">
        <div class="mentor-card">
            <div class="mentor-head">
                <div class="mentor-avatar">M</div>
                <div>
                    <div style="font-family:var(--f-hand); font-size:14px; color:var(--wf-ink); font-weight:600;">Mentor · Doğa</div>
                    <span class="sk-tag" style="font-size:9px;">@(activeTab == "gercek" ? "GERÇEK PORTFÖY" : "PAPER TRADING")</span>
                </div>
            </div>
            @if (activeTab == "gercek")
            {
                <div class="mentor-bubble">
                    Gerçek portföyünü buraya gir — <strong>maliyet takibi</strong> ve AI analiz bağlantısı için. Fiyat güncelleme yok, sadece pozisyon kaydı.
                </div>
                <div class="mentor-bubble">
                    <strong>İpucu:</strong> Kelly fraction'ı gerçek pozisyon büyüklüğünle karşılaştır. Aşırı konsantrasyon görürsen azalt.
                </div>
            }
            else
            {
                <div class="mentor-bubble">
                    Paper trading <strong>simüle</strong>. Disiplini test et, gerçek paraya geçmeden önce 30+ işlem deneyimi al.
                </div>
                <div class="mentor-bubble">
                    <strong>Kural:</strong> Her pozisyon Kelly öneri ölçüsünde. Stop-loss şart. P&amp;L'ı duygulara göre değil sisteme göre yorumla.
                </div>
            }
        </div>
    </aside>
</div>

@code {
    private string activeTab = "gercek";

    // Paper trading state
    private PaperPortfolio? portfolio;
    private bool isLoading = true;
    private bool isResetting = false;

    // Real portfolio state
    private List<RealPortfolioItem> realItems = new();
    private bool isRealLoading = true;
    private bool isRealAdding = false;
    private string realSymbol = "";
    private double realQty = 1;
    private double realAvgCost = 0;

    // Simüle trade form
    private string simSymbol = "";
    private double simShares = 1;
    private bool isSimTrading = false;
    private string? simTradeMsg;
    private bool simTradeSuccess;

    // Trade history
    private List<PaperTrade> trades = new();
    private bool isTradesLoading = false;
    private bool tradesLoaded = false;

    // SL/TP per symbol
    private Dictionary<string, StopThreshold> stops = new();
    private bool stopsLoaded = false;

    private string message = "";
    private bool messageOk = true;

    private class StopThreshold
    {
        public double SL { get; set; }
        public double TP { get; set; }
    }

    private class RealPortfolioItem
    {
        public string Symbol { get; set; } = "";
        public double Quantity { get; set; }
        public double AvgCost { get; set; }
        public double CurrentPrice { get; set; }
        public double Cost { get; set; }
        public double Value { get; set; }
        public double Pnl { get; set; }
        public double PnlPct { get; set; }
        public double WeightPct { get; set; }
        public string? UpdatedAt { get; set; }
    }

    private double realTotalCost;
    private double realTotalValue;
    private double realTotalPnl;
    private double realTotalPnlPct;
    private string? realImportMsg;
    private bool realImportOk;

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(LoadPortfolio(), LoadRealPortfolio());
    }

    private async Task LoadPortfolio()
    {
        isLoading = true;
        try { portfolio = await Ajan.GetPortfolioAsync(); }
        finally { isLoading = false; }
    }

    private async Task LoadRealPortfolio()
    {
        isRealLoading = true;
        try
        {
            var client = HttpFactory.CreateClient("BackendApi");
            var resp = await client.GetAsync("/portfolio/values");
            if (resp.IsSuccessStatusCode)
            {
                var json = await resp.Content.ReadAsStringAsync();
                using var doc = JsonDocument.Parse(json);
                var root = doc.RootElement;
                realItems.Clear();
                if (root.TryGetProperty("items", out var arr))
                {
                    foreach (var el in arr.EnumerateArray())
                    {
                        realItems.Add(new RealPortfolioItem
                        {
                            Symbol = el.TryGetProperty("symbol", out var s) ? s.GetString() ?? "" : "",
                            Quantity = el.TryGetProperty("quantity", out var q) && q.ValueKind == JsonValueKind.Number ? q.GetDouble() : 0,
                            AvgCost = el.TryGetProperty("avg_cost", out var c) && c.ValueKind == JsonValueKind.Number ? c.GetDouble() : 0,
                            CurrentPrice = el.TryGetProperty("current_price", out var cp) && cp.ValueKind == JsonValueKind.Number ? cp.GetDouble() : 0,
                            Cost = el.TryGetProperty("cost", out var co) && co.ValueKind == JsonValueKind.Number ? co.GetDouble() : 0,
                            Value = el.TryGetProperty("value", out var v) && v.ValueKind == JsonValueKind.Number ? v.GetDouble() : 0,
                            Pnl = el.TryGetProperty("pnl", out var pn) && pn.ValueKind == JsonValueKind.Number ? pn.GetDouble() : 0,
                            PnlPct = el.TryGetProperty("pnl_pct", out var pp) && pp.ValueKind == JsonValueKind.Number ? pp.GetDouble() : 0,
                            WeightPct = el.TryGetProperty("weight_pct", out var w) && w.ValueKind == JsonValueKind.Number ? w.GetDouble() : 0,
                            UpdatedAt = el.TryGetProperty("updated_at", out var u) ? u.GetString() : null,
                        });
                    }
                }
                realTotalCost = root.TryGetProperty("total_cost", out var tc) && tc.ValueKind == JsonValueKind.Number ? tc.GetDouble() : 0;
                realTotalValue = root.TryGetProperty("total_value", out var tv) && tv.ValueKind == JsonValueKind.Number ? tv.GetDouble() : 0;
                realTotalPnl = root.TryGetProperty("total_pnl", out var tp) && tp.ValueKind == JsonValueKind.Number ? tp.GetDouble() : 0;
                realTotalPnlPct = root.TryGetProperty("total_pnl_pct", out var tpp) && tpp.ValueKind == JsonValueKind.Number ? tpp.GetDouble() : 0;
            }
        }
        catch { }
        finally { isRealLoading = false; }
    }

    private async Task ExportCsv()
    {
        var sb = new System.Text.StringBuilder();
        sb.AppendLine("symbol,quantity,avg_cost");
        foreach (var it in realItems)
        {
            sb.AppendLine($"{it.Symbol},{it.Quantity.ToString(System.Globalization.CultureInfo.InvariantCulture)},{it.AvgCost.ToString(System.Globalization.CultureInfo.InvariantCulture)}");
        }
        var stamp = DateTime.Now.ToString("yyyyMMdd_HHmm");
        var fname = $"portfolio_{stamp}.csv";
        try
        {
            await JS.InvokeVoidAsync("eval", $@"
                (function(){{
                    var blob = new Blob([{System.Text.Json.JsonSerializer.Serialize(sb.ToString())}], {{type:'text/csv'}});
                    var url = URL.createObjectURL(blob);
                    var a = document.createElement('a');
                    a.href = url; a.download = '{fname}';
                    document.body.appendChild(a); a.click();
                    setTimeout(function(){{ URL.revokeObjectURL(url); a.remove(); }}, 100);
                }})();");
        }
        catch (Exception ex) { realImportMsg = "✕ Export hatası: " + ex.Message; realImportOk = false; }
    }

    private async Task OnCsvFileSelected(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file == null) return;
            using var stream = file.OpenReadStream(2 * 1024 * 1024);
            using var reader = new StreamReader(stream);
            var content = await reader.ReadToEndAsync();
            var lines = content.Split('\n', StringSplitOptions.RemoveEmptyEntries);
            int added = 0, skipped = 0;
            var client = HttpFactory.CreateClient("BackendApi");
            for (int i = 0; i < lines.Length; i++)
            {
                var line = lines[i].Trim().Trim('\r');
                if (string.IsNullOrEmpty(line)) continue;
                if (i == 0 && line.ToLower().Contains("symbol")) continue;
                var parts = line.Split(',');
                if (parts.Length < 3) { skipped++; continue; }
                var sym = parts[0].Trim().ToUpper();
                if (!double.TryParse(parts[1].Trim(), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var qty)) { skipped++; continue; }
                if (!double.TryParse(parts[2].Trim(), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var avg)) { skipped++; continue; }
                if (string.IsNullOrEmpty(sym) || qty <= 0 || avg <= 0) { skipped++; continue; }
                var body = new { symbol = sym, avg_cost = avg, quantity = qty };
                var resp = await client.PostAsJsonAsync("/portfolio/add", body);
                if (resp.IsSuccessStatusCode) added++; else skipped++;
            }
            realImportMsg = $"✓ {added} eklendi · {skipped} atlandı";
            realImportOk = added > 0;
            await LoadRealPortfolio();
        }
        catch (Exception ex)
        {
            realImportMsg = "✕ Import hatası: " + ex.Message;
            realImportOk = false;
        }
    }

    private async Task AddRealPosition()
    {
        if (string.IsNullOrWhiteSpace(realSymbol) || realQty <= 0 || realAvgCost <= 0)
        {
            message = "Sembol, adet ve maliyet gerekli (pozitif değer)";
            messageOk = false;
            return;
        }
        isRealAdding = true;
        message = "";
        try
        {
            var client = HttpFactory.CreateClient("BackendApi");
            var body = new { symbol = realSymbol.Trim().ToUpper(), avg_cost = realAvgCost, quantity = realQty };
            var resp = await client.PostAsJsonAsync("/portfolio/add", body);
            if (resp.IsSuccessStatusCode)
            {
                message = $"✓ {realSymbol.ToUpper()} eklendi";
                messageOk = true;
                realSymbol = "";
                realQty = 1;
                realAvgCost = 0;
                await LoadRealPortfolio();
            }
            else
            {
                message = "✕ Eklenemedi";
                messageOk = false;
            }
        }
        catch { message = "✕ Bağlantı hatası"; messageOk = false; }
        finally { isRealAdding = false; }
    }

    private async Task RemoveRealPosition(string symbol)
    {
        try
        {
            var client = HttpFactory.CreateClient("BackendApi");
            var resp = await client.DeleteAsync($"/portfolio/delete/{symbol}");
            if (resp.IsSuccessStatusCode)
            {
                message = $"✓ {symbol} kaldırıldı";
                messageOk = true;
                await LoadRealPortfolio();
            }
            else
            {
                message = $"✕ {symbol} kaldırılamadı";
                messageOk = false;
            }
        }
        catch { message = "✕ Bağlantı hatası"; messageOk = false; }
    }

    private async Task SimBuy()
    {
        if (string.IsNullOrWhiteSpace(simSymbol) || simShares <= 0) return;
        isSimTrading = true; simTradeMsg = null;
        try
        {
            var r = await Ajan.BuyAsync(simSymbol.Trim().ToUpper(), simShares);
            simTradeSuccess = r.Success;
            simTradeMsg = r.Success
                ? $"✅ AL {r.Shares} {r.Symbol} @ ${r.Price:F2} = ${r.Total:F2} | Kalan: ${r.CashRemaining:F2}"
                : $"❌ {r.Error}";
            if (r.Success) { simSymbol = ""; simShares = 1; tradesLoaded = false; await LoadPortfolio(); }
        }
        catch { simTradeMsg = "❌ Bağlantı hatası"; simTradeSuccess = false; }
        finally { isSimTrading = false; }
    }

    private async Task SimSell()
    {
        if (string.IsNullOrWhiteSpace(simSymbol) || simShares <= 0) return;
        isSimTrading = true; simTradeMsg = null;
        try
        {
            var r = await Ajan.SellAsync(simSymbol.Trim().ToUpper(), simShares);
            simTradeSuccess = r.Success;
            simTradeMsg = r.Success
                ? $"✅ SAT {r.Shares} {r.Symbol} @ ${r.Price:F2} = ${r.Total:F2} | PnL: ${r.Pnl:F2}"
                : $"❌ {r.Error}";
            if (r.Success) { simSymbol = ""; simShares = 1; tradesLoaded = false; await LoadPortfolio(); }
        }
        catch { simTradeMsg = "❌ Bağlantı hatası"; simTradeSuccess = false; }
        finally { isSimTrading = false; }
    }

    private async Task SwitchToHistory()
    {
        activeTab = "history";
        if (!tradesLoaded) await LoadTrades();
    }

    private async Task LoadTrades()
    {
        isTradesLoading = true;
        try { trades = await Ajan.GetTradesAsync(200); }
        finally { isTradesLoading = false; tradesLoaded = true; }
    }

    private static string FormatTime(string? iso)
    {
        if (string.IsNullOrEmpty(iso)) return "—";
        if (DateTime.TryParse(iso, null, System.Globalization.DateTimeStyles.AssumeUniversal | System.Globalization.DateTimeStyles.AdjustToUniversal, out var dt))
            return dt.ToLocalTime().ToString("MM-dd HH:mm");
        return iso.Length >= 16 ? iso.Substring(0, 16).Replace("T", " ") : iso;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !stopsLoaded)
        {
            try
            {
                var json = await JS.InvokeAsync<string?>("localStorage.getItem", "pt_stops");
                if (!string.IsNullOrEmpty(json))
                    stops = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, StopThreshold>>(json) ?? new();
            }
            catch { }
            stopsLoaded = true;
            StateHasChanged();
        }
    }

    private async Task SetStop(string symbol, string kind, string? raw)
    {
        if (!stops.TryGetValue(symbol, out var st)) { st = new StopThreshold(); stops[symbol] = st; }
        double.TryParse(raw, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var v);
        if (kind == "sl") st.SL = v; else if (kind == "tp") st.TP = v;
        if (st.SL <= 0 && st.TP <= 0) stops.Remove(symbol);
        try
        {
            var json = System.Text.Json.JsonSerializer.Serialize(stops);
            await JS.InvokeVoidAsync("localStorage.setItem", "pt_stops", json);
        }
        catch { }
    }

    private async Task QuickSell(string symbol, double shares)
    {
        if (string.IsNullOrWhiteSpace(symbol) || shares <= 0) return;
        isSimTrading = true; simTradeMsg = null;
        try
        {
            var r = await Ajan.SellAsync(symbol, shares);
            simTradeSuccess = r.Success;
            simTradeMsg = r.Success
                ? $"✅ SAT {r.Shares} {r.Symbol} @ ${r.Price:F2} | PnL: ${r.Pnl:F2}"
                : $"❌ {r.Error}";
            if (r.Success)
            {
                stops.Remove(symbol);
                try { await JS.InvokeVoidAsync("localStorage.setItem", "pt_stops", System.Text.Json.JsonSerializer.Serialize(stops)); } catch { }
                await LoadPortfolio();
                tradesLoaded = false;
            }
        }
        catch { simTradeMsg = "❌ Bağlantı hatası"; simTradeSuccess = false; }
        finally { isSimTrading = false; }
    }

    private async Task ResetPortfolio()
    {
        isResetting = true;
        try
        {
            var ok = await Ajan.ResetPortfolioAsync();
            if (ok)
            {
                message = "✓ Simüle portföy sıfırlandı ($100,000 nakit)";
                messageOk = true;
                await LoadPortfolio();
            }
            else
            {
                message = "✕ Sıfırlama başarısız";
                messageOk = false;
            }
        }
        finally { isResetting = false; }
    }
}
