@page "/hisse-analizi"
@page "/hisse-analizi/{Symbol}"
@rendermode InteractiveServer
@using BorsaAjani_Web.Models
@using BorsaAjani_Web.Services
@using Microsoft.AspNetCore.Components.Web
@using System.Net.Http.Json
@using System.Text.Json
@inject FinansalAjanService Ajan
@inject NavigationManager Nav
@inject IHttpClientFactory HttpFactory

<PageTitle>Hisse Analizi — Borsa Ajanı</PageTitle>

<div class="ha-shell">

    @* ── Sidebar ── *@
    <nav class="ha-sidebar">
        <a href="/" class="ha-sb-logo" title="Ana Sayfa">B</a>
        <a href="/hisse-analizi" class="ha-sb-icon active" title="Analiz">◎</a>
        <a href="/watchlist"      class="ha-sb-icon"        title="Watchlist">☆</a>
        <a href="/paper-trading"  class="ha-sb-icon"        title="Paper Trading">▣</a>
        <a href="/gecmis"         class="ha-sb-icon"        title="Geçmiş">⌛</a>
        <div style="flex:1"></div>
        <a href="/" class="ha-sb-icon" title="Ana Sayfa">⌂</a>
    </nav>

    @* ── Main content ── *@
    <main class="ha-main">

        @* ── Search / giriş alanı ── *@
        <div style="display:flex; align-items:center; gap:10px; margin-bottom:16px;">
            <div class="ha-search">
                <span style="color:var(--wf-ink-mute);">⌕</span>
                <input @bind="symbolInput"
                       @bind:event="oninput"
                       @onkeydown="HandleKey"
                       placeholder="Sembol gir — AAPL, NVDA, TSLA…"
                       class="sk-input"
                       style="border:none; background:transparent; padding:0; text-transform:uppercase; font-family:var(--f-hand);" />
            </div>
            <div style="display:flex; gap:6px; align-items:center;">
                <div>
                    <span class="sk-tag" style="display:block; margin-bottom:3px;">Portföy $</span>
                    <input type="number" @bind="portfolioSize" class="sk-input" style="width:90px;" />
                </div>
                <div>
                    <span class="sk-tag" style="display:block; margin-bottom:3px;">Hedef %</span>
                    <input type="number" @bind="upsidePct" step="0.5" class="sk-input" style="width:70px;" />
                </div>
                <div>
                    <span class="sk-tag" style="display:block; margin-bottom:3px;">Stop %</span>
                    <input type="number" @bind="stopPct" step="0.5" class="sk-input" style="width:70px;" />
                </div>
                <button @onclick="RunAnalysis" disabled="@isLoading" class="wf-btn primary" style="align-self:flex-end; height:34px;">
                    @(isLoading ? "⏳ Analiz…" : "▶ Analiz Et")
                </button>
                <button @onclick="ToggleAdvanced" class="wf-btn sm" style="align-self:flex-end; height:34px;">⚙</button>
            </div>
        </div>

        @if (showAdvanced)
        {
            <div class="sk-card dashed" style="margin-bottom:14px; display:flex; align-items:center; gap:10px;">
                <span class="sk-tag">Önsel olasılık (boş=otomatik)</span>
                <input type="number" @bind="priorProb" step="0.05" min="0" max="1" class="sk-input" style="width:110px;" />
            </div>
        }

        @* ── Hata ── *@
        @if (!string.IsNullOrEmpty(errorMsg))
        {
            <div class="sk-card" style="border-color:var(--wf-sell); background:var(--wf-sell-soft); margin-bottom:14px; color:var(--wf-sell); font-family:var(--f-hand); font-size:13px;">
                ⚠️ @errorMsg
            </div>
        }

        @* ── Yükleniyor ── *@
        @if (isLoading)
        {
            <div style="text-align:center; padding:60px 0; font-family:var(--f-hand); color:var(--wf-ink-dim);">
                <div style="font-size:22px; margin-bottom:8px;">⏳</div>
                <div>Analiz ediliyor…</div>
                <div style="font-family:var(--f-mono); font-size:11px; color:var(--wf-ink-mute); margin-top:4px;">EV · Kelly · Bayes · Gemini</div>
            </div>
        }

        @* ── Sonuç ── *@
        @if (result != null && result.Success)
        {
            var verdictClass = (result.Verdict ?? "") switch {
                var v when v.StartsWith("AL") => "buy",
                var v when v.StartsWith("SAT") => "sell",
                _ => "hold"
            };
            var confidenceTr = (result.Confidence ?? "") switch {
                "YUKSEK" => "YÜKSEK",
                "ORTA"   => "ORTA",
                "DUSUK"  => "DÜŞÜK",
                _        => result.Confidence ?? "—"
            };
            var priorPct  = (int)Math.Round((result.Probability?.Initial ?? 0.5) * 100);
            var posteriorPct = (int)Math.Round((result.Probability?.AfterNews ?? result.Probability?.Initial ?? 0.5) * 100);
            var bayesDelta = posteriorPct - priorPct;
            var winPct    = posteriorPct;
            var losePct   = 100 - winPct;

            @* ── Frame Header ── *@
            <div class="ha-frame-header">
                <span class="ha-ticker-name">@result.Symbol</span>
                <span class="ha-ticker-sub">@result.Name · @result.Sector</span>
                <span class="sk-dot-sep">·</span>
                <span class="ha-price-now">$@(result.Price?.ToString("F2"))</span>
                <span class="ha-price-delta @(result.ChangePct >= 0 ? "pos" : "neg")">
                    @(result.ChangePct >= 0 ? "▲" : "▼") @(result.ChangePct?.ToString("F2"))%
                </span>
                <div class="wf-grow"></div>
                @if (result.LongshotWarning)
                {
                    <span class="v-badge hold">⚠ Longshot Riski</span>
                }
                <span class="pt-pill" @onclick="() => tradeShares = result.Kelly?.Shares ?? 1">Paper Trade</span>
            </div>

            @* ── Verdict Hero + Mentor Özeti ── *@
            <div class="sk-grid-2" style="margin-bottom:14px;">
                <div class="verdict @verdictClass">
                    <div class="verdict-body">
                        <div class="verdict-tag">Karar · @result.AnalyzedAt?.Split('T')[1]?.Substring(0,5) güncellendi</div>
                        <div class="verdict-call">@result.Verdict</div>
                        <div class="verdict-conf">güven @confidenceTr · Bayes %@posteriorPct</div>
                    </div>
                </div>
                <div class="sk-card" style="display:flex; flex-direction:column; gap:10px;">
                    <div class="sk-card-h">
                        <span class="sk-h-title">Mentor Özeti</span>
                        <span class="sk-h-meta">Gemini AI</span>
                    </div>
                    <div style="font-family:var(--f-hand); font-size:13px; line-height:1.55; color:var(--wf-ink); flex:1;">
                        @if (!string.IsNullOrEmpty(result.AiCommentary))
                        {
                            @result.AiCommentary
                        }
                        else
                        {
                            <span style="color:var(--wf-ink-mute);">Gemini yorumu bekleniyor…</span>
                        }
                    </div>
                    <div style="display:flex; gap:8px; flex-wrap:wrap;">
                        <button @onclick="ExecuteBuy" disabled="@isTrading" class="wf-btn success sm">
                            AL @result.Symbol
                        </button>
                        <button @onclick="ExecuteSell" disabled="@isTrading" class="wf-btn danger sm">
                            SAT
                        </button>
                        @if (result.Kelly?.Shares > 0)
                        {
                            <button @onclick="UseKellyShares" class="wf-btn sm">
                                Kelly öneri: @result.Kelly.Shares hisse
                            </button>
                        }
                        <button @onclick="AddToWatchlist" disabled="@isAddingWatch" class="wf-btn sm" title="Watchlist'e ekle">
                            @(isAddingWatch ? "…" : "☆ Watchlist")
                        </button>
                    </div>
                    @if (!string.IsNullOrEmpty(tradeMsg))
                    {
                        <div style="font-family:var(--f-mono); font-size:11px; color:@(tradeSuccess ? "var(--wf-buy)" : "var(--wf-sell)");">
                            @tradeMsg
                        </div>
                    }
                </div>
            </div>

            @* ── Chart placeholder (TradingView — Faza 8) ── *@
            <div class="sk-card dashed" style="margin-bottom:14px; height:160px; display:flex; align-items:center; justify-content:center; flex-direction:column; gap:6px;">
                <span style="font-size:22px; opacity:0.3;">📈</span>
                <span class="sk-tag" style="opacity:0.5;">TradingView lightweight-charts — Faza 8</span>
                <span style="font-family:var(--f-mono); font-size:11px; color:var(--wf-ink-mute);">
                    Giriş $@(result.Targets?.Entry.ToString("F2") ?? "—") · Hedef $@(result.Targets?.Target.ToString("F2") ?? "—") · Stop $@(result.Targets?.StopLoss.ToString("F2") ?? "—")
                </span>
            </div>

            @* ── Analist Konsensüsü (Midas tarzı bar) ── *@
            @if (result.AnalystCount.HasValue && result.AnalystCount.Value > 0)
            {
                @* recommendationMean: 1=Strong Buy, 2=Buy, 3=Hold, 4=Sell, 5=Strong Sell *@
                var mean = result.AnalystMean ?? 3.0;
                var buyPct = Math.Max(0, Math.Min(100, (int)((3.0 - Math.Min(mean, 3.0)) / 2.0 * 100)));
                var sellPct = Math.Max(0, Math.Min(100, (int)((Math.Max(mean, 3.0) - 3.0) / 2.0 * 100)));
                var holdPct = Math.Max(0, 100 - buyPct - sellPct);
                <div class="sk-card" style="margin-bottom:14px;">
                    <div class="sk-card-h">
                        <span class="sk-h-title">Analist Konsensüsü</span>
                        <span class="sk-h-meta">@result.AnalystCount.Value analist · ortalama @mean.ToString("F2")</span>
                    </div>
                    <div style="display:flex; flex-direction:column; gap:8px; padding:6px 0;">
                        <div class="sk-row-between">
                            <span class="sk-tag" style="color:var(--wf-buy);">AL</span>
                            <div class="sk-row" style="gap:8px; flex:1; margin-left:12px;">
                                <div class="bar-track" style="flex:1;"><div class="bar-fill buy" style="width:@(buyPct)%;"></div></div>
                                <span class="sk-num sk-num-sm" style="color:var(--wf-buy); min-width:42px; text-align:right;">%@buyPct</span>
                            </div>
                        </div>
                        <div class="sk-row-between">
                            <span class="sk-tag">TUT</span>
                            <div class="sk-row" style="gap:8px; flex:1; margin-left:12px;">
                                <div class="bar-track" style="flex:1;"><div class="bar-fill hold" style="width:@(holdPct)%;"></div></div>
                                <span class="sk-num sk-num-sm" style="min-width:42px; text-align:right;">%@holdPct</span>
                            </div>
                        </div>
                        <div class="sk-row-between">
                            <span class="sk-tag" style="color:var(--wf-sell);">SAT</span>
                            <div class="sk-row" style="gap:8px; flex:1; margin-left:12px;">
                                <div class="bar-track" style="flex:1;"><div class="bar-fill sell" style="width:@(sellPct)%;"></div></div>
                                <span class="sk-num sk-num-sm" style="color:var(--wf-sell); min-width:42px; text-align:right;">%@sellPct</span>
                            </div>
                        </div>
                    </div>
                </div>
            }

            @* ── Boğa & Ayı Analizi (Midas tarzı) ── *@
            @if (result.BullBear != null && (result.BullBear.BullThesis?.Any() == true || result.BullBear.BearThesis?.Any() == true))
            {
                <div class="sk-card" style="margin-bottom:14px;">
                    <div class="sk-card-h">
                        <span class="sk-h-title">Boğa & Ayı Analizi</span>
                        <div style="display:flex; gap:6px;">
                            <button @onclick="@(() => bullBearTab = "bull")" class="wf-btn xs @(bullBearTab == "bull" ? "primary" : "")">🐂 Boğa</button>
                            <button @onclick="@(() => bullBearTab = "bear")" class="wf-btn xs @(bullBearTab == "bear" ? "danger" : "")">🐻 Ayı</button>
                        </div>
                    </div>
                    @if (bullBearTab == "bull" && result.BullBear.BullThesis != null)
                    {
                        <div style="display:flex; flex-direction:column; gap:10px; padding:6px 0;">
                            @foreach (var item in result.BullBear.BullThesis)
                            {
                                <div style="display:flex; gap:10px; align-items:flex-start;">
                                    <span style="color:var(--wf-buy); font-family:var(--f-mono); font-size:14px; flex-shrink:0; margin-top:1px;">▲</span>
                                    <span style="font-family:var(--f-hand); font-size:14px; color:var(--wf-ink); line-height:1.5;">@item</span>
                                </div>
                            }
                        </div>
                    }
                    else if (bullBearTab == "bear" && result.BullBear.BearThesis != null)
                    {
                        <div style="display:flex; flex-direction:column; gap:10px; padding:6px 0;">
                            @foreach (var item in result.BullBear.BearThesis)
                            {
                                <div style="display:flex; gap:10px; align-items:flex-start;">
                                    <span style="color:var(--wf-sell); font-family:var(--f-mono); font-size:14px; flex-shrink:0; margin-top:1px;">▼</span>
                                    <span style="font-family:var(--f-hand); font-size:14px; color:var(--wf-ink); line-height:1.5;">@item</span>
                                </div>
                            }
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(result.BullBear.Balance))
                    {
                        <div class="sk-divider"></div>
                        <div style="display:flex; gap:8px; align-items:center;">
                            <span class="sk-tag">⚖ Denge</span>
                            <span style="font-family:var(--f-hand); font-size:13px; color:var(--wf-ink-dim); line-height:1.4;">@result.BullBear.Balance</span>
                        </div>
                    }
                </div>
            }

            @* ── Detaylı AI Yorumu — geniş alan ── *@
            @if (!string.IsNullOrWhiteSpace(result.AiCommentary))
            {
                <div class="sk-card" style="margin-bottom:14px; border-left:3px solid var(--wf-acc);">
                    <div class="sk-card-h">
                        <span class="sk-h-title">📋 Detaylı Mentor Yorumu</span>
                        <span class="sk-h-meta">Gemini AI · Türkçe</span>
                    </div>
                    <div style="font-family:var(--f-hand); font-size:14px; color:var(--wf-ink); line-height:1.65; white-space:pre-wrap;">@result.AiCommentary</div>
                </div>
            }

            @* ── EV / Kelly / Bayes — 3 kart ── *@
            <div class="sk-grid-3" style="margin-bottom:14px;">

                @* EV Card *@
                <div class="sk-card">
                    <div class="sk-card-h">
                        <span class="sk-h-title">Beklenen Değer (EV)</span>
                        <span class="sk-h-meta">lot başına</span>
                    </div>
                    <div class="sk-row" style="align-items:baseline; gap:10px; margin-bottom:10px;">
                        <span class="sk-num sk-num-xl" style="color:@(result.Ev?.Value >= 0 ? "var(--wf-buy)" : "var(--wf-sell)")">
                            @(result.Ev?.Value >= 0 ? "+" : "")$@(result.Ev?.Value.ToString("F2") ?? "—")
                        </span>
                        <span class="sk-tag">ROI %@(result.Ev?.RoiPct.ToString("F1") ?? "—")</span>
                    </div>
                    <div style="font-family:var(--f-mono); font-size:10px; color:var(--wf-ink-dim); margin-bottom:8px;">
                        EV = P(kaz)·R⁺ − P(kay)·R⁻
                    </div>
                    <div class="sk-divider"></div>
                    <div class="sk-row-between" style="margin-bottom:4px;">
                        <span class="sk-tag">P(kazanç)</span>
                        <div class="sk-row" style="gap:6px; flex:1; margin-left:10px;">
                            <div class="bar-track" style="flex:1;"><div class="bar-fill buy" style="width:@(winPct)%;"></div></div>
                            <span class="sk-num sk-num-sm" style="color:var(--wf-buy);">%@winPct</span>
                        </div>
                    </div>
                    <div class="sk-row-between">
                        <span class="sk-tag">P(kayıp)</span>
                        <div class="sk-row" style="gap:6px; flex:1; margin-left:10px;">
                            <div class="bar-track" style="flex:1;"><div class="bar-fill sell" style="width:@(losePct)%;"></div></div>
                            <span class="sk-num sk-num-sm" style="color:var(--wf-sell);">%@losePct</span>
                        </div>
                    </div>
                </div>

                @* Kelly Card *@
                <div class="sk-card">
                    <div class="sk-card-h">
                        <span class="sk-h-title">Kelly Fraction</span>
                        <span class="sk-h-meta">f* = (bp−q)/b</span>
                    </div>
                    <div class="sk-row" style="align-items:baseline; gap:10px; margin-bottom:8px;">
                        <span class="sk-num sk-num-xl" style="color:var(--wf-info);">
                            %@(result.Kelly?.FullPct.ToString("F1") ?? "—")
                        </span>
                        <span class="sk-tag">→ @result.Kelly?.Shares hisse</span>
                    </div>
                    <div class="bar-track" style="height:8px; margin-bottom:8px;">
                        <div class="bar-fill info" style="width:@(Math.Min(result.Kelly?.FullPct ?? 0, 100))%;"></div>
                    </div>
                    <div class="sk-divider"></div>
                    <div class="sk-row-between" style="margin-bottom:3px;">
                        <span class="sk-tag">Tam Kelly</span>
                        <span class="sk-num sk-num-sm">%@(result.Kelly?.FullPct.ToString("F1") ?? "—")</span>
                    </div>
                    <div class="sk-row-between" style="margin-bottom:3px;">
                        <span class="sk-tag" style="color:var(--wf-mentor);">Çeyrek Kelly (önerilen)</span>
                        <span class="sk-num sk-num-sm" style="color:var(--wf-mentor);">%@(result.Kelly?.QuarterPct.ToString("F1") ?? "—")</span>
                    </div>
                    <div class="sk-row-between">
                        <span class="sk-tag">Önerilen $</span>
                        <span class="sk-num sk-num-sm">$@(result.Kelly?.DollarAmount.ToString("F0") ?? "—")</span>
                    </div>
                </div>

                @* Bayes Card *@
                <div class="sk-card">
                    <div class="sk-card-h">
                        <span class="sk-h-title">Bayes Posterior</span>
                        <span class="sk-h-meta">P(AL | gözlem)</span>
                    </div>
                    <div class="sk-row" style="align-items:baseline; gap:10px; margin-bottom:8px;">
                        <span class="sk-num sk-num-xl" style="color:var(--wf-mentor);">%@posteriorPct</span>
                        <span class="sk-tag" style="color:@(bayesDelta >= 0 ? "var(--wf-buy)" : "var(--wf-sell)")">
                            @(bayesDelta >= 0 ? "+" : "")@bayesDelta pp
                        </span>
                    </div>
                    <div style="position:relative; height:28px; background:var(--wf-surface-3); border-radius:4px; margin-bottom:14px;">
                        <div style="position:absolute; left:@(priorPct)%; top:0; bottom:0; width:2px; background:var(--wf-ink-mute);"></div>
                        <div style="position:absolute; left:@(posteriorPct)%; top:0; bottom:0; width:2px; background:var(--wf-mentor);"></div>
                    </div>
                    <div class="sk-divider"></div>
                    <div style="font-family:var(--f-mono); font-size:10px; color:var(--wf-ink-dim); line-height:1.6;">
                        önsel <span style="color:var(--wf-ink)">%@priorPct</span>
                        → posterior <span style="color:var(--wf-mentor)">%@posteriorPct</span><br/>
                        @if (!string.IsNullOrEmpty(result.Probability?.NewsDirection))
                        {
                            <span>haber yönü: <span style="color:var(--wf-ink)">@result.Probability.NewsDirection</span></span>
                        }
                    </div>
                </div>
            </div>

            @* ── Haberler + Teknik Sinyaller ── *@
            <div class="sk-grid-2" style="margin-bottom:14px;">

                @* Haberler — TR yorumlu + sentiment rozetli *@
                <div class="sk-card">
                    <div class="sk-card-h">
                        <span class="sk-h-title">Haber & Olay Akışı</span>
                        <span class="sk-h-meta">Türkçe yorum · sentiment</span>
                    </div>
                    @if (result.NewsEnriched != null && result.NewsEnriched.Any())
                    {
                        <div style="display:flex; flex-direction:column; gap:0;">
                            @{ int nidx = 0; }
                            @foreach (var item in result.NewsEnriched.Take(6))
                            {
                                var sentClass = (item.Sentiment ?? "nötr") switch {
                                    "pozitif" => "buy",
                                    "negatif" => "sell",
                                    _ => "hold"
                                };
                                var sentLabel = (item.Sentiment ?? "nötr") switch {
                                    "pozitif" => "POZİTİF",
                                    "negatif" => "NEGATİF",
                                    _ => "NÖTR"
                                };
                                <div style="display:flex; flex-direction:column; gap:4px; padding:8px 0; border-top:@(nidx>0 ? "1px dashed var(--wf-border)" : "none");">
                                    <div style="display:flex; align-items:center; gap:8px;">
                                        <span class="v-badge @sentClass" style="font-size:10px;">@(item.ImpactEmoji ?? "●") @sentLabel</span>
                                        <span style="font-family:var(--f-mono); font-size:9px; color:var(--wf-ink-mute);">HABER #@(nidx+1)</span>
                                    </div>
                                    <span style="font-family:var(--f-hand); font-size:13px; color:var(--wf-ink); line-height:1.45;">@item.SummaryTr</span>
                                    @if (!string.IsNullOrWhiteSpace(item.Title) && item.Title != item.SummaryTr)
                                    {
                                        <span style="font-family:var(--f-mono); font-size:10px; color:var(--wf-ink-mute); line-height:1.3;">orijinal: @item.Title</span>
                                    }
                                </div>
                                nidx++;
                            }
                        </div>
                    }
                    else if (result.RecentNews != null && result.RecentNews.Any())
                    {
                        @* Fallback — eski format *@
                        <div style="display:flex; flex-direction:column; gap:0;">
                            @foreach (var news in result.RecentNews.Take(5))
                            {
                                var idx = result.RecentNews.IndexOf(news);
                                <div style="display:flex; align-items:flex-start; gap:8px; padding:7px 0; border-top:@(idx>0 ? "1px dashed var(--wf-border)" : "none");">
                                    <span style="font-family:var(--f-mono); font-size:9px; text-transform:uppercase; color:var(--wf-ink-mute); flex-shrink:0; margin-top:2px;">● haber</span>
                                    <span style="font-family:var(--f-hand); font-size:13px; color:var(--wf-ink); line-height:1.4;">@news</span>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <span class="sk-tag" style="color:var(--wf-ink-mute);">Haber yok</span>
                    }
                </div>

                @* Fundamentals / Sinyaller *@
                <div class="sk-card">
                    <div class="sk-card-h">
                        <span class="sk-h-title">Temel Göstergeler</span>
                        <span class="sk-h-meta">@result.Symbol</span>
                    </div>
                    @if (result.Fundamentals != null)
                    {
                        <div class="sk-grid-2" style="gap:6px;">
                            @FundStat("F/K", result.Fundamentals.PeRatio != null ? result.Fundamentals.PeRatio.Value.ToString("F1") : null)
                            @FundStat("EPS", result.Fundamentals.Eps != null ? $"${result.Fundamentals.Eps.Value:F2}" : null)
                            @FundStat("Gelir Büyüme", result.Fundamentals.RevenueGrowth != null ? $"%{result.Fundamentals.RevenueGrowth.Value:F1}" : null)
                            @FundStat("Brüt Marj", result.Fundamentals.GrossMargins != null ? $"%{result.Fundamentals.GrossMargins.Value:F1}" : null)
                            @FundStat("D/E", result.Fundamentals.DebtToEquity?.ToString("F2"))
                            @FundStat("52w Yüksek", result.Fundamentals.FiftyTwoWeekHigh != null ? $"${result.Fundamentals.FiftyTwoWeekHigh.Value:F2}" : null)
                            @FundStat("52w Düşük", result.Fundamentals.FiftyTwoWeekLow != null ? $"${result.Fundamentals.FiftyTwoWeekLow.Value:F2}" : null)
                            @FundStat("Analist Hedef", result.AnalystTarget != null ? $"${result.AnalystTarget.Value:F2}" : null)
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(result.AnalystRecommendation))
                    {
                        <div class="sk-divider"></div>
                        <div class="sk-row-between">
                            <span class="sk-tag">Analist tavsiye</span>
                            <span class="v-badge hold">@result.AnalystRecommendation</span>
                        </div>
                    }
                </div>
            </div>

            @* ── Paper Trade Panel ── *@
            <div class="sk-card thick" style="border-color:var(--wf-info); background:var(--wf-info-soft); margin-bottom:14px;">
                <div class="sk-card-h">
                    <span class="sk-h-title">Paper Trading</span>
                    <span class="sk-h-meta">simüle pozisyon</span>
                </div>
                @if (portfolio != null)
                {
                    <div class="sk-grid-3" style="margin-bottom:12px; gap:8px;">
                        <div style="display:flex; flex-direction:column; gap:2px;">
                            <span class="sk-tag">Nakit</span>
                            <span class="sk-num sk-num-md">$@portfolio.Cash.ToString("F2")</span>
                        </div>
                        <div style="display:flex; flex-direction:column; gap:2px;">
                            <span class="sk-tag">Pozisyon</span>
                            <span class="sk-num sk-num-md">$@portfolio.PositionsValue.ToString("F2")</span>
                        </div>
                        <div style="display:flex; flex-direction:column; gap:2px;">
                            <span class="sk-tag">Toplam Sermaye</span>
                            <span class="sk-num sk-num-md" style="color:var(--wf-mentor);">$@portfolio.TotalEquity.ToString("F2")</span>
                        </div>
                    </div>
                }
                <div style="display:flex; gap:8px; align-items:flex-end; flex-wrap:wrap;">
                    <div>
                        <span class="sk-tag" style="display:block; margin-bottom:3px;">Adet</span>
                        <input type="number" @bind="tradeShares" min="1" step="1" class="sk-input" style="width:80px;" />
                    </div>
                    <button @onclick="ExecuteBuy" disabled="@isTrading" class="wf-btn success">AL @result.Symbol</button>
                    <button @onclick="ExecuteSell" disabled="@isTrading" class="wf-btn danger">SAT</button>
                    @if (result.Kelly?.Shares > 0)
                    {
                        <button @onclick="UseKellyShares" class="wf-btn sm">
                            Kelly: @result.Kelly.Shares lot
                        </button>
                    }
                </div>
                @if (!string.IsNullOrEmpty(tradeMsg))
                {
                    <div style="margin-top:8px; font-family:var(--f-mono); font-size:11px; color:@(tradeSuccess ? "var(--wf-buy)" : "var(--wf-sell)");">
                        @tradeMsg
                    </div>
                }
            </div>
        }
        else if (!isLoading)
        {
            @* Empty state *@
            <div style="text-align:center; padding:80px 0; font-family:var(--f-hand); color:var(--wf-ink-dim);">
                <div style="font-size:32px; margin-bottom:12px;">◎</div>
                <div style="font-size:18px; margin-bottom:6px;">Sembol gir, analizi başlat</div>
                <div style="font-family:var(--f-mono); font-size:11px; color:var(--wf-ink-mute);">EV · Kelly · Bayes · Gemini AI yorumu</div>
            </div>
        }

    </main>

    @* ── Mentor Panel ── *@
    <aside class="ha-mentor-col">
        <div class="mentor-card">
            <div class="mentor-head">
                <div class="mentor-avatar">M</div>
                <div class="sk-stack" style="flex:1;">
                    <div class="mentor-name">Mentor · Doğa</div>
                    <div class="mentor-role">KUANTİTATİF ANALİST</div>
                </div>
                <span class="sk-tag" style="color:var(--wf-mentor);">● online</span>
            </div>
            <div class="mentor-stream">
                @if (!mentorMessages.Any())
                {
                    @if (result != null && result.Success)
                    {
                        var ev = result.Ev?.Value ?? 0;
                        var kf = result.Kelly?.QuarterPct ?? 0;
                        <div class="mentor-bubble">
                            @if (ev > 0)
                            {
                                <b style="color:var(--wf-mentor);">EV pozitif (+$@(ev.ToString("F2")))</b>
                            }
                            else
                            {
                                <b style="color:var(--wf-sell);">EV negatif ($@(ev.ToString("F2")))</b>
                            }
                            @if (kf > 0)
                            {
                                <span> · Kelly fraction <b>%@(kf.ToString("F1"))</b> — pozisyon buna göre ayarla.</span>
                            }
                        </div>
                        <div class="mentor-bubble" style="color:var(--wf-ink-mute); font-size:12px;">
                            Analiz hazır. Aşağıdan soru sor veya konuya göre chip'e tıkla.
                        </div>
                    }
                    else
                    {
                        <div class="mentor-bubble">
                            Merhaba! Bir sembol analiz et, sonra bana istediğini sor.<br/>
                            <span style="color:var(--wf-ink-mute); font-size:12px;">Bağımsız çalışıyorum — analiz beklemeden de soru sorabilirsin.</span>
                        </div>
                    }
                }
                @foreach (var msg in mentorMessages)
                {
                    @if (msg.IsUser)
                    {
                        <div class="mentor-bubble" style="background:var(--wf-buy-soft); color:var(--wf-buy); text-align:right; margin-left:12px;">
                            @msg.Text
                        </div>
                    }
                    else
                    {
                        <div class="mentor-bubble">
                            @msg.Text
                        </div>
                    }
                }
                @if (isMentorLoading)
                {
                    <div class="mentor-bubble" style="color:var(--wf-ink-mute);">
                        <span style="font-family:var(--f-mono); font-size:11px;">⏳ Mentor düşünüyor…</span>
                    </div>
                }
            </div>
            <div class="mentor-suggested">
                <span class="wf-chip" @onclick='() => SendChip("Neden Kelly düşük?")'>Neden Kelly düşük?</span>
                <span class="wf-chip" @onclick='() => SendChip("EV nasıl hesaplandı?")'>EV nasıl hesaplandı?</span>
                <span class="wf-chip" @onclick='() => SendChip("Risk planı öner")'>Risk planı öner</span>
            </div>
            <div class="mentor-input-row" style="display:flex; gap:6px; align-items:center;">
                <input @bind="mentorInput" @bind:event="oninput" @onkeydown="HandleMentorKey"
                       placeholder="Mentor'a sor…"
                       style="flex:1; background:transparent; border:none; font-family:var(--f-hand); font-size:13px; color:var(--wf-ink); outline:none;"
                       disabled="@isMentorLoading" />
                <button @onclick="SendMentorMessage" disabled="@(isMentorLoading || string.IsNullOrWhiteSpace(mentorInput))"
                        style="background:var(--wf-mentor); color:#000; border:none; border-radius:4px; padding:4px 10px; font-family:var(--f-hand); font-size:12px; cursor:pointer; opacity:@(isMentorLoading || string.IsNullOrWhiteSpace(mentorInput) ? "0.4" : "1");">
                    ↑
                </button>
            </div>
        </div>

        @* Paper portfolio mini özet *@
        @if (portfolio != null)
        {
            <div class="sk-card dashed" style="margin-top:4px;">
                <div class="sk-card-h">
                    <span class="sk-h-title">Paper Portfolio</span>
                    <span class="sk-h-meta">simüle</span>
                </div>
                <div class="sk-row-between" style="margin-bottom:6px;">
                    <span class="sk-tag">Toplam</span>
                    <span class="sk-num sk-num-md" style="color:var(--wf-mentor);">$@portfolio.TotalEquity.ToString("F0")</span>
                </div>
                <div class="sk-row-between">
                    <span class="sk-tag">Nakit</span>
                    <span class="sk-num sk-num-sm">$@portfolio.Cash.ToString("F0")</span>
                </div>
                @if (portfolio.Positions?.Any() == true)
                {
                    <div class="sk-divider"></div>
                    @foreach (var pos in portfolio.Positions.Take(4))
                    {
                        <div class="sk-row-between" style="margin-top:4px;">
                            <span class="sk-tag" style="color:var(--wf-ink);">@pos.Symbol</span>
                            <span class="sk-num sk-num-sm" style="color:@(pos.Pnl >= 0 ? "var(--wf-buy)" : "var(--wf-sell)");">
                                @(pos.Pnl >= 0 ? "+" : "")$@(pos.Pnl.ToString("F0"))
                            </span>
                        </div>
                    }
                }
            </div>
        }
    </aside>
</div>

@code {
    [Parameter] public string? Symbol { get; set; }

    private string symbolInput = "";
    private double portfolioSize = 10000;
    private double upsidePct = 15.0;
    private double stopPct = 7.0;
    private double? priorProb;
    private bool showAdvanced = false;
    private string bullBearTab = "bull";

    private bool isLoading = false;
    private string? errorMsg;
    private FinansalAnalizYaniti? result;

    private PaperPortfolio? portfolio;
    private double tradeShares = 1;
    private bool isTrading = false;
    private string? tradeMsg;
    private bool tradeSuccess;
    private bool isAddingWatch = false;

    // Mentor chat
    private record MentorMessage(string Text, bool IsUser);
    private List<MentorMessage> mentorMessages = new();
    private string mentorInput = "";
    private bool isMentorLoading = false;

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(Symbol))
        {
            symbolInput = Symbol.ToUpper();
            await RunAnalysis();
        }
        await RefreshPortfolio();
    }

    private void ToggleAdvanced() => showAdvanced = !showAdvanced;

    private async Task HandleKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !isLoading) await RunAnalysis();
    }

    private async Task RunAnalysis()
    {
        if (string.IsNullOrWhiteSpace(symbolInput))
        {
            errorMsg = "Sembol gir.";
            return;
        }
        isLoading = true;
        errorMsg = null;
        result = null;
        StateHasChanged();

        var req = new AnalyzeRequest
        {
            Symbol = symbolInput.Trim().ToUpper(),
            PortfolioSize = portfolioSize,
            TargetUpsidePct = upsidePct,
            StopLossPct = stopPct,
            PriorProbability = priorProb
        };

        result = await Ajan.AnalyzeAsync(req);

        if (result == null)
            errorMsg = "Sunucudan yanıt yok.";
        else if (!result.Success)
            errorMsg = result.Error ?? "Analiz başarısız.";

        isLoading = false;
        StateHasChanged();
    }

    private async Task RefreshPortfolio()
    {
        portfolio = await Ajan.GetPortfolioAsync();
    }

    private void UseKellyShares()
    {
        if (result?.Kelly?.Shares > 0)
            tradeShares = result.Kelly.Shares;
    }

    private async Task ExecuteBuy()
    {
        if (result?.Symbol == null || tradeShares <= 0) return;
        isTrading = true;
        tradeMsg = null;
        StateHasChanged();

        var r = await Ajan.BuyAsync(result.Symbol, tradeShares);
        tradeSuccess = r.Success;
        tradeMsg = r.Success
            ? $"✅ AL {r.Shares} {r.Symbol} @ ${r.Price:F2} = ${r.Total:F2} | Kalan: ${r.CashRemaining:F2}"
            : $"❌ {r.Error}";

        if (r.Success) await RefreshPortfolio();
        isTrading = false;
        StateHasChanged();
    }

    private async Task ExecuteSell()
    {
        if (result?.Symbol == null || tradeShares <= 0) return;
        isTrading = true;
        tradeMsg = null;
        StateHasChanged();

        var r = await Ajan.SellAsync(result.Symbol, tradeShares);
        tradeSuccess = r.Success;
        tradeMsg = r.Success
            ? $"✅ SAT {r.Shares} {r.Symbol} @ ${r.Price:F2} = ${r.Total:F2} | PnL: ${r.Pnl:F2}"
            : $"❌ {r.Error}";

        if (r.Success) await RefreshPortfolio();
        isTrading = false;
        StateHasChanged();
    }

    private async Task AddToWatchlist()
    {
        if (result?.Symbol == null) return;
        isAddingWatch = true;
        StateHasChanged();
        try
        {
            var mode = result.Symbol.Contains("-USD", StringComparison.OrdinalIgnoreCase) ? "CRYPTO" : "STOCK";
            var ok = await Ajan.AddWatchlistAsync(result.Symbol, mode);
            tradeSuccess = ok;
            tradeMsg = ok ? $"⭐ {result.Symbol} watchlist'e eklendi" : $"❌ {result.Symbol} eklenemedi";
        }
        finally
        {
            isAddingWatch = false;
            StateHasChanged();
        }
    }

    private async Task HandleMentorKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !isMentorLoading && !string.IsNullOrWhiteSpace(mentorInput))
            await SendMentorMessage();
    }

    private async Task SendChip(string question)
    {
        mentorInput = question;
        await SendMentorMessage();
    }

    private async Task SendMentorMessage()
    {
        var question = mentorInput.Trim();
        if (string.IsNullOrEmpty(question) || isMentorLoading) return;
        mentorInput = "";
        isMentorLoading = true;
        mentorMessages.Add(new MentorMessage(question, true));
        StateHasChanged();
        try
        {
            var client = HttpFactory.CreateClient("BackendApi");
            var contextData = new Dictionary<string, object>();
            if (result != null && result.Success)
            {
                contextData["symbol"] = result.Symbol ?? "";
                contextData["decision"] = result.Verdict ?? "";
                contextData["ev"] = result.Ev?.Value ?? 0;
                contextData["kelly_pct"] = result.Kelly?.QuarterPct ?? 0;
            }
            var body = new { user_message = question, context_data = contextData };
            var resp = await client.PostAsJsonAsync("/mentor/chat", body);
            if (resp.IsSuccessStatusCode)
            {
                var json = await resp.Content.ReadAsStringAsync();
                using var doc = JsonDocument.Parse(json);
                var reply = doc.RootElement.TryGetProperty("reply", out var r) && r.ValueKind == JsonValueKind.String
                    ? r.GetString()
                    : "Mentor yanıt veremedi.";
                mentorMessages.Add(new MentorMessage(reply ?? "Mentor yanıt veremedi.", false));
            }
            else
            {
                mentorMessages.Add(new MentorMessage("Sunucuya ulaşılamadı.", false));
            }
        }
        catch
        {
            mentorMessages.Add(new MentorMessage("Bağlantı hatası.", false));
        }
        finally
        {
            isMentorLoading = false;
            StateHasChanged();
        }
    }
}

@code {
    private RenderFragment FundStat(string label, string? value) => @<div style="display:flex; flex-direction:column; gap:2px; padding:6px 0; border-top:1px dashed var(--wf-border);">
        <span class="sk-tag">@label</span>
        <span class="sk-num sk-num-md">@(string.IsNullOrEmpty(value) ? "—" : value)</span>
    </div>;
}
