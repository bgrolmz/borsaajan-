@page "/hisse-analizi"
@page "/hisse-analizi/{Symbol}"
@rendermode InteractiveServer
@using BorsaAjani_Web.Models
@using BorsaAjani_Web.Services
@using Microsoft.AspNetCore.Components.Web
@inject FinansalAjanService Ajan
@inject NavigationManager Nav

<PageTitle>Hisse Analizi — Borsa Ajanı</PageTitle>

<div class="min-h-screen bg-ot-bg text-ot-accent p-6">
    <div class="max-w-6xl mx-auto">

        @* ── HEADER ── *@
        <header class="mb-6 flex items-center justify-between">
            <div>
                <h1 class="text-3xl font-bold">Hisse Analizi</h1>
                <p class="text-ot-muted text-sm mt-1">EV · Kelly · Bayes · Gemini AI yorumu</p>
            </div>
            <a href="/" class="text-ot-primary hover:underline text-sm">← Ana Sayfa</a>
        </header>

        @* ── INPUT PANEL ── *@
        <div class="bg-ot-card border border-ot-border rounded-xl p-5 mb-6">
            <div class="grid grid-cols-1 md:grid-cols-5 gap-3">
                <div class="md:col-span-2">
                    <label class="block text-xs text-ot-muted mb-1">Sembol</label>
                    <input @bind="symbolInput" @bind:event="oninput"
                           @onkeydown="HandleKey"
                           placeholder="AAPL, TSLA, NVDA..."
                           class="w-full bg-ot-surface border border-ot-border rounded-lg px-3 py-2 uppercase
                                  focus:outline-none focus:ring-2 focus:ring-ot-primary" />
                </div>
                <div>
                    <label class="block text-xs text-ot-muted mb-1">Portföy ($)</label>
                    <input type="number" @bind="portfolioSize"
                           class="w-full bg-ot-surface border border-ot-border rounded-lg px-3 py-2" />
                </div>
                <div>
                    <label class="block text-xs text-ot-muted mb-1">Hedef %</label>
                    <input type="number" @bind="upsidePct" step="0.5"
                           class="w-full bg-ot-surface border border-ot-border rounded-lg px-3 py-2" />
                </div>
                <div>
                    <label class="block text-xs text-ot-muted mb-1">Stop %</label>
                    <input type="number" @bind="stopPct" step="0.5"
                           class="w-full bg-ot-surface border border-ot-border rounded-lg px-3 py-2" />
                </div>
            </div>
            <div class="mt-4 flex gap-3">
                <button @onclick="RunAnalysis" disabled="@isLoading"
                        class="bg-ot-primary text-ot-bg font-semibold px-5 py-2 rounded-lg
                               hover:opacity-90 disabled:opacity-50">
                    @(isLoading ? "Analiz Ediliyor..." : "Analiz Et")
                </button>
                <button @onclick="ToggleAdvanced"
                        class="border border-ot-border px-4 py-2 rounded-lg text-sm hover:bg-ot-surface">
                    @(showAdvanced ? "Gelişmiş Gizle" : "Gelişmiş")
                </button>
            </div>

            @if (showAdvanced)
            {
                <div class="mt-3 grid grid-cols-1 md:grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs text-ot-muted mb-1">Önsel olasılık (boş = otomatik)</label>
                        <input type="number" @bind="priorProb" step="0.05" min="0" max="1"
                               class="w-full bg-ot-surface border border-ot-border rounded-lg px-3 py-2" />
                    </div>
                </div>
            }
        </div>

        @* ── ERROR ── *@
        @if (!string.IsNullOrEmpty(errorMsg))
        {
            <div class="bg-ot-danger/20 border border-ot-danger text-ot-danger rounded-lg p-4 mb-6">
                ⚠️ @errorMsg
            </div>
        }

        @* ── RESULT ── *@
        @if (result != null && result.Success)
        {
            var verdictColor = (result.Verdict ?? "") == "AL" ? "text-ot-primary"
                             : (result.Verdict ?? "").StartsWith("SAT") ? "text-ot-danger"
                             : "text-ot-warning";
            var confidenceTr = (result.Confidence ?? "") switch {
                "YUKSEK" => "YÜKSEK",
                "ORTA"   => "ORTA",
                "DUSUK"  => "DÜŞÜK",
                _        => result.Confidence ?? "-"
            };

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-5 mb-6">

                @* — TOP CARD — *@
                <div class="lg:col-span-3 bg-ot-card border border-ot-border rounded-xl p-5">
                    <div class="flex flex-wrap items-center justify-between gap-4">
                        <div>
                            <div class="text-3xl font-bold">@result.Symbol</div>
                            <div class="text-ot-muted text-sm">@result.Name • @result.Sector</div>
                        </div>
                        <div class="text-right">
                            <div class="text-2xl font-bold">$@(result.Price?.ToString("F2"))</div>
                            <div class="text-sm @(result.ChangePct >= 0 ? "text-ot-primary" : "text-ot-danger")">
                                @(result.ChangePct >= 0 ? "▲" : "▼") @(result.ChangePct?.ToString("F2"))%
                            </div>
                        </div>
                        <div class="text-center px-6">
                            <div class="text-xs text-ot-muted mb-1">VERDICT</div>
                            <div class="text-2xl font-bold @verdictColor">@result.Verdict</div>
                            <div class="text-xs text-ot-muted">@confidenceTr güven</div>
                        </div>
                    </div>
                </div>

                @* — EV CARD — *@
                <div class="bg-ot-card border border-ot-border rounded-xl p-5">
                    <h3 class="text-sm text-ot-muted mb-3">EXPECTED VALUE</h3>
                    <div class="text-3xl font-bold @((result.Ev?.Value ?? 0) > 0 ? "text-ot-primary" : "text-ot-danger")">
                        $@(result.Ev?.Value.ToString("F2"))
                    </div>
                    <div class="text-sm text-ot-muted mt-1">ROI: @(result.Ev?.RoiPct.ToString("F2"))%</div>
                    <div class="text-xs mt-2">@(result.Ev?.Verdict)</div>
                </div>

                @* — KELLY CARD — *@
                <div class="bg-ot-card border border-ot-border rounded-xl p-5">
                    <h3 class="text-sm text-ot-muted mb-3">KELLY POZİSYON</h3>
                    <div class="text-3xl font-bold text-ot-primary">@(result.Kelly?.RecommendedPct.ToString("F1"))%</div>
                    <div class="text-sm text-ot-muted mt-1">$@(result.Kelly?.DollarAmount.ToString("F0")) · @(result.Kelly?.Shares) hisse</div>
                    <div class="text-xs mt-2">Quarter-Kelly · 5% cap</div>
                </div>

                @* — PROBABILITY CARD — *@
                <div class="bg-ot-card border border-ot-border rounded-xl p-5">
                    <h3 class="text-sm text-ot-muted mb-3">OLASILIK (BAYES)</h3>
                    <div class="flex items-baseline gap-2">
                        <span class="text-xl text-ot-muted line-through">@((result.Probability?.Initial * 100)?.ToString("F1"))%</span>
                        <span class="text-3xl font-bold text-ot-primary">@((result.Probability?.AfterNews * 100)?.ToString("F1"))%</span>
                    </div>
                    <div class="text-sm mt-1 @(result.Probability?.NewsDirection == "BULLISH" ? "text-ot-primary" : "text-ot-danger")">
                        @result.Probability?.NewsDirection
                        @if (result.Probability?.BayesChange != null)
                        {
                            <span>(@(result.Probability.BayesChange > 0 ? "+" : "")@result.Probability.BayesChange.Value.ToString("F1") puan)</span>
                        }
                    </div>
                </div>

                @* — TARGETS — *@
                <div class="lg:col-span-3 bg-ot-card border border-ot-border rounded-xl p-5">
                    <h3 class="text-sm text-ot-muted mb-3">FİYAT HEDEFLERİ</h3>
                    <div class="grid grid-cols-3 gap-4 text-center">
                        <div>
                            <div class="text-xs text-ot-muted">STOP</div>
                            <div class="text-xl font-bold text-ot-danger">$@(result.Targets?.StopLoss.ToString("F2"))</div>
                            <div class="text-xs text-ot-danger">-@(result.Targets?.StopPct.ToString("F1"))%</div>
                        </div>
                        <div class="border-x border-ot-border">
                            <div class="text-xs text-ot-muted">GİRİŞ</div>
                            <div class="text-xl font-bold">$@(result.Targets?.Entry.ToString("F2"))</div>
                            <div class="text-xs text-ot-muted">şu an</div>
                        </div>
                        <div>
                            <div class="text-xs text-ot-muted">HEDEF</div>
                            <div class="text-xl font-bold text-ot-primary">$@(result.Targets?.Target.ToString("F2"))</div>
                            <div class="text-xs text-ot-primary">+@(result.Targets?.UpsidePct.ToString("F1"))%</div>
                        </div>
                    </div>
                </div>

                @* — LONGSHOT WARNING — *@
                @if (result.LongshotWarning)
                {
                    <div class="lg:col-span-3 bg-ot-warning/10 border border-ot-warning rounded-xl p-4">
                        <strong class="text-ot-warning">⚠️ Longshot Uyarısı:</strong> Olasilık %15 altında — sistematik overpriced riski var. Geç.
                    </div>
                }

                @* — AI COMMENTARY — *@
                @if (!string.IsNullOrEmpty(result.AiCommentary))
                {
                    <div class="lg:col-span-3 bg-ot-card border border-ot-border rounded-xl p-5">
                        <h3 class="text-sm text-ot-muted mb-3">🤖 GEMINI YORUMU</h3>
                        <div class="text-sm whitespace-pre-wrap">@result.AiCommentary</div>
                    </div>
                }

                @* — FUNDAMENTALS — *@
                @if (result.Fundamentals != null)
                {
                    <div class="lg:col-span-3 bg-ot-card border border-ot-border rounded-xl p-5">
                        <h3 class="text-sm text-ot-muted mb-3">TEMEL VERİLER</h3>
                        <div class="grid grid-cols-2 md:grid-cols-4 gap-3 text-sm">
                            @FundCell("P/E", result.Fundamentals.PeRatio?.ToString("F2"))
                            @FundCell("EPS", result.Fundamentals.Eps != null ? $"${result.Fundamentals.Eps:F2}" : null)
                            @FundCell("Gelir Büyüme", result.Fundamentals.RevenueGrowth != null ? $"{result.Fundamentals.RevenueGrowth:F1}%" : null)
                            @FundCell("Brüt Marj", result.Fundamentals.GrossMargins != null ? $"{result.Fundamentals.GrossMargins:F1}%" : null)
                            @FundCell("D/E", result.Fundamentals.DebtToEquity?.ToString("F2"))
                            @FundCell("52w Yüksek", result.Fundamentals.FiftyTwoWeekHigh != null ? $"${result.Fundamentals.FiftyTwoWeekHigh:F2}" : null)
                            @FundCell("52w Düşük", result.Fundamentals.FiftyTwoWeekLow != null ? $"${result.Fundamentals.FiftyTwoWeekLow:F2}" : null)
                            @FundCell("Analist Hedefi", result.AnalystTarget != null ? $"${result.AnalystTarget:F2}" : null)
                        </div>
                    </div>
                }

                @* — RECENT NEWS — *@
                @if (result.RecentNews != null && result.RecentNews.Any())
                {
                    <div class="lg:col-span-3 bg-ot-card border border-ot-border rounded-xl p-5">
                        <h3 class="text-sm text-ot-muted mb-3">SON HABERLER (Bayes güncellemesinde kullanıldı)</h3>
                        <ul class="space-y-2 text-sm">
                            @foreach (var news in result.RecentNews.Take(5))
                            {
                                <li class="border-l-2 border-ot-border pl-3 py-1">
                                    <span>@news</span>
                                </li>
                            }
                        </ul>
                    </div>
                }

                @* — PAPER TRADE PANEL — *@
                <div class="lg:col-span-3 bg-ot-card border-2 border-ot-primary rounded-xl p-5">
                    <h3 class="text-sm text-ot-muted mb-3">📈 PAPER TRADE</h3>

                    @if (portfolio != null)
                    {
                        <div class="mb-4 grid grid-cols-3 gap-3 text-sm">
                            <div>
                                <div class="text-xs text-ot-muted">Nakit</div>
                                <div class="font-bold">$@portfolio.Cash.ToString("F2")</div>
                            </div>
                            <div>
                                <div class="text-xs text-ot-muted">Pozisyon</div>
                                <div class="font-bold">$@portfolio.PositionsValue.ToString("F2")</div>
                            </div>
                            <div>
                                <div class="text-xs text-ot-muted">Toplam Sermaye</div>
                                <div class="font-bold text-ot-primary">$@portfolio.TotalEquity.ToString("F2")</div>
                            </div>
                        </div>
                    }

                    <div class="flex flex-wrap gap-3 items-end">
                        <div>
                            <label class="block text-xs text-ot-muted mb-1">Adet</label>
                            <input type="number" @bind="tradeShares" min="1" step="1"
                                   class="w-24 bg-ot-surface border border-ot-border rounded-lg px-3 py-2" />
                        </div>
                        <button @onclick="ExecuteBuy" disabled="@isTrading"
                                class="bg-ot-primary text-ot-bg font-semibold px-5 py-2 rounded-lg hover:opacity-90 disabled:opacity-50">
                            AL @result.Symbol
                        </button>
                        <button @onclick="ExecuteSell" disabled="@isTrading"
                                class="bg-ot-danger text-white font-semibold px-5 py-2 rounded-lg hover:opacity-90 disabled:opacity-50">
                            SAT
                        </button>
                        @if (result.Kelly?.Shares > 0)
                        {
                            <button @onclick="UseKellyShares"
                                    class="border border-ot-primary text-ot-primary px-4 py-2 rounded-lg text-sm hover:bg-ot-primary/10">
                                Kelly öneri: @result.Kelly.Shares hisse
                            </button>
                        }
                    </div>

                    @if (!string.IsNullOrEmpty(tradeMsg))
                    {
                        <div class="mt-3 text-sm @(tradeSuccess ? "text-ot-primary" : "text-ot-danger")">
                            @tradeMsg
                        </div>
                    }
                </div>

            </div>
        }

    </div>
</div>

@code {
    [Parameter] public string? Symbol { get; set; }

    private string symbolInput = "";
    private double portfolioSize = 10000;
    private double upsidePct = 15.0;
    private double stopPct = 7.0;
    private double? priorProb;
    private bool showAdvanced = false;

    private bool isLoading = false;
    private string? errorMsg;
    private FinansalAnalizYaniti? result;

    private PaperPortfolio? portfolio;
    private double tradeShares = 1;
    private bool isTrading = false;
    private string? tradeMsg;
    private bool tradeSuccess;

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(Symbol))
        {
            symbolInput = Symbol.ToUpper();
            await RunAnalysis();
        }
        await RefreshPortfolio();
    }

    private void ToggleAdvanced() => showAdvanced = !showAdvanced;

    private async Task HandleKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !isLoading) await RunAnalysis();
    }

    private async Task RunAnalysis()
    {
        if (string.IsNullOrWhiteSpace(symbolInput))
        {
            errorMsg = "Sembol gir.";
            return;
        }
        isLoading = true;
        errorMsg = null;
        result = null;
        StateHasChanged();

        var req = new AnalyzeRequest
        {
            Symbol = symbolInput.Trim().ToUpper(),
            PortfolioSize = portfolioSize,
            TargetUpsidePct = upsidePct,
            StopLossPct = stopPct,
            PriorProbability = priorProb
        };

        result = await Ajan.AnalyzeAsync(req);

        if (result == null)
            errorMsg = "Sunucudan yanıt yok.";
        else if (!result.Success)
            errorMsg = result.Error ?? "Analiz başarısız.";

        isLoading = false;
        StateHasChanged();
    }

    private async Task RefreshPortfolio()
    {
        portfolio = await Ajan.GetPortfolioAsync();
    }

    private void UseKellyShares()
    {
        if (result?.Kelly?.Shares > 0)
            tradeShares = result.Kelly.Shares;
    }

    private async Task ExecuteBuy()
    {
        if (result?.Symbol == null || tradeShares <= 0) return;
        isTrading = true;
        tradeMsg = null;
        StateHasChanged();

        var r = await Ajan.BuyAsync(result.Symbol, tradeShares);
        tradeSuccess = r.Success;
        tradeMsg = r.Success
            ? $"✅ AL {r.Shares} {r.Symbol} @ ${r.Price:F2} = ${r.Total:F2} | Kalan nakit: ${r.CashRemaining:F2}"
            : $"❌ {r.Error}";

        if (r.Success) await RefreshPortfolio();
        isTrading = false;
        StateHasChanged();
    }

    private async Task ExecuteSell()
    {
        if (result?.Symbol == null || tradeShares <= 0) return;
        isTrading = true;
        tradeMsg = null;
        StateHasChanged();

        var r = await Ajan.SellAsync(result.Symbol, tradeShares);
        tradeSuccess = r.Success;
        tradeMsg = r.Success
            ? $"✅ SAT {r.Shares} {r.Symbol} @ ${r.Price:F2} = ${r.Total:F2} | PnL: ${r.Pnl:F2}"
            : $"❌ {r.Error}";

        if (r.Success) await RefreshPortfolio();
        isTrading = false;
        StateHasChanged();
    }
}

@* ── Inline helper render fragment ── *@
@code {
    private RenderFragment FundCell(string label, string? value) => @<div>
        <div class="text-xs text-ot-muted">@label</div>
        <div class="font-semibold">@(string.IsNullOrEmpty(value) ? "—" : value)</div>
    </div>;
}
