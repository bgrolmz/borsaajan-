                <button class="px-2 py-1.5 text-[11px] bg-[#0b1326] border border-[#3a4a3f]/20 rounded-lg hover:border-[#00FFA3]/40 hover:text-[#00FFA3] transition-all text-[#b9cbbd] font-semibold" @onclick="HizliSecimSOL">SOL</button>
