                                    </div>
                                    <div class="p-3 bg-[#0b1326] rounded-lg">
                                        <div class="text-[9px] uppercase tracking-widest text-[#b9cbbd]/40 mb-1">Karar</div>
                                        <div class="text-xs font-black text-[#00FFA3]">@selectedHistoryItem.Decision</div>
                                    </div>
                                    <div class="p-3 bg-[#0b1326] rounded-lg">
                                        <div class="text-[9px] uppercase tracking-widest text-[#b9cbbd]/40 mb-1">Güven</div>
                                        <div class="text-xs font-bold text-[#00e290]">%@selectedHistoryItem.Confidence</div>
