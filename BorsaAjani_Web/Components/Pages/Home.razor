                            {
                                <li class="flex items-start gap-4">
                                    <span class="mt-1.5 w-1.5 h-1.5 bg-[#00FFA3] shrink-0"></span>
                                    <p class="text-[#e2e2eb]/80 leading-relaxed text-sm">@dn.WhyAnalysis</p>
                                </li>
                            }
                            @if (!string.IsNullOrEmpty(dn.TimeHorizon))
                            {
                                <li class="flex items-start gap-4">
                                    <span class="mt-1.5 w-1.5 h-1.5 bg-[#00FFA3] shrink-0"></span>
                                    <p class="text-[#e2e2eb]/80 leading-relaxed text-sm">Zaman ufku: @dn.TimeHorizon</p>
                                </li>
                            }
                            @if (string.IsNullOrEmpty(dn.Reason) && string.IsNullOrEmpty(dn.WhyAnalysis))
                            {
                                <li class="flex items-start gap-4">
                                    <span class="mt-1.5 w-1.5 h-1.5 bg-[#00FFA3] shrink-0"></span>
                                    <p class="text-[#e2e2eb]/80 leading-relaxed text-sm">Haber analizi işleniyor. Sonuçlar kısa süre içinde burada görünecek.</p>
                                </li>
                            }
                        </ul>
                    </section>

                    @if (!string.IsNullOrEmpty(dn.Summary))
                    {
                        <article class="space-y-6">
                            <p class="text-lg leading-relaxed text-[#e2e2eb]/90">@dn.Summary</p>
                        </article>
                    }

                    @if (dn.PastOutcomes.Any())
                    {
                        <section class="bg-[#191b22] p-8 border-l-4 border-[#282a30]">
                            <div class="flex items-center gap-3 mb-6">
                                <span class="material-symbols-outlined text-[#b9cbbd]/60">history</span>
                                <h3 class="font-['Manrope'] text-lg font-bold uppercase tracking-tight text-[#b9cbbd]/80">Geçmiş Benzer Sonuçlar</h3>
                            </div>
                            <div class="space-y-3">
                                @foreach (var outcome in dn.PastOutcomes)
                                {
                                    var isPos = outcome.PriceChangePct.HasValue && outcome.PriceChangePct.Value >= 0;
                                    var changeClass = outcome.PriceChangePct.HasValue ? (isPos ? "text-[#00FFA3]" : "text-[#ffb4ab]") : "text-[#b9cbbd]/40";
                                    <div class="flex items-center justify-between gap-4 py-3 border-b border-[#282a30]/50 last:border-0">
                                        <p class="text-sm text-[#e2e2eb]/70 leading-snug flex-1">@outcome.Title</p>
                                        @if (outcome.PriceChangePct.HasValue)
                                        {
                                            <span class="font-mono text-sm font-bold @changeClass shrink-0">@(isPos ? "+" : "")@outcome.PriceChangePct.Value.ToString("F1")%</span>
                                        }
                                        else if (!string.IsNullOrEmpty(outcome.ActualImpact))
                                        {
                                            <span class="font-mono text-sm font-bold @changeClass shrink-0">@outcome.ActualImpact</span>
                                        }
                                    </div>
                                }
                            </div>
                        </section>
                    }
                </div>

                <div class="lg:col-span-4 space-y-8">
                    <section class="bg-[#191b22] p-6 border border-[#282a30]">
                        <div class="flex items-center justify-between mb-6">
                            <h3 class="font-['Manrope'] text-sm font-bold uppercase tracking-widest text-[#e2e2eb]">Asset Impact</h3>
                            <div class="flex items-center gap-1.5">
                                <div class="w-1.5 h-1.5 bg-[#00FFA3] animate-pulse"></div>
                                <span class="text-[9px] font-mono uppercase text-[#00FFA3]">Live Analysis</span>
                            </div>
                        </div>
                        <div class="space-y-4">
                            @foreach (var sym in dn.Symbols.Take(4))
                            {
                                <div class="bg-[#0c0e14] p-4 @dnImpactBorder border-l-2 hover:bg-[#191b22] transition-colors">
                                    <div class="flex justify-between items-start mb-1">
                                        <span class="font-mono font-bold @dnImpactText">@sym</span>
                                        <span class="text-[10px] px-1.5 py-0.5 @dnImpactBg font-mono">@dnImpactLabel.ToUpper()</span>
                                    </div>
                                    @if (dn.Confidence > 0)
                                    {
                                        <div class="text-[10px] text-[#e2e2eb]/40 uppercase mb-1">Güven: @dn.Confidence%</div>
                                    }
                                    @if (!string.IsNullOrEmpty(dn.Reason))
                                    {
                                        <div class="text-xs text-[#e2e2eb]/70 leading-relaxed">@(dn.Reason.Length > 90 ? dn.Reason[..90] + "…" : dn.Reason)</div>
                                    }
                                </div>
                            }
                            @if (!dn.Symbols.Any())
                            {
                                <div class="bg-[#0c0e14] p-4 border-l-2 @dnImpactBorder hover:bg-[#191b22] transition-colors">
                                    <div class="flex justify-between items-start mb-1">
                                        <span class="font-mono font-bold @dnImpactText">MARKET</span>
                                        <span class="text-[10px] px-1.5 py-0.5 @dnImpactBg font-mono">@dnImpactLabel.ToUpper()</span>
                                    </div>
                                    @if (!string.IsNullOrEmpty(dn.Reason))
                                    {
                                        <div class="text-xs text-[#e2e2eb]/70 leading-relaxed">@(dn.Reason.Length > 90 ? dn.Reason[..90] + "…" : dn.Reason)</div>
                                    }
                                </div>
                            }
                        </div>
                    </section>

                    @if (newsItems.Count > 1)
                    {
                        <section class="space-y-4">
                            <h3 class="font-['Manrope'] text-sm font-bold uppercase tracking-widest text-[#e2e2eb]/60 px-2">Related Signals</h3>
                            @foreach (var related in newsItems.Where(n => n.Id != dn.Id).Take(3))
                            {
                                var relSentiment = related.Sentiment == "bullish" ? "POSITIVE" : related.Sentiment == "bearish" ? "NEGATIVE" : "NEUTRAL";
                                var relSignalColor = related.Sentiment == "bullish" ? "text-[#00FFA3]" : related.Sentiment == "bearish" ? "text-[#ffb4ab]" : "text-[#e2e2eb]/40";
                                var relIcon = related.Sentiment == "bullish" ? "trending_up" : related.Sentiment == "bearish" ? "trending_down" : "query_stats";
                                <div class="bg-[#0c0e14] p-4 border border-[#282a30]/50 hover:border-[#00FFA3]/30 cursor-pointer transition-all group" @onclick="() => { selectedNewsItem = related; }">
                                    <div class="flex items-center gap-3 mb-3">
                                        <span class="material-symbols-outlined text-[#00FFA3] text-lg">@relIcon</span>
                                        <span class="font-mono text-[10px] text-[#e2e2eb]/40 uppercase">@(related.Impact == "HIGH" ? "High Impact" : related.Impact == "MEDIUM" ? "Med Impact" : "Low Impact")</span>
                                    </div>
                                    <h4 class="text-sm font-medium leading-tight group-hover:text-[#00FFA3] transition-colors mb-2">@(related.Title.Length > 65 ? related.Title[..65] + "…" : related.Title)</h4>
                                    <div class="flex justify-between items-center text-[10px] font-mono">
                                        <span class="@relSignalColor">SIGNAL: @relSentiment</span>
                                        <span class="text-[#e2e2eb]/20">@related.TimeAgo</span>
                                    </div>
                                </div>
                            }
                        </section>
                    }

                    <section class="bg-[#0c0e14] border border-[#282a30] p-4">
                        <div class="text-[9px] font-mono text-[#e2e2eb]/30 uppercase space-y-2">
                            <div class="flex justify-between">
                                <span>Analysis Confidence</span>
                                <span class="text-[#00FFA3]">@(dn.Confidence > 0 ? $"{dn.Confidence}.0%" : "N/A")</span>
                            </div>
                            <div class="w-full bg-[#191b22] h-1">
                                <div class="bg-[#00FFA3] h-full shadow-[0_0_8px_#00FFA344]" style="width: @(dn.Confidence > 0 ? $"{dn.Confidence}%" : "0%")"></div>
                            </div>
                            <div class="flex justify-between pt-2">
                                <span>Market Impact</span>
                                <span>@dnImpactLabel</span>
                            </div>
                            <div class="flex justify-between">
                                <span>Time Horizon</span>
                                <span>@(string.IsNullOrEmpty(dn.TimeHorizon) ? "—" : dn.TimeHorizon)</span>
                            </div>
                        </div>
                    </section>
                </div>
            </div>

            <footer class="border-t border-[#282a30]/30 mt-10 p-6 flex flex-col md:flex-row justify-between items-center gap-4 text-[10px] font-mono uppercase text-[#e2e2eb]/20">
                <div>System Identity: SOV-INTEL-992-DELTA</div>
                <div class="flex items-center gap-6">
                    <span>© @DateTime.Now.Year Sovereign Intelligence</span>
                    <span class="text-[#00FFA3]/40">Status: Terminal Encryption Active</span>
                </div>
            </footer>
        }
        else
        {
            <div class="mb-8 flex justify-between items-end border-b border-[#3a4a3f]/20 pb-6">
                <div>
                    <h1 class="text-4xl font-extrabold font-['Manrope'] tracking-tighter text-[#e2e2eb] mb-2">INTELLIGENCE FEED</h1>
                    <p class="text-sm uppercase tracking-[0.3em] text-[#b9cbbd]/60">Cross-Asset Neural Analysis // Sector: Global Markets</p>
                </div>
                <div class="text-right">
                    <div class="text-xs uppercase tracking-widest text-[#b9cbbd]">System Status</div>
                    <div class="font-mono text-[#00FFA3] text-lg font-bold">@(isLoadingNotifications ? "SYNCING..." : "OPTIMIZED")</div>
                </div>
            </div>

            @if (isLoadingNotifications)
            {
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-px bg-[#282a30]/20 border border-[#282a30]/20">
                    @for (int i = 0; i < 6; i++)
                    {
                        <div class="bg-[#1e1f26] p-6 animate-pulse" style="height: 220px;"></div>
                    }
                </div>
            }
            else if (newsItems.Count == 0)
            {
                <div class="flex flex-col items-center justify-center py-24 text-center">
                    <span class="material-symbols-outlined text-6xl text-[#b9cbbd]/20 mb-6">article</span>
                    <h3 class="text-lg font-bold uppercase tracking-widest text-[#b9cbbd]/40 mb-2">No Intelligence Available</h3>
                    <p class="text-xs text-[#b9cbbd]/30 uppercase tracking-widest">Yeni haberler geldiğinde burada görünecek.</p>
                </div>
            }
            else
            {
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-px bg-[#282a30]/20 border border-[#282a30]/20">
                    @foreach (var news in newsItems.OrderByDescending(n => n.Timestamp))
                    {
                        var impactBgClass = news.Sentiment == "bullish"
                            ? "bg-[#00FFA3] text-[#003920]"
                            : news.Sentiment == "bearish"
                                ? "bg-[#93000a]/30 text-[#ffb4ab]"
                                : "bg-[#282a30] text-[#b9cbbd]";
                        var impactLabel = news.Sentiment == "bullish" ? "Positive"
                            : news.Sentiment == "bearish" ? "Negative"
                            : "Neutral";
                        var sourceAbbr = news.Symbols.Any() ? news.Symbols.First()[..Math.Min(3, news.Symbols.First().Length)].ToUpper() : "SRC";

                        <div class="bg-[#1e1f26] p-6 hover:bg-[#282a30] transition-colors group cursor-pointer flex flex-col gap-4" @onclick="() => { selectedNewsItem = news; }">
                            <div class="flex justify-between items-start">
                                <span class="font-mono text-[10px] text-[#b9cbbd]/60">@news.TimeAgo</span>
                                <div class="flex items-center gap-2">
                                    @if (news.Confidence > 0)
                                    {
                                        <span class="text-[9px] bg-[#3c4a5e] text-[#b9c7df] px-1.5 py-0.5 font-bold uppercase tracking-tighter">@news.Confidence%</span>
                                    }
                                    <span class="text-[9px] @impactBgClass px-1.5 py-0.5 font-bold uppercase tracking-tighter">@impactLabel</span>
                                </div>
                            </div>

                            <h3 class="text-sm font-bold leading-snug group-hover:text-[#00FFA3] transition-colors">@news.Title</h3>

                            @if (news.Symbols.Any())
                            {
                                <div class="flex flex-wrap gap-1">
                                    @foreach (var sym in news.Symbols.Take(5))
                                    {
                                        <span class="text-[9px] bg-[#191b22] border border-[#3a4a3f]/30 text-[#00FFA3] px-1.5 py-0.5 font-bold uppercase">@sym</span>
                                    }
                                    @if (news.Symbols.Count > 5)
                                    {
                                        <span class="text-[9px] bg-[#191b22] border border-[#3a4a3f]/30 text-[#b9cbbd]/50 px-1.5 py-0.5 font-bold">+@(news.Symbols.Count - 5)</span>
                                    }
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(news.Reason))
                            {
                                <div class="border-l-2 border-[#00FFA3]/40 pl-3">
                                    <div class="text-[9px] uppercase tracking-widest text-[#00FFA3]/60 mb-1">Analiz</div>
                                    <p class="text-xs text-[#b9cbbd]/80 leading-relaxed line-clamp-3">@news.Reason</p>
                                </div>
                            }
                            else if (!string.IsNullOrEmpty(news.Summary))
                            {
                                <p class="text-xs text-[#b9cbbd]/70 leading-relaxed line-clamp-3">@news.Summary</p>
                            }

                            @if (news.PastOutcomes.Any())
                            {
                                <div class="pt-3 border-t border-[#282a30]">
                                    <div class="text-[9px] uppercase tracking-widest text-[#b9cbbd]/40 mb-2">Geçmiş Sonuçlar</div>
                                    @foreach (var outcome in news.PastOutcomes.Take(2))
                                    {
                                        var isPositive = outcome.PriceChangePct.HasValue && outcome.PriceChangePct.Value >= 0;
                                        var changeTextClass = outcome.PriceChangePct.HasValue
                                            ? (isPositive ? "text-[#00FFA3]" : "text-[#ffb4ab]")
                                            : "text-[#b9cbbd]/50";
                                        <div class="flex justify-between items-baseline gap-2 py-1 border-b border-[#282a30] last:border-0">
                                            <span class="text-[10px] text-[#b9cbbd]/60 flex-1 min-w-0 truncate">@(outcome.Title.Length > 52 ? outcome.Title[..52] + "…" : outcome.Title)</span>
                                            @if (outcome.PriceChangePct.HasValue)
                                            {
                                                <span class="text-[10px] font-bold @changeTextClass shrink-0">@(isPositive ? "+" : "")@outcome.PriceChangePct.Value.ToString("F1")%</span>
                                            }
                                            else if (!string.IsNullOrEmpty(outcome.ActualImpact))
                                            {
                                                <span class="text-[10px] font-bold @changeTextClass shrink-0">@outcome.ActualImpact</span>
                                            }
                                        </div>
                                    }
                                </div>
                            }

                            <div class="flex items-center gap-2 mt-auto pt-2">
                                <div class="w-6 h-6 bg-[#282a30] flex items-center justify-center text-[9px] font-bold text-[#b9cbbd] shrink-0">@sourceAbbr</div>
                                <span class="text-[10px] text-[#b9cbbd]/50 uppercase tracking-widest truncate">@(news.Symbols.Any() ? string.Join(" · ", news.Symbols.Take(3)) : "Intelligence Feed")</span>
                            </div>
                        </div>
                    }
                </div>
            }
        }
    }


    </main>

