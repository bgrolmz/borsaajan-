        margin-bottom: 16px;
    }

    .form-group label {
        display: block;
        color: #c9d1d9;
        margin-bottom: 8px;
        font-size: 0.875rem;
    }

    .form-input {
        width: 100%;
        padding: 12px 16px;
        background: rgba(26, 26, 26, 0.8);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 12px;
        color: #ffffff;
        font-size: 0.95rem;
        transition: all 0.3s ease;
        min-height: 44px;
