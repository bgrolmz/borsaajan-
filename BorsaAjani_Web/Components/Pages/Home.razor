    .tab-content {
        padding: 20px;
    }
    
    /* Portfolio Styles - Modern Fintech */
    .portfolio-summary-card {
        background: rgba(26, 26, 26, 0.7);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 16px;
