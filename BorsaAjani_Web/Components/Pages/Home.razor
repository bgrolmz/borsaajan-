                                <div class="grid grid-cols-12 px-5 py-3.5 border-b border-[#3a4a3f]/10 last:border-0 cursor-pointer hover:bg-[#2d3449]/30 transition-colors @(isSelected ? "bg-[#2d3449]/50 border-l-2 border-l-[#00FFA3]" : "")" @onclick="() => { selectedPortfolioHistoryItem = item; StateHasChanged(); }">
                                    <div class="col-span-3 text-xs text-[#b9cbbd]/60 font-mono">@item.Date</div>
                                    <div class="col-span-2">
