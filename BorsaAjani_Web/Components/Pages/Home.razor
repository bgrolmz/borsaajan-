    private async Task LoadNotifications()
    {
        isLoadingNotifications = true;
        notificationItems.Clear();
        newsItems.Clear();
        StateHasChanged();

        try
        {
            var client = HttpClientFactory.CreateClient("BackendApi");
            var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };

            var notifTask = client.GetAsync("/notifications?limit=50");
            var historyTask = client.GetAsync("/news/history/all?limit=50");

            await Task.WhenAll(notifTask, historyTask);

            var notifResponse = await notifTask;
            if (notifResponse.IsSuccessStatusCode)
            {
                var json = await notifResponse.Content.ReadAsStringAsync();
                var data = JsonSerializer.Deserialize<JsonElement>(json, options);
                if (data.TryGetProperty("notifications", out var notificationsArray))
                {
                    foreach (var item in notificationsArray.EnumerateArray())
                    {
                        notificationItems.Add(new NotificationItem
                        {
                            Id = item.TryGetProperty("id", out var id) ? id.GetInt32() : 0,
                            Timestamp = item.TryGetProperty("timestamp", out var ts) ? ts.GetString() ?? "" : "",
                            Title = item.TryGetProperty("title", out var title) ? title.GetString() ?? "" : "",
                            Message = item.TryGetProperty("message", out var msg) ? msg.GetString() ?? "" : "",
                            Type = item.TryGetProperty("type", out var type) ? type.GetString() ?? "" : ""
                        });
                    }
                }
            }

            var historyResponse = await historyTask;
            if (historyResponse.IsSuccessStatusCode)
            {
                var histJson = await historyResponse.Content.ReadAsStringAsync();
                var histData = JsonSerializer.Deserialize<JsonElement>(histJson, options);
                if (histData.TryGetProperty("history", out var histArray))
                {
                    foreach (var item in histArray.EnumerateArray())
                    {
                        var impactRaw = item.TryGetProperty("impact", out var imp) ? imp.GetString() ?? "" : "";
                        var impactUpper = impactRaw.ToUpper();
                        string impact = impactUpper switch
                        {
                            "POSITIVE" or "BULLISH" => "HIGH",
                            "NEGATIVE" or "BEARISH" => "MEDIUM",
                            _ => "LOW"
                        };
                        string sentiment = impactUpper switch
                        {
                            "POSITIVE" or "BULLISH" => "bullish",
                            "NEGATIVE" or "BEARISH" => "bearish",
                            _ => "neutral"
                        };
                        int conf = 0;
                        if (item.TryGetProperty("confidence", out var confEl) && confEl.ValueKind == JsonValueKind.Number)
                            conf = confEl.GetInt32();

                        var sym = item.TryGetProperty("symbol", out var symEl) ? symEl.GetString() ?? "" : "";

                        newsItems.Add(new NewsItem
                        {
                            Id = item.TryGetProperty("id", out var nid) ? nid.GetInt32() : 0,
                            Title = item.TryGetProperty("title", out var title) ? title.GetString() ?? "" : "",
                            Reason = item.TryGetProperty("reason", out var reason) ? reason.GetString() ?? "" : "",
                            WhyAnalysis = item.TryGetProperty("comment", out var cmt) ? cmt.GetString() ?? "" : "",
                            Summary = item.TryGetProperty("advice", out var adv) ? adv.GetString() ?? "" : "",
                            Impact = impact,
                            Sentiment = sentiment,
                            Confidence = conf,
                            TimeHorizon = item.TryGetProperty("time_horizon", out var th) ? th.GetString() ?? "" : "",
                            Symbols = !string.IsNullOrEmpty(sym) ? new List<string> { sym } : new List<string>(),
                            Timestamp = item.TryGetProperty("created_at", out var ts) && DateTime.TryParse(ts.GetString(), out var dt)
                                ? dt : DateTime.Now.AddMinutes(-60)
                        });
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Notifications load error: {ex.Message}");
            hataMesaji = $"Bildirimler yüklenirken hata: {ex.Message}";
        }
        finally
        {
            if (newsItems.Count == 0)
                LoadNewsFromAnalysis();
            isLoadingNotifications = false;
            StateHasChanged();
        }
    }

    private void LoadNewsFromAnalysis()
    {
        if (veri?.Ai_Interpreted_News?.Any() != true) return;
        foreach (var haber in veri.Ai_Interpreted_News)
        {
            var impact = haber.Priority?.ToUpper() switch
            {
                "HIGH" or "KRİTİK" or "CRITICAL" => "HIGH",
                "MEDIUM" or "ORTA" => "MEDIUM",
                _ => "LOW"
            };
            if (haber.Is_Critical) impact = "HIGH";
            newsItems.Add(new NewsItem
            {
                Id = newsItems.Count + 1,
                Title = haber.Title ?? "",
                Summary = haber.Explanation ?? "",
                WhyAnalysis = haber.Ai_Investor_Comment ?? "",
                Impact = impact,
                Sentiment = haber.Impact?.ToLower() switch
                {
                    "pozitif" or "positive" or "bullish" => "bullish",
                    "negatif" or "negative" or "bearish" => "bearish",
                    _ => "neutral"
                },
                Symbols = !string.IsNullOrEmpty(veri.Sembol) ? new List<string> { veri.Sembol } : new List<string>(),
                Timestamp = DateTime.Now.AddMinutes(-5)
            });
        }
    }
    
    private async Task AnalizEt()
    {
        yukleniyor = true;
        aiYukleniyor = true;
        hataMesaji = "";
        veri = null;
        StateHasChanged();

        try
        {
            var client = HttpClientFactory.CreateClient("BackendApi");
            
            // STAGE 1: Fast Market Data (under 1 second) - PRIORITY
            var marketDataUrl = $"/market-data/{sembol}?mode={mod}";
            var marketDataResponse = await client.GetAsync(marketDataUrl);

            if (marketDataResponse.IsSuccessStatusCode)
            {
                var marketDataJson = await marketDataResponse.Content.ReadAsStringAsync();
                var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
                veri = JsonSerializer.Deserialize<BorsaYaniti>(marketDataJson, options);

                // Immediately show market data (price, chart, technicals)
                yukleniyor = false; // Market data loaded, show chart and price
                StateHasChanged();

                // Render chart immediately if data exists
                if (veri?.Grafik_Verileri != null && veri.Grafik_Verileri.Count > 0)
                {
                    await Task.Delay(100); // Small delay to ensure DOM is ready
                    await RenderChart();
                }
            }
            else
            {
                hataMesaji = $"Market Data Hatası: {marketDataResponse.StatusCode}";
                yukleniyor = false;
                aiYukleniyor = false;
                StateHasChanged();
                return;
            }

            // STAGE 2: AI Insight (background, can take 5-10 seconds)
            // Fire-and-forget: Load AI in background while user views chart
            _ = LoadAIInsightAsync(client);
        }
        catch (Exception ex)
        {
            hataMesaji = $"Genel Hata: {ex.Message}";
            yukleniyor = false;
            aiYukleniyor = false;
            StateHasChanged();
        }
    }

    private async Task LoadAIInsightAsync(HttpClient client)
    {
        try
        {
            var aiUrl = $"/ai-insight/{sembol}?mode={mod}&use_llm={(useLLM ? 1 : 0)}&detail={detailLevel}";
            if (mod == "STOCK" && maliyet.HasValue)
            {
                string maliyetFormatli = maliyet.Value.ToString(System.Globalization.CultureInfo.InvariantCulture);
                aiUrl += $"&maliyet={maliyetFormatli}";
            }

            var aiResponse = await client.GetAsync(aiUrl);

            if (aiResponse.IsSuccessStatusCode)
            {
                var aiJson = await aiResponse.Content.ReadAsStringAsync();
                var aiOptions = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
                var aiData = JsonSerializer.Deserialize<BorsaYaniti>(aiJson, aiOptions);

                // Merge AI data into existing veri
                await InvokeAsync(() =>
                {
                    if (veri != null && aiData != null)
                    {
                        veri.Analiz = aiData.Analiz;
                        veri.Benzer_Gecmis_Senaryo = aiData.Benzer_Gecmis_Senaryo;
                        veri.Anlik_Olay_Kontrolu = aiData.Anlik_Olay_Kontrolu;
                        veri.Haber_Skoru = aiData.Haber_Skoru;
                        veri.Master_Analysis = aiData.Master_Analysis;
                        if (aiData.Ai_Interpreted_News?.Any() == true)
                            veri.Ai_Interpreted_News = aiData.Ai_Interpreted_News;
                    }

                    // Update chat context
                    if (veri != null && veri.Fiyat_Bilgisi != null)
                    {
                        var newsSummary = !string.IsNullOrEmpty(veri.Anlik_Olay_Kontrolu)
                            ? veri.Anlik_Olay_Kontrolu
                            : !string.IsNullOrEmpty(veri.Benzer_Gecmis_Senaryo)
                                ? veri.Benzer_Gecmis_Senaryo
                                : "";
                        
                        if (newsSummary.Length > 200)
                            newsSummary = newsSummary.Substring(0, 200) + "...";
                        
                        ContextService.SetStockContext(
                            symbol: veri.Sembol ?? sembol,
                            price: veri.Fiyat_Bilgisi.Fiyat ?? 0,
                            rsi: veri.Fiyat_Bilgisi.Rsi,
                            fairValue: veri.Adil_Deger ?? 0,
                            newsSummary: newsSummary
                        );
                    }

                    aiYukleniyor = false;
                    StateHasChanged();
                });
            }
            else
            {
                await InvokeAsync(() =>
                {
                    if (string.IsNullOrEmpty(hataMesaji))
                        hataMesaji = $"AI Insight Hatası: {aiResponse.StatusCode}";
                    aiYukleniyor = false;
                    StateHasChanged();
                });
            }
        }
        catch (Exception ex)
        {
            await InvokeAsync(() =>
            {
                if (string.IsNullOrEmpty(hataMesaji))
                    hataMesaji = $"AI Insight Hata: {ex.Message}";
                aiYukleniyor = false;
                StateHasChanged();
            });
        }
    }

