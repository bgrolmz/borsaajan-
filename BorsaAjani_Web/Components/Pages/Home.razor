    .panel-content p {
        color: #c9d1d9;
        font-size: 0.85rem;
        line-height: 1.5;
        margin: 0;
    }

    .technical-depth,
    .competitor-text,
    .pattern-text {
        color: #e6edf3;
        font-size: 0.85rem;
        line-height: 1.5;
    }

    .risk-warning {
        background: rgba(218, 54, 51, 0.2);
        border-left: 3px solid #f85149;
        padding: 10px;
        border-radius: 6px;
        color: #ffa198;
        font-size: 0.85rem;
    }

    .error-banner {
        background: rgba(218, 54, 51, 0.3);
        backdrop-filter: blur(10px);
        color: white;
        padding: 12px 16px;
        border-radius: 8px;
        margin-bottom: 12px;
        border: 1px solid rgba(218, 54, 51, 0.5);
    }

    .empty-state {
        text-align: center;
        padding: 60px 20px;
        color: #8b949e;
        font-size: 1.1rem;
    }
    
    /* Tab Transitions */
    .fade-in {
        animation: fadeIn 0.3s ease-in-out;
    }
    
    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    
    /* Skeleton Loader */
    .skeleton-container {
        padding: 20px;
    }
    
    .skeleton-ticker-tape {
        display: grid;
        grid-template-columns: auto 1fr auto auto;
        gap: 16px;
        align-items: center;
        background: rgba(22, 27, 34, 0.6);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(48, 54, 61, 0.5);
        border-radius: 12px;
        padding: 12px 20px;
        margin-bottom: 12px;
    }
    
    .skeleton-item {
        height: 40px;
        background: linear-gradient(90deg, 
            rgba(48, 54, 61, 0.4) 25%, 
            rgba(48, 54, 61, 0.6) 50%, 
            rgba(48, 54, 61, 0.4) 75%);
        background-size: 200% 100%;
        border-radius: 8px;
        animation: shimmer 1.5s infinite;
    }
    
    .skeleton-symbol {
        width: 120px;
    }
    
    .skeleton-price {
        width: 150px;
        height: 50px;
    }
    
    .skeleton-decision {
        width: 100px;
    }
    
    .skeleton-confidence {
        width: 200px;
    }
    
    .skeleton-main-grid {
        display: grid;
        grid-template-columns: 65% 35%;
        gap: 16px;
        margin-top: 16px;
    }
    
    .skeleton-chart {
        height: 500px;
        background: rgba(22, 27, 34, 0.6);
        border-radius: 12px;
        background: linear-gradient(90deg, 
            rgba(48, 54, 61, 0.4) 25%, 
            rgba(48, 54, 61, 0.6) 50%, 
            rgba(48, 54, 61, 0.4) 75%);
        background-size: 200% 100%;
        animation: shimmer 1.5s infinite;
    }
    
    .skeleton-sidebar {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }
    
    .skeleton-card {
        height: 200px;
        background: rgba(22, 27, 34, 0.6);
        border-radius: 12px;
        background: linear-gradient(90deg, 
            rgba(48, 54, 61, 0.4) 25%, 
            rgba(48, 54, 61, 0.6) 50%, 
            rgba(48, 54, 61, 0.4) 75%);
        background-size: 200% 100%;
        animation: shimmer 1.5s infinite;
    }
    
    @@keyframes shimmer {
        0% {
            background-position: -200% 0;
        }
        100% {
            background-position: 200% 0;
        }
    }
    
    /* Empty State Hero Section */
    .empty-state-hero {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 60vh;
        padding: 40px 20px;
        text-align: center;
    }
    
    .hero-icon {
        font-size: 5rem;
        margin-bottom: 24px;
        animation: float 3s ease-in-out infinite;
    }
    
    @@keyframes float {
        0%, 100% {
            transform: translateY(0);
        }
        50% {
            transform: translateY(-20px);
        }
    }
    
    .hero-title {
        font-size: 2.5rem;
        font-weight: 700;
        color: #fff;
        margin-bottom: 16px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }
    
    .hero-subtitle {
        font-size: 1.1rem;
        color: #8b949e;
        margin-bottom: 40px;
        max-width: 600px;
    }
    
    .hero-features {
        display: flex;
        gap: 32px;
        flex-wrap: wrap;
        justify-content: center;
    }
    
    .feature-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        padding: 20px;
        background: rgba(22, 27, 34, 0.6);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(48, 54, 61, 0.5);
        border-radius: 12px;
        min-width: 150px;
        transition: all 0.3s ease;
    }
    
    .feature-item:hover {
        transform: translateY(-5px);
        border-color: rgba(88, 166, 255, 0.5);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
    }
    
    .feature-icon {
        font-size: 2rem;
    }
    
    .feature-item span:last-child {
        color: #c9d1d9;
        font-size: 0.9rem;
        font-weight: 500;
    }
    
    /* Decision Box Active State */
    .decision-box {
        cursor: pointer;
        transition: all 0.2s ease;
        user-select: none;
    }
    
    .decision-box:active {
        transform: scale(0.95);
    }
    
    /* Enhanced Tab Transitions */
    .tab-content {
        animation: fadeIn 0.3s ease-in-out;
    }
    
    /* Skeleton Loader Enhancements */
    .skeleton-item,
    .skeleton-chart,
    .skeleton-card {
        position: relative;
        overflow: hidden;
    }
    
    /* AI Skeleton Loader */
    .skeleton-ai-card {
        background: rgba(26, 26, 26, 0.7);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 16px;
        padding: 20px;
        margin-bottom: 12px;
    }
    
    .skeleton-ai-header {
        height: 20px;
        background: linear-gradient(90deg, 
            rgba(255, 255, 255, 0.1) 25%, 
            rgba(255, 255, 255, 0.2) 50%, 
            rgba(255, 255, 255, 0.1) 75%);
        background-size: 200% 100%;
        border-radius: 8px;
        margin-bottom: 12px;
        animation: shimmer 1.5s infinite;
        width: 60%;
    }
    
    .skeleton-ai-body {
        height: 14px;
        background: linear-gradient(90deg, 
            rgba(255, 255, 255, 0.08) 25%, 
            rgba(255, 255, 255, 0.15) 50%, 
            rgba(255, 255, 255, 0.08) 75%);
        background-size: 200% 100%;
        border-radius: 6px;
        margin-bottom: 8px;
        animation: shimmer 1.5s infinite;
        width: 100%;
    }
    
    .skeleton-ai-decision {
        opacity: 0.5;
        animation: pulse 1.5s infinite;
    }
    
    .skeleton-ai-confidence {
        background: linear-gradient(90deg, 
            rgba(255, 255, 255, 0.1) 25%, 
            rgba(255, 255, 255, 0.2) 50%, 
            rgba(255, 255, 255, 0.1) 75%);
        background-size: 200% 100%;
        animation: shimmer 1.5s infinite;
        width: 30% !important;
    }
    
    @@keyframes shimmer {
        0% {
            background-position: -200% 0;
        }
        100% {
            background-position: 200% 0;
        }
    }
    
    .skeleton-item::after,
    .skeleton-chart::after,
    .skeleton-card::after {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: linear-gradient(90deg, 
            transparent 0%, 
            rgba(255, 255, 255, 0.1) 50%, 
            transparent 100%);
        animation: shimmer-overlay 1.5s infinite;
    }
    
    @@keyframes shimmer-overlay {
        0% {
            transform: translateX(-100%);
        }
        100% {
            transform: translateX(100%);
        }
    }
    
    /* Input Focus Animations */
    .form-input:focus,
    input[type="text"]:focus,
    input[type="number"]:focus {
        transform: scale(1.02);
        box-shadow: 0 0 0 3px rgba(88, 166, 255, 0.2);
    }
    
    /* Confidence Bar Animation */
    .confidence-fill {
        transition: width 0.8s ease-out;
    }
    
    /* Chart Container Animation */
    .chart-container {
        background: rgba(26, 26, 26, 0.7);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 16px;
        padding: 20px;
        transition: all 0.3s ease;
        animation: slideInUp 0.4s ease-out;
    }
    
    .chart-container:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
    }
    
    @@keyframes slideInUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    
    /* Panel Hover Effects */
    .panel {
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        background: rgba(26, 26, 26, 0.7);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 16px;
        padding: 20px;
    }

    .panel:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
        border-color: rgba(255, 255, 255, 0.12);
    }
    
    /* Accordion Item Animation */
    .accordion-content {
        animation: slideDown 0.3s ease-out;
    }
    
    @@keyframes slideDown {
        from {
            opacity: 0;
            max-height: 0;
        }
        to {
            opacity: 1;
            max-height: 2000px;
        }
    }

    /* Scrollbar Styling */
    .strategy-section::-webkit-scrollbar {
        width: 6px;
    }

    .strategy-section::-webkit-scrollbar-track {
        background: rgba(13, 17, 23, 0.3);
        border-radius: 3px;
    }

    .strategy-section::-webkit-scrollbar-thumb {
        background: rgba(88, 166, 255, 0.5);
        border-radius: 3px;
    }

    .strategy-section::-webkit-scrollbar-thumb:hover {
        background: rgba(88, 166, 255, 0.7);
    }

    /* Responsive */
    @@media (max-width: 1200px) {
        .main-grid {
            grid-template-columns: 1fr;
            height: auto;
        }

        .chart-section {
            height: 400px;
        }

        .strategy-section {
            max-height: none;
        }

        .deep-dive-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 768px) {
        .dashboard-container {
            padding: 0;
        }
        
        .dashboard-header {
            padding: 12px 16px;
        }
        
        .tab-navigation {
            width: 100%;
            justify-content: space-around;
            padding: 6px;
        }
        
        .tab-btn {
            flex: 1;
            padding: 12px 16px;
            min-height: 44px;
            font-size: 0.85rem;
        }
        
        .ticker-tape {
            grid-template-columns: 1fr;
            gap: 16px;
            margin: 16px;
            padding: 20px;
        }

        .ticker-price {
            font-size: 3rem;
        }
        
        .ticker-symbol {
            font-size: 1.5rem;
        }
        
        .decision-value {
            font-size: 1.5rem;
        }

        .search-bar {
            flex-direction: column;
            gap: 12px;
            padding: 16px;
            position: sticky;
            bottom: 0;
            background: rgba(26, 26, 26, 0.95);
            backdrop-filter: blur(20px);
            border-top: 1px solid rgba(255, 255, 255, 0.08);
            z-index: 50;
        }
        
        .btn-analyze {
            width: 100%;
            padding: 18px;
            font-size: 1.1rem;
            min-height: 56px;
            position: sticky;
            bottom: 0;
            z-index: 51;
        }
        
        .main-grid {
            grid-template-columns: 1fr;
            gap: 16px;
            margin: 16px;
        }
        
        .deep-dive-grid {
            grid-template-columns: 1fr;
            gap: 16px;
            margin: 16px;
        }

        .quick-buttons {
            margin-left: 0;
            width: 100%;
            justify-content: center;
            gap: 8px;
        }
        
        .btn-quick {
            flex: 1;
            min-width: 0;
        }
    }
    
    /* Tab Navigation - Pill-Shaped Modern Design */
    .tab-navigation {
        display: flex;
        gap: 8px;
        padding: 8px;
        background: rgba(26, 26, 26, 0.6);
        backdrop-filter: blur(10px);
        border-radius: 50px;
        border: 1px solid rgba(255, 255, 255, 0.08);
        width: fit-content;
        margin: 12px auto 0;
    }
    
    .tab-btn {
        padding: 10px 24px;
        background: transparent;
        border: none;
        border-radius: 50px;
        color: rgba(255, 255, 255, 0.6);
        font-size: 0.9rem;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        min-height: 44px;
        display: flex;
