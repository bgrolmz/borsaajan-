                       class="flex-1 bg-[#0b1326] border border-[#3a4a3f]/20 text-[11px] px-3 py-2 rounded-lg text-[#dae2fd] placeholder-[#b9cbbd]/30 outline-none focus:border-[#00FFA3]/40 transition-colors"
                       @bind="sembol" @bind:event="oninput" @onkeydown="@(async e => { if (e.Key == "Enter") await AnalizEt(); })" />
                <button class="px-3 py-2 bg-[#00FFA3]/10 border border-[#00FFA3]/30 rounded-lg hover:bg-[#00FFA3]/20 transition-colors" @onclick="AnalizEt">
