            whyBullets = sentences.Any() ? sentences : new List<string> { analiz.Ana_Neden };
        }
        // Last resort: Ozel_Strateji_Detayi
        if (!whyBullets.Any() && analiz != null && !string.IsNullOrEmpty(analiz.Ozel_Strateji_Detayi))
            whyBullets.Add(analiz.Ozel_Strateji_Detayi.Length > 120 ? analiz.Ozel_Strateji_Detayi.Substring(0, 117) + "..." : analiz.Ozel_Strateji_Detayi);

        // ── 5. PLAN BULLETS ──────────────────────────────────────────────────
        var planBullets = new List<string>();
        // Priority: master_analysis.strategy.entry_plan_tr (already a list)
        if (ma?.Strategy?.EntryPlanTr?.Any(s => !string.IsNullOrWhiteSpace(s)) == true)
        {
            planBullets = ma.Strategy.EntryPlanTr
                .Where(s => !string.IsNullOrWhiteSpace(s))
                .Take(4)
                .ToList();
        }
        // Fallback: split Stratejik_Plan text
        if (!planBullets.Any() && analiz != null && !string.IsNullOrEmpty(analiz.Stratejik_Plan))
        {
            var planParts = analiz.Stratejik_Plan
                .Split(new[] { ". ", "! ", "? ", "\n", "•", "- " }, StringSplitOptions.RemoveEmptyEntries)
                .Where(s => s.Trim().Length > 5)
                .Take(3)
                .Select(s => s.Trim())
                .ToList();
            planBullets = planParts.Any() ? planParts : new List<string> {
                analiz.Stratejik_Plan.Length > 120 ? analiz.Stratejik_Plan.Substring(0, 117) + "..." : analiz.Stratejik_Plan
            };
        }
        // Last resort: Ozel_Strateji_Detayi
        if (!planBullets.Any() && analiz != null && !string.IsNullOrEmpty(analiz.Ozel_Strateji_Detayi))
            planBullets.Add(analiz.Ozel_Strateji_Detayi.Length > 120 ? analiz.Ozel_Strateji_Detayi.Substring(0, 117) + "..." : analiz.Ozel_Strateji_Detayi);

        // ── 6. IMMEDIATE ACTIONS ─────────────────────────────────────────────
        var immediateActions = new List<string>();
        foreach (var bullet in planBullets.Take(3))
        {
            var actionPhrases = bullet.Split(new[] { ",", " ve ", " veya " }, StringSplitOptions.RemoveEmptyEntries)
                .Where(s => s.Trim().Length > 10 &&
                    (s.Contains("pozisyon") || s.Contains("bekle") || s.Contains("azalt") ||
                     s.Contains("artır") || s.Contains("sat") || s.Contains("al") || s.Contains("stop")))
                .Take(1)
                .Select(s => s.Trim())
                .ToList();
            if (actionPhrases.Any())
                immediateActions.AddRange(actionPhrases);
            else if (bullet.Length < 80)
                immediateActions.Add(bullet);
        }
        if (!immediateActions.Any())
        {
            if (decision == "BUY") immediateActions.Add("Pozisyon aç veya mevcut pozisyonu artır");
            else if (decision == "REDUCE") immediateActions.Add("Pozisyonu azalt veya kısmi satış yap");
            else if (decision == "HOLD") immediateActions.Add("Mevcut pozisyonu koru, beklemeye devam et");
            else immediateActions.Add("Bu hisseye yatırım yapma, uzak dur");
        }

        // ── 7. MENTOR SCENARIO ───────────────────────────────────────────────
        string? mentorScenario = null;
        // Priority: master_analysis scenarios
        if (!string.IsNullOrWhiteSpace(ma?.BullCaseThesis) &&
            !string.IsNullOrWhiteSpace(ma?.BearCaseThesis))
        {
            mentorScenario = $"Yükseliş: {ma.BullCaseThesis} " +
                             $"Düşüş: {ma.BearCaseThesis}";
        }
        else if (analiz != null && !string.IsNullOrEmpty(analiz.Stratejik_Plan))
        {
            var sentences = analiz.Stratejik_Plan
                .Split(new[] { '.', '!', '?' }, StringSplitOptions.RemoveEmptyEntries)
                .Where(s => s.Trim().Length > 20 && (s.Contains("eğer") || s.Contains("if") || s.Contains("ise")))
                .Take(2)
                .Select(s => s.Trim())
                .ToList();
            if (sentences.Count >= 2)
                mentorScenario = $"{sentences[0]}. {sentences[1]}.";
            else if (sentences.Count == 1)
                mentorScenario = sentences[0] + ".";
        }
        if (string.IsNullOrEmpty(mentorScenario))
        {
            if (decision == "BUY")
                mentorScenario = "Eğer fiyat destek seviyesinde kalırsa, pozisyon aç. Eğer fiyat yükselişe geçerse, momentum devam edene kadar tut.";
            else if (decision == "REDUCE")
                mentorScenario = "Eğer fiyat direnç seviyesine yaklaşırsa, kısmi satış yap. Eğer trend tersine dönerse, pozisyonu daha da azalt.";
            else if (decision == "HOLD")
                mentorScenario = "Eğer mevcut trend devam ederse, pozisyonu koru. Eğer belirsizlik artarsa, daha fazla veri bekle.";
            else
                mentorScenario = "Eğer risk seviyesi yüksek kalırsa, bu hisseye yatırım yapma. Eğer koşullar değişirse, yeniden değerlendir.";
        }

        // ── 8. RISK LEVEL & NOTE ─────────────────────────────────────────────
        string riskLevel = "MED";
        string? riskNote = null;

        // Priority: master_analysis.fundamental_analysis.risks_tr
        if (ma?.FundamentalAnalysis?.RisksTr?.Any(s => !string.IsNullOrWhiteSpace(s)) == true)
        {
            riskNote = ma.FundamentalAnalysis.RisksTr
                .First(s => !string.IsNullOrWhiteSpace(s));
        }
        else if (analiz != null && !string.IsNullOrEmpty(analiz.Risk_Uyarisi))
        {
            var riskText = analiz.Risk_Uyarisi.ToUpper();
            if (riskText.Contains("YÜKSEK") || riskText.Contains("HIGH") || riskText.Contains("FAZLA"))
                riskLevel = "HIGH";
            else if (riskText.Contains("DÜŞÜK") || riskText.Contains("LOW") || riskText.Contains("AZ"))
                riskLevel = "LOW";

            var riskSentence = analiz.Risk_Uyarisi
                .Split(new[] { '.', '!', '?' }, StringSplitOptions.RemoveEmptyEntries)
                .Where(s => s.Trim().Length > 15)
                .Select(s => s.Trim() + ".")
                .FirstOrDefault();
            riskNote = riskSentence ?? (analiz.Risk_Uyarisi.Length > 120 ? analiz.Risk_Uyarisi.Substring(0, 117) + "..." : analiz.Risk_Uyarisi);
        }

        // Infer risk level from confidence if not set from text
        if (riskLevel == "MED")
        {
            if (confidence < 40 || tech?.Rsi > 70 || tech?.Rsi < 30) riskLevel = "HIGH";
            else if (confidence > 70 && tech?.Rsi > 40 && tech?.Rsi < 60) riskLevel = "LOW";
        }

        if (string.IsNullOrEmpty(riskNote))
        {
            if (riskLevel == "HIGH") riskNote = "En kötü senaryoda %15-20 kayıp riski var.";
            else if (riskLevel == "MED") riskNote = "En kötü senaryoda %8-12 kayıp riski var.";
            else riskNote = "En kötü senaryoda %3-5 kayıp riski var.";
        }

        // ── 9. STOP-LOSS / TAKE-PROFIT LEVELS ───────────────────────────────
        string? stopLossStr = analiz?.Stop_Loss;
        string? takeProfitStr = null;
        if (ma?.Strategy?.RiskManagementTr != null)
        {
            var rm = ma.Strategy.RiskManagementTr;
            if (rm.StopLoss != null)
                stopLossStr = $"${rm.StopLoss}";
            if (rm.TakeProfit?.Any() == true)
                takeProfitStr = string.Join(" / ", rm.TakeProfit.Take(2).Select(t => $"${t:F2}"));
        }

        var levels = new MentorLevelsModel
        {
            Entry = currentPrice > 0 ? $"${currentPrice:F2}" : null,
            StopLoss = stopLossStr,
            TakeProfit = takeProfitStr
        };

        return new MentorDecisionModel
        {
            Decision = decision,
            Confidence = confidence,
            Horizon = "1-2 weeks",
            OneLinerTr = oneLiner,
            WhyBulletsTr = whyBullets.Any() ? whyBullets : null,
            PlanBulletsTr = planBullets.Any() ? planBullets : null,
            ImmediateActions = immediateActions.Any() ? immediateActions.Take(3).ToList() : null,
            MentorScenario = mentorScenario,
            RiskLevel = riskLevel,
            RiskNoteTr = riskNote,
            Levels = levels
        };
    }
    
