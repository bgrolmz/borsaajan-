    private async void RemoveFromWatchlist(string symbol)
    {
        // ARCHITECT FIX: Always remove from UI first, then try backend
        // This ensures user can always clean up invalid/typo symbols
        var removedLocally = watchlistItems.RemoveAll(x => x.Symbol.Equals(symbol, StringComparison.OrdinalIgnoreCase)) > 0;
        
        if (removedLocally)
        {
            StateHasChanged();
            Console.WriteLine($"🗑️ Removed {symbol} from UI");
        }
        
        try
        {
            var client = HttpClientFactory.CreateClient("BackendApi");
            
            // Use the new shorter DELETE endpoint (accepts any symbol including typos)
            var response = await client.DeleteAsync($"/watchlist/{Uri.EscapeDataString(symbol)}");
            
            if (response.IsSuccessStatusCode)
            {
                Console.WriteLine($"✅ Removed {symbol} from backend watchlist");
            }
            else
            {
                // Even if backend fails, symbol is already removed from UI
                Console.WriteLine($"⚠️ Backend removal returned {response.StatusCode} for {symbol} (UI already cleaned)");
            }
        }
        catch (Exception ex)
        {
            // Non-fatal: symbol already removed from UI
            Console.WriteLine($"⚠️ Backend error for {symbol}: {ex.Message} (UI already cleaned)");
        }
    }
    
