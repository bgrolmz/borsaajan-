                                    <div class="col-span-2 text-right">
                                        <span class="text-xs font-bold text-[#00e290]">@item.Confidence%</span>
                                    </div>
                                    <div class="col-span-3 text-right text-xs font-semibold text-[#dae2fd]">$@FormatFiyat(item.Price)</div>
                                </div>
                            }
                        </div>

                        @if (selectedHistoryItem != null)
                        {
                            <div class="p-5 bg-[#131b2e] rounded-xl border border-[#3a4a3f]/10 space-y-4">
                                <div class="flex items-center justify-between">
                                    <h3 class="font-['Manrope'] font-bold text-[#dae2fd]">@selectedHistoryItem.Symbol — Detaylar</h3>
                                    <button class="text-[#b9cbbd]/40 hover:text-[#b9cbbd] transition-colors" @onclick="() => { selectedHistoryItem = null; StateHasChanged(); }">
                                        <span class="material-symbols-outlined text-sm">close</span>
