            Console.WriteLine($"[UI] Response status: {response.StatusCode}");
            
            var json = await response.Content.ReadAsStringAsync();
            Console.WriteLine($"[UI] Response JSON length: {json.Length} chars");
            Console.WriteLine($"[UI] Response JSON (first 500 chars): {json.Substring(0, Math.Min(500, json.Length))}");
            
            if (response.IsSuccessStatusCode)
            {
                try
                {
                    var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
                    var result = JsonSerializer.Deserialize<Dictionary<string, JsonElement>>(json, options);
                    
                    if (result != null)
                    {
                        Console.WriteLine($"[UI] Parsed result keys: {string.Join(", ", result.Keys)}");
                        portfolioAnalysis = result;
                        
                        // Check for success field
                        bool isSuccess = result.TryGetValue("success", out var success) && 
                                         success.ValueKind == System.Text.Json.JsonValueKind.True;
                        
                        Console.WriteLine($"[UI] Success flag: {isSuccess}");
                        
                        if (isSuccess)
                        {
                            // Extract portfolio summary from new structure
                            if (result.TryGetValue("portfolio", out var portfolio) && 
                                portfolio.ValueKind == System.Text.Json.JsonValueKind.Object)
                            {
                                if (portfolio.TryGetProperty("total_value", out var tv) && tv.ValueKind == System.Text.Json.JsonValueKind.Number)
                                    totalValue = tv.GetDouble();
                                if (portfolio.TryGetProperty("total_cost", out var tc) && tc.ValueKind == System.Text.Json.JsonValueKind.Number)
                                    totalCost = tc.GetDouble();
                                if (portfolio.TryGetProperty("total_pnl", out var pnl) && pnl.ValueKind == System.Text.Json.JsonValueKind.Number)
                                    totalPnL = pnl.GetDouble();
                                if (portfolio.TryGetProperty("total_pnl_percent", out var pnlPct) && pnlPct.ValueKind == System.Text.Json.JsonValueKind.Number)
                                    totalPnLPercent = pnlPct.GetDouble();
                            }
                            else
                            {
                                // Fallback to old structure (backward compatibility)
                                if (result.TryGetValue("total_value", out var tv))
                                    totalValue = tv.GetDouble();
                                if (result.TryGetValue("total_cost", out var tc))
                                    totalCost = tc.GetDouble();
                                if (result.TryGetValue("total_pnl", out var pnl))
                                    totalPnL = pnl.GetDouble();
                                if (result.TryGetValue("total_pnl_percent", out var pnlPct))
                                    totalPnLPercent = pnlPct.GetDouble();
                            }
                            
                            // Update chat context
                            ContextService.SetPortfolioContext(
                                totalValue: totalValue,
                                totalPnl: totalPnL,
                                holdingsCount: portfolioItems.Count
                            );
                        }
                        else
                        {
                            // Error case - result will be displayed in UI
                            string errorMsg = result.TryGetValue("message", out var msg) && msg.ValueKind == System.Text.Json.JsonValueKind.String 
                                ? msg.GetString() ?? "Unknown error" 
                                : "Unknown error";
                            Console.WriteLine($"[UI] Portfolio analysis failed: {errorMsg}");
                        }
                    }
                    else
                    {
                        Console.WriteLine("[UI] Failed to parse JSON - result is null");
                        portfolioAnalysis = new Dictionary<string, JsonElement>
                        {
                            ["success"] = JsonSerializer.SerializeToElement(false),
                            ["message"] = JsonSerializer.SerializeToElement("JSON parse hatası: Sonuç null döndü")
                        };
                    }
                }
                catch (JsonException jsonEx)
                {
                    Console.WriteLine($"[UI] JSON parse error: {jsonEx.Message}");
                    portfolioAnalysis = new Dictionary<string, JsonElement>
                    {
                        ["success"] = JsonSerializer.SerializeToElement(false),
                        ["message"] = JsonSerializer.SerializeToElement($"JSON parse hatası: {jsonEx.Message}")
                    };
                }
            }
            else
            {
                // HTTP error
                Console.WriteLine($"[UI] HTTP error: {response.StatusCode} - {response.ReasonPhrase}");
                portfolioAnalysis = new Dictionary<string, JsonElement>
                {
                    ["success"] = JsonSerializer.SerializeToElement(false),
                    ["message"] = JsonSerializer.SerializeToElement($"HTTP {response.StatusCode}: {response.ReasonPhrase}")
                };
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[UI] Exception in AnalyzePortfolio: {ex.Message}");
            Console.WriteLine($"[UI] Stack trace: {ex.StackTrace}");
            portfolioAnalysis = new Dictionary<string, JsonElement>
            {
                ["success"] = JsonSerializer.SerializeToElement(false),
                ["message"] = JsonSerializer.SerializeToElement($"Hata: {ex.Message}")
            };
        }
        finally
        {
            isAnalyzing = false;
            StateHasChanged(); // Trigger UI update
        }
    }
    
    private async Task RunBacktest()
    {
        isBacktesting = true;
        try
        {
            var client = HttpClientFactory.CreateClient("BackendApi");
            var response = await client.GetAsync("/portfolio/backtest");
            
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                backtestResult = JsonSerializer.Deserialize<Dictionary<string, JsonElement>>(json);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error running backtest: {ex.Message}");
        }
        finally
        {
            isBacktesting = false;
        }
    }
    
    private async Task WatchWhales()
    {
        isWatching = true;
        try
        {
            var client = HttpClientFactory.CreateClient("BackendApi");
            var response = await client.GetAsync("/portfolio/whale-watch");
            
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                whaleData = JsonSerializer.Deserialize<Dictionary<string, JsonElement>>(json);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error watching whales: {ex.Message}");
        }
        finally
        {
            isWatching = false;
        }
    }
    
    private string FormatNumber(long number)
    {
        if (number >= 1_000_000_000)
            return $"{(number / 1_000_000_000.0):F2}B";
        else if (number >= 1_000_000)
            return $"{(number / 1_000_000.0):F2}M";
        else if (number >= 1_000)
            return $"{(number / 1_000.0):F2}K";
        else
            return number.ToString("N0");
    }
    
    private string FormatCurrency(double value)
    {
        if (value >= 1_000_000_000)
            return $"${(value / 1_000_000_000.0):F2}B";
        else if (value >= 1_000_000)
            return $"${(value / 1_000_000.0):F2}M";
        else if (value >= 1_000)
            return $"${(value / 1_000.0):F2}K";
        else
            return $"${value:N2}";
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("destroyChart");
        }
        catch { }
    }
