    private string FormatFiyat(double fiyat)
    {
        if (fiyat == 0) return "0";

        if (fiyat < 0.01)
        {
            return fiyat.ToString("F6", System.Globalization.CultureInfo.InvariantCulture).TrimEnd('0').TrimEnd('.');
        }
        else if (fiyat < 1)
        {
            return fiyat.ToString("F4", System.Globalization.CultureInfo.InvariantCulture).TrimEnd('0').TrimEnd('.');
        }
        else
        {
            return fiyat.ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
        }
    }

    private async Task RenderChart()
    {
        if (veri?.Grafik_Verileri == null || veri.Grafik_Verileri.Count == 0)
        {
            Console.WriteLine("RenderChart: No chart data available");
            return;
        }

        try
        {
            var elementExists = await JSRuntime.InvokeAsync<bool>("checkElementExists", "candlestick-chart");
            if (!elementExists)
            {
                Console.WriteLine("RenderChart: Chart element not found in DOM, waiting...");
                for (int i = 0; i < 5; i++)
                {
                    await Task.Delay(300);
                    elementExists = await JSRuntime.InvokeAsync<bool>("checkElementExists", "candlestick-chart");
                    if (elementExists) break;
                }
                if (!elementExists)
                {
                    Console.WriteLine("RenderChart: Chart element still not found after retries");
                    return;
                }
            }

            var apexChartsLoaded = await JSRuntime.InvokeAsync<bool>("checkApexChartsLoaded");
            if (!apexChartsLoaded)
            {
                Console.WriteLine("RenderChart: ApexCharts not loaded, waiting...");
                for (int i = 0; i < 5; i++)
                {
                    await Task.Delay(500);
                    apexChartsLoaded = await JSRuntime.InvokeAsync<bool>("checkApexChartsLoaded");
                    if (apexChartsLoaded) break;
                }
                if (!apexChartsLoaded)
                {
                    Console.WriteLine("RenderChart: ApexCharts still not loaded");
                    hataMesaji = "ApexCharts kütüphanesi yüklenemedi. İnternet bağlantınızı kontrol edin.";
                    return;
                }
            }

            // Filter data by chartPeriod
            var cutoff = chartPeriod switch
            {
                "1d"  => DateTime.UtcNow.AddDays(-1),
                "5d"  => DateTime.UtcNow.AddDays(-5),
                "1mo" => DateTime.UtcNow.AddMonths(-1),
                _     => DateTime.UtcNow.AddMonths(-6)   // "6mo" default
            };

            // Build chart data as JSON string for reliable serialization
            var chartDataList = new List<Dictionary<string, object>>();
            foreach (var v in veri.Grafik_Verileri.Where(v => !string.IsNullOrEmpty(v.Date)))
            {
                if (DateTime.TryParse(v.Date, out var date))
                {
                    if (date.ToUniversalTime() < cutoff) continue;
                    var timestamp = ((DateTimeOffset)date).ToUnixTimeMilliseconds();
                    chartDataList.Add(new Dictionary<string, object>
                    {
                        ["x"] = timestamp,
                        ["y"] = new[] { (double)v.Open, (double)v.High, (double)v.Low, (double)v.Close }
                    });
                }
            }

            Console.WriteLine($"RenderChart: Rendering {chartDataList.Count} data points");
            
            // Serialize to JSON and use JSON method
            var chartDataJson = System.Text.Json.JsonSerializer.Serialize(chartDataList);
            Console.WriteLine($"Chart data JSON length: {chartDataJson.Length}");
            
            // Use JSON method which is more reliable
            await JSRuntime.InvokeVoidAsync("renderCandlestickChartFromJson", chartDataJson, sembol ?? "STOCK");
            Console.WriteLine("RenderChart: Chart rendered successfully");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Chart render error: {ex.Message}");
            Console.WriteLine($"Stack trace: {ex.StackTrace}");
            hataMesaji = $"Grafik hatası: {ex.Message}";
        }
    }

