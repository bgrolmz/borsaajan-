    private async Task LoadHistory()
    {
        isLoadingHistory = true;
        historyItems.Clear();
        portfolioHistoryItems.Clear();
        selectedHistoryItem = null;
        selectedPortfolioHistoryItem = null;
        StateHasChanged();
        
        try
        {
            var client = HttpClientFactory.CreateClient("BackendApi");
            
            // Load stock analysis history
            var stockResponse = await client.GetAsync("/history/all");
            if (stockResponse.IsSuccessStatusCode)
            {
                var json = await stockResponse.Content.ReadAsStringAsync();
                var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
                var data = JsonSerializer.Deserialize<JsonElement>(json, options);
                
                if (data.TryGetProperty("history", out var historyArray))
                {
                    foreach (var item in historyArray.EnumerateArray())
                    {
                        historyItems.Add(new HistoryItem
                        {
                            Id = item.TryGetProperty("id", out var idProp) ? idProp.GetInt32() : 0,
                            Symbol = item.TryGetProperty("symbol", out var symProp) ? symProp.GetString() ?? "" : "",
                            Date = item.TryGetProperty("date", out var dateProp) ? dateProp.GetString() ?? "" : "",
                            Decision = item.TryGetProperty("ai_decision", out var decProp) ? decProp.GetString() ?? "" : "",
                            Price = item.TryGetProperty("price_at_analysis", out var priceProp) ? priceProp.GetDouble() : 0,
                            Reasoning = item.TryGetProperty("ai_reasoning", out var reasonProp) ? reasonProp.GetString() ?? "" : "",
                            Confidence = item.TryGetProperty("confidence_score", out var confProp) ? confProp.GetString() ?? "" : ""
                        });
                    }
                }
            }
            
            // Load portfolio analysis history
            var portfolioResponse = await client.GetAsync("/portfolio/analysis/history?limit=50");
            if (portfolioResponse.IsSuccessStatusCode)
            {
                var json = await portfolioResponse.Content.ReadAsStringAsync();
                var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
                var data = JsonSerializer.Deserialize<JsonElement>(json, options);
                
                if (data.TryGetProperty("history", out var portfolioArray))
                {
                    foreach (var item in portfolioArray.EnumerateArray())
                    {
                        var fullJson = item.TryGetProperty("full_json", out var fj) && fj.ValueKind == System.Text.Json.JsonValueKind.Object 
                            ? JsonSerializer.Deserialize<Dictionary<string, JsonElement>>(fj.GetRawText(), options) 
                            : null;
                        
                        var portfolio = fullJson?.TryGetValue("portfolio", out var p) == true && p.ValueKind == System.Text.Json.JsonValueKind.Object ? p : default;
                        var mode = fullJson?.TryGetValue("mode", out var m) == true && m.ValueKind == System.Text.Json.JsonValueKind.String ? m.GetString() ?? "quick" : "quick";
                        var asOf = fullJson?.TryGetValue("as_of", out var ao) == true && ao.ValueKind == System.Text.Json.JsonValueKind.String ? ao.GetString() ?? "" : "";
                        
                        portfolioHistoryItems.Add(new PortfolioHistoryItem
                        {
                            Id = item.TryGetProperty("id", out var idProp) ? idProp.GetInt32() : 0,
                            Date = asOf != "" ? asOf : (item.TryGetProperty("created_at", out var ca) ? ca.GetString() ?? "" : ""),
                            Mode = mode ?? "quick",
                            Summary = item.TryGetProperty("summary", out var sumProp) ? sumProp.GetString() ?? "" : "",
                            TotalValue = portfolio.ValueKind == System.Text.Json.JsonValueKind.Object && portfolio.TryGetProperty("total_value", out var tv) && tv.ValueKind == System.Text.Json.JsonValueKind.Number ? tv.GetDouble() : 0,
                            TotalPnL = portfolio.ValueKind == System.Text.Json.JsonValueKind.Object && portfolio.TryGetProperty("total_pnl", out var tp) && tp.ValueKind == System.Text.Json.JsonValueKind.Number ? tp.GetDouble() : 0,
                            HoldingsCount = portfolio.ValueKind == System.Text.Json.JsonValueKind.Object && portfolio.TryGetProperty("holdings_count", out var hc) && hc.ValueKind == System.Text.Json.JsonValueKind.Number ? hc.GetInt32() : 0,
                            FullData = fullJson
                        });
                    }
                }
            }
        }
        catch (Exception ex)
        {
            hataMesaji = $"Geçmiş yüklenirken hata: {ex.Message}";
        }
        finally
        {
            isLoadingHistory = false;
            StateHasChanged();
        }
    }
    
