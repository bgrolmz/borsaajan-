    // Watchlist Methods
    private async Task LoadWatchlist()
    {
        isLoadingWatchlist = true;
        StateHasChanged();
        
        try
        {
            var client = HttpClientFactory.CreateClient("BackendApi");
            
            // Call the real-time watchlist sync endpoint (fetches from database if symbols not provided)
            var response = await client.PostAsJsonAsync("/api/watchlist/sync", (object?)null);
            
            if (response.IsSuccessStatusCode)
            {
                var json = await response.Content.ReadAsStringAsync();
                var result = JsonSerializer.Deserialize<JsonElement>(json);
                
                if (result.TryGetProperty("success", out var success) && success.GetBoolean())
                {
                    if (result.TryGetProperty("data", out var dataArray))
                    {
                        watchlistItems.Clear();
                        
                        foreach (var item in dataArray.EnumerateArray())
                        {
                            var symbol = item.TryGetProperty("symbol", out var sym) ? sym.GetString() ?? "" : "";
                            var price = item.TryGetProperty("price", out var p) ? p.GetDouble() : 0.0;
                            var changePercent = item.TryGetProperty("change_percent", out var cp) ? cp.GetDouble() : 0.0;
                            var sentiment = item.TryGetProperty("sentiment", out var sent) ? sent.GetString() ?? "neutral" : "neutral";
                            
                            watchlistItems.Add(new WatchlistItem
                            {
                                Symbol = symbol,
                                Price = price,
                                Change = changePercent,
                                Sentiment = sentiment.ToLower()
                            });
                        }
                        
                        Console.WriteLine($"✅ Loaded {watchlistItems.Count} real-time watchlist items");
                    }
                }
            }
            else
            {
                Console.WriteLine($"⚠️ Watchlist API returned: {response.StatusCode}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"❌ Error loading watchlist: {ex.Message}");
            // Fallback to empty list instead of mock data
            watchlistItems.Clear();
        }
        finally
        {
            isLoadingWatchlist = false;
            RecalcPortfolioTotals();
            StateHasChanged();
        }
    }

    private void RecalcPortfolioTotals()
    {
        totalCost = portfolioItems.Sum(p => p.Quantity * p.AvgCost);
        totalValue = portfolioItems.Sum(p => {
            var w = watchlistItems.FirstOrDefault(w => w.Symbol == p.Symbol);
            return w != null && w.Price > 0 ? p.Quantity * w.Price : p.Quantity * p.AvgCost;
        });
        totalPnL = totalValue - totalCost;
        totalPnLPercent = totalCost > 0 ? (totalPnL / totalCost) * 100 : 0;
    }

    private async Task LoadRecentNews()
    {
        try
        {
            var client = HttpClientFactory.CreateClient("BackendApi");
            var response = await client.GetAsync("/news/history/all?limit=20");
            if (!response.IsSuccessStatusCode) { LoadSampleNews(); return; }
            var json = await response.Content.ReadAsStringAsync();
            var data = JsonSerializer.Deserialize<JsonElement>(json);
            if (!data.TryGetProperty("history", out var histArray) || histArray.GetArrayLength() == 0)
            {
                LoadSampleNews();
                return;
            }
            var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            newsItems.Clear();
            foreach (var item in histArray.EnumerateArray())
            {
                var impactRaw = item.TryGetProperty("impact", out var imp) ? imp.GetString() ?? "" : "";
                var impactUpper = impactRaw.ToUpper();
                string impact = impactUpper switch
                {
                    "POSITIVE" or "BULLISH" => "HIGH",
                    "NEGATIVE" or "BEARISH" => "MEDIUM",
                    _ => "LOW"
                };
                string sentiment = impactUpper switch
                {
                    "POSITIVE" or "BULLISH" => "bullish",
                    "NEGATIVE" or "BEARISH" => "bearish",
                    _ => "neutral"
                };
                var sym = item.TryGetProperty("symbol", out var symEl) ? symEl.GetString() ?? "" : "";
                newsItems.Add(new NewsItem
                {
                    Id = item.TryGetProperty("id", out var nid) ? nid.GetInt32() : 0,
                    Title = item.TryGetProperty("title", out var title) ? title.GetString() ?? sym : sym,
                    Reason = item.TryGetProperty("reason", out var reason) ? reason.GetString() ?? "" : "",
                    WhyAnalysis = item.TryGetProperty("comment", out var cmt) ? cmt.GetString() ?? "" : "",
                    Summary = item.TryGetProperty("advice", out var adv) ? adv.GetString() ?? "" : "",
                    Impact = impact,
                    Sentiment = sentiment,
                    Confidence = item.TryGetProperty("confidence", out var conf) && conf.ValueKind == JsonValueKind.Number ? conf.GetInt32() : 70,
                    Symbols = !string.IsNullOrEmpty(sym) ? new List<string> { sym } : new List<string>(),
                    Timestamp = item.TryGetProperty("created_at", out var ts) && DateTime.TryParse(ts.GetString(), out var dt) ? dt : DateTime.Now.AddMinutes(-60)
                });
            }
            StateHasChanged();
        }
        catch
        {
            LoadSampleNews();
        }
    }

