                                var isSell = item.Decision.Contains("SAT") || item.Decision.Contains("SHORT") || item.Decision.Contains("SELL");
                                var verdictBg = isBuy ? "bg-[#00FFA3] text-[#003920]" : isSell ? "bg-[#ff4d4d]/20 text-[#ffb4ab]" : "bg-[#3a4a3f]/30 text-[#b9cbbd]";
                                var isSelected = selectedHistoryItem?.Id == item.Id;
                                <div class="grid grid-cols-12 px-5 py-3.5 border-b border-[#3a4a3f]/10 last:border-0 cursor-pointer hover:bg-[#2d3449]/30 transition-colors @(isSelected ? "bg-[#2d3449]/50 border-l-2 border-l-[#00FFA3]" : "")" @onclick="() => SelectHistoryItem(item)">
                                    <div class="col-span-2">
                                        <span class="text-sm font-black text-[#00FFA3] tracking-tight">@item.Symbol</span>
