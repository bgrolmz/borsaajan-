@page "/"
@rendermode @(RenderMode.InteractiveServer)
@using System.Text.Json
@using BorsaAjani_Web.Models
@using System.Globalization
@using System.Linq
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using System
@using BorsaAjani_Web.Services
@inject IJSRuntime JSRuntime
@inject IHttpClientFactory HttpClientFactory
@inject ChatContextService ContextService
@implements IAsyncDisposable

@* ═══════════════════════════════════════════════════════════
   OBSIDIAN TERMINAL — Alpha Terminal UI (SCREEN_10)
   ═══════════════════════════════════════════════════════════ *@

@* ── TOP HEADER ── *@
<header class="fixed top-0 w-full z-50 flex items-center justify-between px-6 h-14 bg-[#0b1326] font-['Manrope'] antialiased tracking-tight border-b border-[#2d3449]/50">
    <div class="flex items-center gap-8">
        @if (veri != null)
        {
            <span class="text-xl font-bold text-[#dae2fd] tracking-tighter">
                @(veri.Sembol ?? sembol.ToUpper()) $@FormatFiyat(veri.Fiyat_Bilgisi?.Current_Price ?? veri.Fiyat_Bilgisi?.Fiyat ?? 0)
            </span>
        }
        else
        {
            <span class="text-xl font-bold text-[#dae2fd] tracking-tighter">Alpha Terminal</span>
        }
        @* Navigasyon sol sidebar'da — burada sadece mod göstergesi *@
        <div class="hidden md:flex items-center gap-2">
            <span class="px-3 py-1 bg-[#131b2e] text-[#00FFA3] text-[10px] font-black rounded border border-[#00FFA3]/20 tracking-widest uppercase">@activeTab</span>
        </div>
    </div>
    <div class="flex items-center gap-3">
        <input @bind="sembol" @bind:event="oninput"
               class="bg-[#131b2e] border-none text-xs px-4 py-2 w-44 rounded focus:ring-1 focus:ring-[#00FFA3] text-[#dae2fd] placeholder-[#b9cbbd]/50 outline-none transition-all"
               placeholder="@(mod == "STOCK" ? "Hisse ara... NVDA" : "Kripto ara... BTC")" />
        @if (mod == "STOCK")
        {
            <input @bind="maliyet" type="number" step="any"
                   class="bg-[#131b2e] border-none text-xs px-4 py-2 w-28 rounded focus:ring-1 focus:ring-[#00FFA3] text-[#dae2fd] placeholder-[#b9cbbd]/50 outline-none transition-all"
                   placeholder="Maliyet $" />
        }
        <select @bind="detailLevel" class="bg-[#131b2e] text-[#b9cbbd] text-xs px-3 py-2 rounded outline-none border-none">
            <option value="short">Short</option>
            <option value="medium">Medium</option>
            <option value="full">Full</option>
        </select>
        <label class="flex items-center gap-2 text-xs text-[#b9cbbd] cursor-pointer">
            <input type="checkbox" @bind="useLLM" class="accent-[#00FFA3]" />
            LLM
        </label>
        <button @onclick="AnalizEt" disabled="@yukleniyor"
                class="px-5 py-2 bg-[#00FFA3] text-[#003920] text-xs font-black rounded tracking-wider hover:brightness-110 active:scale-95 transition-all disabled:opacity-50">
            @(yukleniyor ? "ANALİZ..." : "BAŞLAT")
        </button>
        @if (mod == "STOCK")
        {
            <button class="px-3 py-2 text-xs text-[#b9cbbd] bg-[#131b2e] rounded hover:bg-[#2d3449] transition-colors" @onclick="HizliSecimNVDA">NVDA</button>
            <button class="px-3 py-2 text-xs text-[#b9cbbd] bg-[#131b2e] rounded hover:bg-[#2d3449] transition-colors" @onclick="HizliSecimTSLA">TSLA</button>
            <button class="px-3 py-2 text-xs text-[#b9cbbd] bg-[#131b2e] rounded hover:bg-[#2d3449] transition-colors" @onclick="HizliSecimAAPL">AAPL</button>
        }
        else
        {
            <button class="px-3 py-2 text-xs text-[#b9cbbd] bg-[#131b2e] rounded hover:bg-[#2d3449] transition-colors" @onclick="HizliSecimBTC">BTC</button>
            <button class="px-3 py-2 text-xs text-[#b9cbbd] bg-[#131b2e] rounded hover:bg-[#2d3449] transition-colors" @onclick="HizliSecimETH">ETH</button>
            <button class="px-3 py-2 text-xs text-[#b9cbbd] bg-[#131b2e] rounded hover:bg-[#2d3449] transition-colors" @onclick="HizliSecimSOL">SOL</button>
        }
    </div>
</header>

@* ── HATA MESAJI ── *@
@if (!string.IsNullOrEmpty(hataMesaji))
{
    <div class="fixed top-14 left-64 right-80 z-40 px-6 py-3 bg-[#93000a]/80 text-[#ffb4ab] text-xs font-semibold border-b border-[#ff4d4d]/30">
        ⚠️ @hataMesaji
    </div>
}

@* ── LAYOUT SHELL ── *@
<div class="flex pt-14 h-screen bg-[#0b1326] overflow-hidden">

    @* ── LEFT SIDEBAR ── *@
    <aside class="fixed left-0 top-14 h-[calc(100vh-3.5rem)] w-64 bg-[#171f33] flex flex-col py-6 space-y-4 z-40">
        <div class="px-6 mb-4">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-lg bg-[#2d3449] flex items-center justify-center border border-[#3a4a3f]/20">
                    <span class="material-symbols-outlined text-[#00e290]">monitoring</span>
                </div>
                <div>
                    <h2 class="text-[#00FFA3] font-black tracking-widest text-xs uppercase">Alpha Terminal</h2>
                    <p class="text-[10px] text-[#b9cbbd] font-medium">PRO TIER ACTIVE</p>
                </div>
            </div>
        </div>
        <nav class="flex-1 px-3 space-y-1">
            <button class="@(activeTab == "Borsa" ? "bg-[#2d3449] text-[#00FFA3] border-r-4 border-[#00FFA3]" : "text-[#b9cbbd] hover:bg-[#131b2e]") flex items-center gap-3 w-full px-4 py-3 transition-all duration-300 text-left" @onclick="SwitchTabBorsa">
                <span class="material-symbols-outlined text-xl">monitoring</span>
                <span class="text-sm font-medium">Borsa</span>
            </button>
            <button class="@(activeTab == "Kripto" ? "bg-[#2d3449] text-[#00FFA3] border-r-4 border-[#00FFA3]" : "text-[#b9cbbd] hover:bg-[#131b2e]") flex items-center gap-3 w-full px-4 py-3 transition-all duration-300 text-left" @onclick="SwitchTabKripto">
                <span class="material-symbols-outlined text-xl">currency_bitcoin</span>
                <span class="text-sm font-medium">Kripto</span>
            </button>
            <button class="@(activeTab == "Portföy" ? "bg-[#2d3449] text-[#00FFA3] border-r-4 border-[#00FFA3]" : "text-[#b9cbbd] hover:bg-[#131b2e]") flex items-center gap-3 w-full px-4 py-3 transition-all duration-300 text-left" @onclick="SwitchTabPortfoy">
                <span class="material-symbols-outlined text-xl">account_balance_wallet</span>
                <span class="text-sm font-medium">Portföy</span>
            </button>
            <button class="@(activeTab == "Geçmiş" ? "bg-[#2d3449] text-[#00FFA3] border-r-4 border-[#00FFA3]" : "text-[#b9cbbd] hover:bg-[#131b2e]") flex items-center gap-3 w-full px-4 py-3 transition-all duration-300 text-left" @onclick="SwitchTabGecmis">
                <span class="material-symbols-outlined text-xl">query_stats</span>
                <span class="text-sm font-medium">Geçmiş</span>
            </button>
            <a href="/hisse-analizi" class="text-[#00FFA3]/70 hover:text-[#00FFA3] hover:bg-[#131b2e] flex items-center gap-3 w-full px-4 py-3 transition-all duration-300 text-left border border-[#00FFA3]/20 rounded-lg mt-2">
                <span class="material-symbols-outlined text-xl">auto_awesome</span>
                <span class="text-sm font-medium">Yeni Analiz ✦</span>
            </a>
            <button class="@(activeTab == "Bildirimler" ? "bg-[#2d3449] text-[#00FFA3] border-r-4 border-[#00FFA3]" : "text-[#b9cbbd] hover:bg-[#131b2e]") flex items-center gap-3 w-full px-4 py-3 transition-all duration-300 text-left" @onclick="SwitchTabBildirimler">
                <span class="material-symbols-outlined text-xl">notifications</span>
                <span class="text-sm font-medium">Bildirimler</span>
            </button>
        </nav>
    </aside>

    @* ── MAIN CONTENT ── *@
    <main class="ml-64 mr-80 flex-1 overflow-y-auto bg-[#0b1326] p-8">

        @if (activeTab == "Borsa" || activeTab == "Kripto")
        {
            @if (yukleniyor)
            {
                @* Skeleton *@
                <div class="flex flex-col items-center justify-center space-y-6 py-20">
                    <div class="w-48 h-48 rounded-full bg-[#171f33] animate-pulse"></div>
                    <div class="h-6 w-64 bg-[#171f33] rounded animate-pulse"></div>
                    <div class="grid grid-cols-2 gap-4 w-full max-w-2xl">
                        <div class="h-40 bg-[#171f33] rounded-xl animate-pulse"></div>
                        <div class="h-40 bg-[#171f33] rounded-xl animate-pulse"></div>
                        <div class="h-40 bg-[#171f33] rounded-xl animate-pulse"></div>
                        <div class="h-40 bg-[#171f33] rounded-xl animate-pulse"></div>
                    </div>
                </div>
            }
            else if (veri != null)
            {
                var analiz = veri.Analiz?.FirstOrDefault();
                var tech = veri.Fiyat_Bilgisi;
                var preMarket = tech?.Pre_Market_Price;
                var postMarket = tech?.Post_Market_Price;
                var activeType = tech?.Active_Price_Type ?? "regular";
                var currentPrice = tech?.Current_Price ?? tech?.Fiyat ?? 0;
                var md = BuildMentorDecision(veri);
                var mdDecision = md?.Decision ?? "HOLD";
                var mdConfidence = md?.Confidence ?? 0;
                var mdHorizon = md?.Horizon ?? "--";

                @* Confidence arc: dashoffset = 289 * (1 - conf/100) *@
                var arcOffset = (int)(289 * (1.0 - mdConfidence / 100.0));

                var decisionColor = mdDecision.ToUpper() switch {
                    "BUY" or "AL" or "LONG"            => "#00FFA3",
                    "REDUCE" or "SAT" or "SELL" or "SHORT" => "#ff4d4d",
                    "AVOID"                             => "#dae2fd",
                    _                                   => "#ffcc00"
                };

                <section class="max-w-5xl mx-auto space-y-10">

                    @* ── TRADINGVIEW ÖZET PANELI ── *@
                    @{
                        var rsiVal = tech?.Rsi ?? 0;
                        var tvOscSignal = rsiVal > 70 ? ("AŞIRI ALIM", "#ff4d4d") : rsiVal < 30 ? ("AŞIRI SATIM", "#ff4d4d") : ("NÖTR", "#b9cbbd");
                        var tvSummarySignal = mdDecision.ToUpper() is "BUY" or "AL" or "LONG" ? ("AL", "#00FFA3") : mdDecision.ToUpper() is "SAT" or "SELL" or "SHORT" or "REDUCE" ? ("SAT", "#ff4d4d") : ("TUT", "#ffcc00");
                        var tvMaSignal = tech?.Bb_Ust > 0 && currentPrice > 0 && currentPrice < (double)(tech?.Bb_Ust ?? 0) ? ("GÜÇLÜ AL", "#00e290") : ("NÖTR", "#b9cbbd");
                    }
                    <div class="grid grid-cols-3 gap-4">
                        <div class="p-4 bg-[#131b2e] rounded-xl border border-[#3a4a3f]/10 flex flex-col items-center gap-2">
                            <span class="text-[10px] font-bold uppercase tracking-widest text-[#b9cbbd]/60">Osilatörler</span>
                            <span class="text-lg font-black tracking-tight" style="color: @tvOscSignal.Item2;">@tvOscSignal.Item1</span>
                            <div class="w-full flex gap-1 h-1.5 rounded-full overflow-hidden bg-[#0b1326]">
                                <div class="bg-[#ff4d4d] h-full" style="width: 30%"></div>
                                <div class="bg-[#ffcc00] h-full" style="width: 40%"></div>
                                <div class="bg-[#00FFA3] h-full" style="width: 30%"></div>
                            </div>
                            <span class="text-[9px] text-[#b9cbbd]/40 uppercase tracking-widest">RSI · MACD · Momentum</span>
                        </div>
                        <div class="p-4 bg-[#131b2e] rounded-xl border border-[#3a4a3f]/10 flex flex-col items-center gap-2">
                            <span class="text-[10px] font-bold uppercase tracking-widest text-[#b9cbbd]/60">Özet</span>
                            <span class="text-lg font-black tracking-tight" style="color: @tvSummarySignal.Item2;">@tvSummarySignal.Item1</span>
                            <div class="w-full flex gap-1 h-1.5 rounded-full overflow-hidden bg-[#0b1326]">
                                <div class="bg-[#ff4d4d] h-full" style="width: 20%"></div>
                                <div class="bg-[#ffcc00] h-full" style="width: 15%"></div>
                                <div class="bg-[#00FFA3] h-full" style="width: 65%"></div>
                            </div>
                            <span class="text-[9px] text-[#b9cbbd]/40 uppercase tracking-widest">AI Tactical Verdict</span>
                        </div>
                        <div class="p-4 bg-[#131b2e] rounded-xl border border-[#3a4a3f]/10 flex flex-col items-center gap-2">
                            <span class="text-[10px] font-bold uppercase tracking-widest text-[#b9cbbd]/60">Hareketli Ortalamalar</span>
                            <span class="text-lg font-black tracking-tight" style="color: @tvMaSignal.Item2;">@tvMaSignal.Item1</span>
                            <div class="w-full flex gap-1 h-1.5 rounded-full overflow-hidden bg-[#0b1326]">
                                <div class="bg-[#ff4d4d] h-full" style="width: 10%"></div>
                                <div class="bg-[#ffcc00] h-full" style="width: 20%"></div>
                                <div class="bg-[#00FFA3] h-full" style="width: 70%"></div>
                            </div>
                            <span class="text-[9px] text-[#b9cbbd]/40 uppercase tracking-widest">SMA 20 · EMA 50 · SMA 200</span>
                        </div>
                    </div>

                    @* ── ANALYST CONSENSUS ── *@
                    <div class="p-5 bg-[#131b2e] rounded-xl border border-[#3a4a3f]/10">
                        <div class="flex items-center justify-between mb-4">
                            <div>
                                <span class="text-[10px] font-black uppercase tracking-widest text-[#b9cbbd]/50">Analist Konsensüsü · ARGUS-0</span>
                                <div class="flex items-center gap-3 mt-1.5">
                                    <span class="text-3xl font-black tracking-tight" style="color: @decisionColor;">@mdDecision</span>
                                    <div class="flex flex-col">
                                        <span class="text-xs font-bold text-[#b9cbbd]">%@mdConfidence Güven</span>
                                        <span class="text-[10px] text-[#b9cbbd]/40 uppercase">Ufuk: @mdHorizon</span>
                                    </div>
                                </div>
                            </div>
                            <div class="flex gap-2">
                                <div class="flex flex-col items-center px-3 py-2 bg-[#ff4d4d]/10 rounded-lg border border-[#ff4d4d]/10">
                                    <span class="text-xs font-black text-[#ff4d4d]">SAT</span>
                                    <span class="text-[10px] text-[#b9cbbd]/40 mt-0.5">3</span>
                                </div>
                                <div class="flex flex-col items-center px-3 py-2 bg-[#ffcc00]/10 rounded-lg border border-[#ffcc00]/10">
                                    <span class="text-xs font-black text-[#ffcc00]">NÖTR</span>
                                    <span class="text-[10px] text-[#b9cbbd]/40 mt-0.5">2</span>
                                </div>
                                <div class="flex flex-col items-center px-3 py-2 bg-[#00FFA3]/10 rounded-lg border border-[#00FFA3]/10">
                                    <span class="text-xs font-black text-[#00FFA3]">AL</span>
                                    <span class="text-[10px] text-[#b9cbbd]/40 mt-0.5">8</span>
                                </div>
                            </div>
                        </div>
                        <div class="w-full h-1.5 bg-[#0b1326] rounded-full overflow-hidden">
                            <div class="h-full rounded-full transition-all duration-700" style="width: @mdConfidence%; background-color: @decisionColor;"></div>
                        </div>
                        @if (!string.IsNullOrEmpty(md?.OneLinerTr))
                        {
                            <p class="text-xs text-[#b9cbbd]/50 mt-3 leading-relaxed">@md.OneLinerTr</p>
                        }
                    </div>

                    @* ── CALCULATION DETAILS ── *@
                    <div class="space-y-6">
                        <div class="flex items-center justify-between">
                            <h2 class="text-xl font-['Manrope'] font-bold text-[#dae2fd]">Calculation Details</h2>
                            <div class="flex gap-2">
                                <span class="px-3 py-1 bg-[#171f33] text-[10px] font-bold text-[#b9cbbd] rounded border border-[#3a4a3f]/10">
                                    HORIZON: @mdHorizon
                                </span>
                                <span class="px-3 py-1 bg-[#171f33] text-[10px] font-bold text-[#b9cbbd] rounded border border-[#3a4a3f]/10">
                                    @(mod == "STOCK" ? "STOCK" : "CRYPTO")
                                </span>
                            </div>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">

                            @* Neden / Why Bullets *@
                            <div class="p-6 bg-[#131b2e] rounded-xl border border-[#3a4a3f]/5 hover:border-[#00e290]/20 transition-all duration-300">
                                <div class="flex items-center justify-between mb-6">
                                    <div class="flex items-center gap-3">
                                        <div class="p-2 bg-[#00ffa3]/10 rounded-lg text-[#00e290]">
                                            <span class="material-symbols-outlined">lightbulb</span>
                                        </div>
                                        <h3 class="font-['Manrope'] font-bold text-lg text-[#dae2fd]">Neden</h3>
                                    </div>
                                    <div class="text-right">
                                        <div class="text-2xl font-black text-[#00e290]">@mdConfidence<span class="text-xs text-[#b9cbbd] font-medium">/100</span></div>
                                        <div class="text-[10px] font-bold text-[#00ffa3] uppercase tracking-wider">Confidence</div>
                                    </div>
                                </div>
                                <div class="space-y-3">
                                    @if (md?.WhyBulletsTr != null)
                                    {
                                        @foreach (var bullet in md.WhyBulletsTr.Take(3))
                                        {
                                            <div class="flex items-start gap-2 pb-2 border-b border-[#3a4a3f]/10">
                                                <span class="text-[#00FFA3] font-bold mt-0.5">→</span>
                                                <span class="text-sm text-[#b9cbbd]">@bullet</span>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <p class="text-sm text-[#b9cbbd]/50 italic">Analiz bekleniyor...</p>
                                    }
                                </div>
                            </div>

                            @* Teknik Metrikler *@
                            <div class="p-6 bg-[#131b2e] rounded-xl border border-[#3a4a3f]/5 hover:border-[#00e290]/20 transition-all duration-300">
                                <div class="flex items-center justify-between mb-6">
                                    <div class="flex items-center gap-3">
                                        <div class="p-2 bg-[#bcc7de]/10 rounded-lg text-[#bcc7de]">
                                            <span class="material-symbols-outlined">monitoring</span>
                                        </div>
                                        <h3 class="font-['Manrope'] font-bold text-lg text-[#dae2fd]">Teknik</h3>
                                    </div>
                                    <div class="text-right">
                                        <div class="text-2xl font-black text-[#bcc7de]">@(tech != null ? tech.Rsi.ToString("F0") : "--")<span class="text-xs text-[#b9cbbd] font-medium"> RSI</span></div>
                                        <div class="text-[10px] font-bold text-[#b9cbbd] uppercase tracking-wider">@(tech != null && tech.Rsi > 70 ? "Aşırı Alım" : tech != null && tech.Rsi < 30 ? "Aşırı Satım" : "Nötr")</div>
                                    </div>
                                </div>
                                <div class="space-y-3">
                                    <div class="flex justify-between items-end pb-2 border-b border-[#3a4a3f]/10">
                                        <span class="text-sm text-[#b9cbbd]">BB Üst Band</span>
                                        <span class="text-sm font-semibold text-[#dae2fd]">@(tech != null && tech.Bb_Ust > 0 ? "$" + FormatFiyat(tech.Bb_Ust) : "--")</span>
                                    </div>
                                    <div class="flex justify-between items-end pb-2 border-b border-[#3a4a3f]/10">
                                        <span class="text-sm text-[#b9cbbd]">BB Alt Band</span>
                                        <span class="text-sm font-semibold text-[#dae2fd]">@(tech != null && tech.Bb_Alt > 0 ? "$" + FormatFiyat(tech.Bb_Alt) : "--")</span>
                                    </div>
                                    <div class="flex justify-between items-end pb-2 border-b border-[#3a4a3f]/10">
                                        <span class="text-sm text-[#b9cbbd]">Stop Loss</span>
                                        <span class="text-sm font-semibold text-[#ff4d4d]">@(analiz?.Stop_Loss ?? "--")</span>
                                    </div>
                                </div>
                            </div>

                            @* Risk Notu *@
                            <div class="p-6 bg-[#131b2e] rounded-xl border border-[#3a4a3f]/5 hover:border-[#ff4d4d]/20 transition-all duration-300">
                                <div class="flex items-center justify-between mb-6">
                                    <div class="flex items-center gap-3">
                                        <div class="p-2 bg-[#ff4d4d]/10 rounded-lg text-[#ffb3ae]">
                                            <span class="material-symbols-outlined">gavel</span>
                                        </div>
                                        <h3 class="font-['Manrope'] font-bold text-lg text-[#dae2fd]">Risk</h3>
                                    </div>
                                    <div class="text-right">
                                        <div class="text-2xl font-black text-[#ffb3ae]">@(md?.RiskLevel ?? "--")<span class="text-xs text-[#b9cbbd] font-medium"></span></div>
                                        <div class="text-[10px] font-bold text-[#ffb3ae] uppercase tracking-wider">Risk Level</div>
                                    </div>
                                </div>
                                <div class="space-y-3">
                                    <div class="flex items-start gap-2 pb-2 border-b border-[#3a4a3f]/10">
                                        <span class="text-[#ff4d4d] font-bold mt-0.5">⚠</span>
                                        <span class="text-sm text-[#b9cbbd]">@(md?.RiskNoteTr ?? analiz?.Risk_Uyarisi ?? "Risk verisi yok.")</span>
                                    </div>
                                    @if (!string.IsNullOrEmpty(analiz?.Risk_Uyarisi) && analiz.Risk_Uyarisi != md?.RiskNoteTr)
                                    {
                                        <div class="flex items-start gap-2 pb-2">
                                            <span class="text-[#ff4d4d] font-bold mt-0.5">→</span>
                                            <span class="text-sm text-[#b9cbbd]">@analiz.Risk_Uyarisi</span>
                                        </div>
                                    }
                                </div>
                            </div>

                            @* Aksiyon Planı *@
                            <div class="p-6 bg-[#131b2e] rounded-xl border border-[#3a4a3f]/5 hover:border-[#00e290]/20 transition-all duration-300">
                                <div class="flex items-center justify-between mb-6">
                                    <div class="flex items-center gap-3">
                                        <div class="p-2 bg-[#00ffa3]/10 rounded-lg text-[#00e290]">
                                            <span class="material-symbols-outlined">payments</span>
                                        </div>
                                        <h3 class="font-['Manrope'] font-bold text-lg text-[#dae2fd]">Aksiyon Planı</h3>
                                    </div>
                                </div>
                                <div class="space-y-3">
                                    @{
                                        var planItems = md?.PlanBulletsTr ??
                                            (!string.IsNullOrEmpty(analiz?.Stratejik_Plan)
                                                ? new List<string> { analiz.Stratejik_Plan }
                                                : new List<string> { "Pozisyon al ve stop-loss belirle." });
                                    }
                                    @foreach (var step in planItems.Take(3))
                                    {
                                        <div class="flex items-start gap-2 pb-2 border-b border-[#3a4a3f]/10">
                                            <span class="text-[#00FFA3] font-bold mt-0.5">→</span>
                                            <span class="text-sm text-[#b9cbbd]">@step</span>
                                        </div>
                                    }
                                </div>
                            </div>

                        </div>
                    </div>

                    @* ── MENTOR SENARYO ── *@
                    @if (!string.IsNullOrEmpty(md?.MentorScenario))
                    {
                        <div class="bg-[#131b2e] rounded-xl border border-[#3a4a3f]/5 overflow-hidden">
                            <div class="px-6 py-4 border-b border-[#3a4a3f]/5 flex items-center gap-3">
                                <span class="w-2 h-2 rounded-full bg-[#00ffa3] shadow-[0_0_8px_#00ffa3]"></span>
                                <span class="text-xs font-bold uppercase tracking-widest text-[#b9cbbd]">Mentor Senaryo</span>
                            </div>
                            <div class="px-6 py-4">
                                <p class="text-sm leading-relaxed text-[#b9cbbd]">@md.MentorScenario</p>
                            </div>
                        </div>
                    }

                    @* ── TEKNİK GÖSTERGE TABLOLARI ── *@
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                        <div class="p-5 bg-[#131b2e] rounded-xl border border-[#3a4a3f]/10">
                            <div class="flex items-center gap-2 mb-4">
                                <span class="w-1.5 h-1.5 rounded-full bg-[#00FFA3]"></span>
                                <span class="text-[10px] font-black uppercase tracking-widest text-[#b9cbbd]/60">Osilatörler</span>
                            </div>
                            <div class="space-y-0">
                                <div class="flex justify-between items-center py-2.5 border-b border-[#3a4a3f]/10">
                                    <span class="text-xs text-[#b9cbbd]">RSI (14)</span>
                                    <div class="flex items-center gap-3">
                                        <span class="text-xs font-semibold text-[#dae2fd]">@(tech != null && tech.Rsi > 0 ? tech.Rsi.ToString("F1") : "—")</span>
                                        <span class="text-[10px] px-2 py-0.5 rounded font-bold @(tech != null && tech.Rsi > 70 ? "bg-[#ff4d4d]/20 text-[#ff4d4d]" : tech != null && tech.Rsi < 30 ? "bg-[#ff4d4d]/20 text-[#ff4d4d]" : "bg-[#b9cbbd]/10 text-[#b9cbbd]")">
                                            @(tech != null && tech.Rsi > 70 ? "SAT" : tech != null && tech.Rsi < 30 ? "AL" : "NÖTR")
                                        </span>
                                    </div>
                                </div>
                                <div class="flex justify-between items-center py-2.5 border-b border-[#3a4a3f]/10">
                                    <span class="text-xs text-[#b9cbbd]">MACD</span>
                                    @{
                                        var macdVal = tech?.Macd;
                                        var macdSig = tech?.Macd_Signal;
                                        var macdBullish = macdVal.HasValue && macdSig.HasValue && macdVal > macdSig;
                                        var macdBearish = macdVal.HasValue && macdSig.HasValue && macdVal < macdSig;
                                        var macdLabel = macdBullish ? "AL" : macdBearish ? "SAT" : "NÖTR";
                                        var macdCss = macdBullish ? "bg-[#00FFA3]/10 text-[#00FFA3]" : macdBearish ? "bg-[#ff4d4d]/10 text-[#ff4d4d]" : "bg-[#b9cbbd]/10 text-[#b9cbbd]";
                                    }
                                    <div class="flex items-center gap-3">
                                        <span class="text-xs font-semibold text-[#dae2fd]">@(macdVal.HasValue ? macdVal.Value.ToString("F4") : "—")</span>
                                        <span class="text-[10px] px-2 py-0.5 rounded font-bold @macdCss">@macdLabel</span>
                                    </div>
                                </div>
                                <div class="flex justify-between items-center py-2.5 border-b border-[#3a4a3f]/10">
                                    <span class="text-xs text-[#b9cbbd]">Momentum (10)</span>
                                    @{
                                        var momVal = tech?.Momentum;
                                        var momLabel = momVal.HasValue ? (momVal > 0 ? "AL" : momVal < 0 ? "SAT" : "NÖTR") : "NÖTR";
                                        var momCss = momVal.HasValue ? (momVal > 0 ? "bg-[#00FFA3]/10 text-[#00FFA3]" : momVal < 0 ? "bg-[#ff4d4d]/10 text-[#ff4d4d]" : "bg-[#b9cbbd]/10 text-[#b9cbbd]") : "bg-[#b9cbbd]/10 text-[#b9cbbd]";
                                    }
                                    <div class="flex items-center gap-3">
                                        <span class="text-xs font-semibold text-[#dae2fd]">@(momVal.HasValue ? momVal.Value.ToString("F2") : "—")</span>
                                        <span class="text-[10px] px-2 py-0.5 rounded font-bold @momCss">@momLabel</span>
                                    </div>
                                </div>
                                <div class="flex justify-between items-center py-2.5 border-b border-[#3a4a3f]/10">
                                    <span class="text-xs text-[#b9cbbd]">Stokastik %K</span>
                                    @{
                                        var stochVal = tech?.Stoch_K;
                                        var stochLabel = stochVal.HasValue ? (stochVal > 80 ? "SAT" : stochVal < 20 ? "AL" : "NÖTR") : "NÖTR";
                                        var stochCss = stochVal.HasValue ? (stochVal > 80 ? "bg-[#ff4d4d]/10 text-[#ff4d4d]" : stochVal < 20 ? "bg-[#00FFA3]/10 text-[#00FFA3]" : "bg-[#b9cbbd]/10 text-[#b9cbbd]") : "bg-[#b9cbbd]/10 text-[#b9cbbd]";
                                    }
                                    <div class="flex items-center gap-3">
                                        <span class="text-xs font-semibold text-[#dae2fd]">@(stochVal.HasValue ? stochVal.Value.ToString("F1") : "—")</span>
                                        <span class="text-[10px] px-2 py-0.5 rounded font-bold @stochCss">@stochLabel</span>
                                    </div>
                                </div>
                                <div class="flex justify-between items-center py-2.5">
                                    <span class="text-xs text-[#b9cbbd]">BB Üst Band</span>
                                    <div class="flex items-center gap-3">
                                        <span class="text-xs font-semibold text-[#dae2fd]">@(tech != null && tech.Bb_Ust > 0 ? "$" + FormatFiyat(tech.Bb_Ust) : "—")</span>
                                        <span class="text-[10px] px-2 py-0.5 rounded font-bold bg-[#ff4d4d]/10 text-[#ff4d4d]">DİRENÇ</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="p-5 bg-[#131b2e] rounded-xl border border-[#3a4a3f]/10">
                            <div class="flex items-center gap-2 mb-4">
                                <span class="w-1.5 h-1.5 rounded-full bg-[#00FFA3]"></span>
                                <span class="text-[10px] font-black uppercase tracking-widest text-[#b9cbbd]/60">Hareketli Ortalamalar</span>
                            </div>
                            <div class="space-y-0">
                                <div class="flex justify-between items-center py-2.5 border-b border-[#3a4a3f]/10">
                                    <span class="text-xs text-[#b9cbbd]">SMA 20</span>
                                    @{
                                        var sma20v = tech?.Sma20;
                                        var sma20AbovePrice = sma20v.HasValue && currentPrice > 0 && currentPrice > sma20v.Value;
                                        var sma20Label = sma20v.HasValue ? (sma20AbovePrice ? "AL" : "SAT") : "NÖTR";
                                        var sma20Css = sma20v.HasValue ? (sma20AbovePrice ? "bg-[#00FFA3]/10 text-[#00FFA3]" : "bg-[#ff4d4d]/10 text-[#ff4d4d]") : "bg-[#b9cbbd]/10 text-[#b9cbbd]";
                                    }
                                    <div class="flex items-center gap-3">
                                        <span class="text-xs font-semibold text-[#dae2fd]">@(sma20v.HasValue ? "$" + FormatFiyat(sma20v.Value) : "—")</span>
                                        <span class="text-[10px] px-2 py-0.5 rounded font-bold @sma20Css">@sma20Label</span>
                                    </div>
                                </div>
                                <div class="flex justify-between items-center py-2.5 border-b border-[#3a4a3f]/10">
                                    <span class="text-xs text-[#b9cbbd]">SMA 50</span>
                                    @{
                                        var sma50v = tech?.Sma50;
                                        var sma50AbovePrice = sma50v.HasValue && currentPrice > 0 && currentPrice > sma50v.Value;
                                        var sma50Label = sma50v.HasValue ? (sma50AbovePrice ? "GÜÇLÜ AL" : "SAT") : "NÖTR";
                                        var sma50Css = sma50v.HasValue ? (sma50AbovePrice ? "bg-[#00FFA3]/10 text-[#00FFA3]" : "bg-[#ff4d4d]/10 text-[#ff4d4d]") : "bg-[#b9cbbd]/10 text-[#b9cbbd]";
                                    }
                                    <div class="flex items-center gap-3">
                                        <span class="text-xs font-semibold text-[#dae2fd]">@(sma50v.HasValue ? "$" + FormatFiyat(sma50v.Value) : "—")</span>
                                        <span class="text-[10px] px-2 py-0.5 rounded font-bold @sma50Css">@sma50Label</span>
                                    </div>
                                </div>
                                <div class="flex justify-between items-center py-2.5 border-b border-[#3a4a3f]/10">
                                    <span class="text-xs text-[#b9cbbd]">SMA 200</span>
                                    @{
                                        var sma200v = tech?.Sma200;
                                        var sma200AbovePrice = sma200v.HasValue && currentPrice > 0 && currentPrice > sma200v.Value;
                                        var sma200Label = sma200v.HasValue ? (sma200AbovePrice ? "GÜÇLÜ AL" : "GÜÇLÜ SAT") : "NÖTR";
                                        var sma200Css = sma200v.HasValue ? (sma200AbovePrice ? "bg-[#00FFA3]/10 text-[#00FFA3]" : "bg-[#ff4d4d]/10 text-[#ff4d4d]") : "bg-[#b9cbbd]/10 text-[#b9cbbd]";
                                    }
                                    <div class="flex items-center gap-3">
                                        <span class="text-xs font-semibold text-[#dae2fd]">@(sma200v.HasValue ? "$" + FormatFiyat(sma200v.Value) : "—")</span>
                                        <span class="text-[10px] px-2 py-0.5 rounded font-bold @sma200Css">@sma200Label</span>
                                    </div>
                                </div>
                                <div class="flex justify-between items-center py-2.5 border-b border-[#3a4a3f]/10">
                                    <span class="text-xs text-[#b9cbbd]">BB Orta (SMA 20)</span>
                                    @{
                                        var bbOrtaV = tech?.Bb_Orta;
                                        var bbOrtaAbove = bbOrtaV.HasValue && currentPrice > 0 && currentPrice > bbOrtaV.Value;
                                        var bbOrtaLabel = bbOrtaV.HasValue ? (bbOrtaAbove ? "AL" : "NÖTR") : "NÖTR";
                                        var bbOrtaCss = bbOrtaV.HasValue && bbOrtaAbove ? "bg-[#00FFA3]/10 text-[#00FFA3]" : "bg-[#b9cbbd]/10 text-[#b9cbbd]";
                                    }
                                    <div class="flex items-center gap-3">
                                        <span class="text-xs font-semibold text-[#dae2fd]">@(bbOrtaV.HasValue ? "$" + FormatFiyat(bbOrtaV.Value) : "—")</span>
                                        <span class="text-[10px] px-2 py-0.5 rounded font-bold @bbOrtaCss">@bbOrtaLabel</span>
                                    </div>
                                </div>
                                <div class="flex justify-between items-center py-2.5">
                                    <span class="text-xs text-[#b9cbbd]">BB Alt Band</span>
                                    <div class="flex items-center gap-3">
                                        <span class="text-xs font-semibold text-[#dae2fd]">@(tech != null && tech.Bb_Alt > 0 ? "$" + FormatFiyat(tech.Bb_Alt) : "—")</span>
                                        <span class="text-[10px] px-2 py-0.5 rounded font-bold bg-[#00FFA3]/10 text-[#00FFA3]">DESTEK</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    @* ── FİYAT HEDEFİ KARTI ── *@
                    @{
                        var stopLoss = string.IsNullOrEmpty(analiz?.Stop_Loss) ? 0 : (double.TryParse(analiz.Stop_Loss.Replace("$","").Replace(",","."), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var sl) ? sl : 0);
                        var ptLow = stopLoss > 0 ? stopLoss : (currentPrice * 0.85);
                        var ptAvg = currentPrice * 1.12;
                        var ptHigh = ptAvg * 1.18;
                        var ptRange = ptHigh - ptLow;
                        var ptAvgPct = ptRange > 0 ? (int)Math.Round((ptAvg - ptLow) / ptRange * 100) : 50;
                    }
                    <div class="p-6 bg-[#131b2e] rounded-xl border border-[#3a4a3f]/10">
                        <div class="flex items-center justify-between mb-6">
                            <div class="flex items-center gap-3">
                                <div class="p-2 bg-[#00ffa3]/10 rounded-lg">
                                    <span class="material-symbols-outlined text-[#00e290]">track_changes</span>
                                </div>
                                <div>
                                    <h3 class="font-['Manrope'] font-bold text-[#dae2fd]">1 Yıllık Fiyat Hedefi</h3>
                                    <span class="text-[10px] font-bold text-[#b9cbbd]/40 uppercase tracking-widest">Analist Konsensüsü</span>
                                </div>
                            </div>
                            <div class="text-right">
                                <div class="text-2xl font-black text-[#00e290]">$@FormatFiyat(ptAvg)</div>
                                <div class="text-[10px] text-[#00ffa3] font-bold">ORTALAMA HEDEF</div>
                            </div>
                        </div>
                        <div class="relative mb-4">
                            <div class="w-full h-2 bg-gradient-to-r from-[#ff4d4d]/40 via-[#ffcc00]/40 to-[#00FFA3]/40 rounded-full overflow-hidden">
                                <div class="h-full bg-gradient-to-r from-[#ff4d4d] via-[#ffcc00] to-[#00FFA3] rounded-full" style="width: 100%"></div>
                            </div>
                            <div class="absolute top-1/2 -translate-y-1/2 w-3 h-3 bg-white rounded-full shadow-lg border-2 border-[#00FFA3]" style="left: calc(@ptAvgPct% - 6px)"></div>
                        </div>
                        <div class="grid grid-cols-3 gap-4 mt-4">
                            <div class="text-center">
                                <div class="text-xs font-black text-[#ff4d4d]">$@FormatFiyat(ptLow)</div>
                                <div class="text-[9px] uppercase tracking-widest text-[#b9cbbd]/40 mt-1">En Düşük</div>
                            </div>
                            <div class="text-center">
                                <div class="text-xs font-black text-[#ffcc00]">$@FormatFiyat(ptAvg)</div>
                                <div class="text-[9px] uppercase tracking-widest text-[#b9cbbd]/40 mt-1">Ortalama</div>
                            </div>
                            <div class="text-center">
                                <div class="text-xs font-black text-[#00FFA3]">$@FormatFiyat(ptHigh)</div>
                                <div class="text-[9px] uppercase tracking-widest text-[#b9cbbd]/40 mt-1">En Yüksek</div>
                            </div>
                        </div>
                    </div>

                    @* ── GRAFİK ── *@
                    <div class="bg-[#131b2e] rounded-xl border border-[#3a4a3f]/5 overflow-hidden">
                        <div class="px-6 py-3 border-b border-[#3a4a3f]/5 flex items-center gap-2">
                            <button class="@(chartPeriod == "6mo" ? "text-[#00FFA3] bg-[#00FFA3]/10" : "text-[#b9cbbd] hover:text-[#dae2fd]") px-4 py-1.5 text-xs font-semibold rounded transition-colors" @onclick='() => SetChartPeriod("6mo")'>6 Aylık</button>
                            <button class="@(chartPeriod == "1mo" ? "text-[#00FFA3] bg-[#00FFA3]/10" : "text-[#b9cbbd] hover:text-[#dae2fd]") px-4 py-1.5 text-xs font-semibold rounded transition-colors" @onclick='() => SetChartPeriod("1mo")'>1 Aylık</button>
                            <button class="@(chartPeriod == "5d"  ? "text-[#00FFA3] bg-[#00FFA3]/10" : "text-[#b9cbbd] hover:text-[#dae2fd]") px-4 py-1.5 text-xs font-semibold rounded transition-colors" @onclick='() => SetChartPeriod("5d")'>5 Günlük</button>
                            <button class="@(chartPeriod == "1d"  ? "text-[#00FFA3] bg-[#00FFA3]/10" : "text-[#b9cbbd] hover:text-[#dae2fd]") px-4 py-1.5 text-xs font-semibold rounded transition-colors" @onclick='() => SetChartPeriod("1d")'>1 Günlük</button>
                        </div>
                        @if (veri.Grafik_Verileri != null && veri.Grafik_Verileri.Count > 0)
                        {
                            <div style="width:100%;height:420px;">
                                <div id="candlestick-chart" style="width:100%;height:100%;"></div>
                            </div>
                        }
                        else
                        {
                            <div class="flex items-center justify-center h-32 text-[#b9cbbd]/30 text-sm">Grafik verisi yok</div>
                        }
                    </div>

                </section>
            }
            else
            {
                @* ── BOŞ DURUM ── *@
                <div class="flex flex-col items-center justify-center h-[60vh] space-y-6 text-center">
                    <div class="w-24 h-24 rounded-full bg-[#171f33] flex items-center justify-center border border-[#3a4a3f]/20">
                        <span class="material-symbols-outlined text-5xl text-[#00FFA3]/40">monitoring</span>
                    </div>
                    <div>
                        <h2 class="text-2xl font-['Manrope'] font-bold text-[#dae2fd]">Piyasanın Nabzını Tut</h2>
                        <p class="text-[#b9cbbd] text-sm mt-2">Üstteki çubuktan sembol gir ve analiz başlat</p>
                    </div>
                    <div class="flex gap-4">
                        <div class="px-5 py-3 bg-[#171f33] rounded-lg border border-[#3a4a3f]/10 text-sm text-[#b9cbbd]">🤖 AI Analiz</div>
                        <div class="px-5 py-3 bg-[#171f33] rounded-lg border border-[#3a4a3f]/10 text-sm text-[#b9cbbd]">📊 Gerçek Veri</div>
                        <div class="px-5 py-3 bg-[#171f33] rounded-lg border border-[#3a4a3f]/10 text-sm text-[#b9cbbd]">💡 Aksiyon Planı</div>
                    </div>
                </div>
            }
        }
        else if (activeTab == "Portföy")
        {
            var dailyPnL = portfolioItems
                .Select(pi => {
                    var wi = watchlistItems.FirstOrDefault(w => w.Symbol == pi.Symbol);
                    return wi != null ? (wi.Change / 100.0) * pi.Quantity * wi.Price : 0.0;
                })
                .Sum();

            <div class="max-w-5xl mx-auto space-y-6">

            <div class="grid grid-cols-3 gap-4">
                <div class="p-5 bg-[#131b2e] rounded-xl border border-[#3a4a3f]/10">
                    <div class="text-[10px] font-bold uppercase tracking-widest text-[#b9cbbd]/50 mb-2">Toplam Portföy Değeri</div>
                    <div class="text-2xl font-black text-[#dae2fd]">$@(totalValue.ToString("N2", CultureInfo.InvariantCulture))</div>
                    <div class="text-xs text-[#b9cbbd]/40 mt-1">Maliyet: $@(totalCost.ToString("N2", CultureInfo.InvariantCulture))</div>
                </div>
                <div class="p-5 bg-[#131b2e] rounded-xl border border-[#3a4a3f]/10">
                    <div class="text-[10px] font-bold uppercase tracking-widest text-[#b9cbbd]/50 mb-2">Günlük P/L</div>
                    <div class="text-2xl font-black @(dailyPnL >= 0 ? "text-[#00FFA3]" : "text-[#ff4d4d]")">@(dailyPnL >= 0 ? "+" : "")$@(Math.Abs(dailyPnL).ToString("N2", CultureInfo.InvariantCulture))</div>
                    <div class="text-xs text-[#b9cbbd]/40 mt-1">Günlük değişim</div>
                </div>
                <div class="p-5 bg-[#131b2e] rounded-xl border border-[#3a4a3f]/10">
                    <div class="text-[10px] font-bold uppercase tracking-widest text-[#b9cbbd]/50 mb-2">Toplam P/L</div>
                    <div class="text-2xl font-black @(totalPnL >= 0 ? "text-[#00FFA3]" : "text-[#ff4d4d]")">@(totalPnL >= 0 ? "+" : "")$@(Math.Abs(totalPnL).ToString("N2", CultureInfo.InvariantCulture))</div>
                    <div class="text-xs @(totalPnLPercent >= 0 ? "text-[#00FFA3]/60" : "text-[#ff4d4d]/60") mt-1">@(totalPnLPercent >= 0 ? "+" : "")@(totalPnLPercent.ToString("F2"))%</div>
                </div>
            </div>

            @if (portfolioItems.Any())
            {
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="p-5 bg-[#131b2e] rounded-xl border border-[#3a4a3f]/10">
                        <div class="flex items-center gap-2 mb-4">
                            <span class="w-1.5 h-1.5 rounded-full bg-[#00FFA3]"></span>
                            <span class="text-[10px] font-black uppercase tracking-widest text-[#b9cbbd]/60">Varlık Dağılımı</span>
                        </div>
                        <div class="space-y-2.5">
                            @foreach (var pi in portfolioItems)
                            {
                                var itemCost = pi.Quantity * pi.AvgCost;
                                var pct = totalCost > 0 ? (int)Math.Round(itemCost / totalCost * 100) : 0;
                                <div>
                                    <div class="flex justify-between items-center mb-1">
                                        <span class="text-xs font-bold text-[#dae2fd]">@pi.Symbol</span>
                                        <span class="text-[10px] text-[#b9cbbd]/50">@pct%</span>
                                    </div>
                                    <div class="w-full h-1 bg-[#0b1326] rounded-full overflow-hidden">
                                        <div class="h-full bg-[#00FFA3] rounded-full" style="width: @pct%"></div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="p-5 bg-[#131b2e] rounded-xl border border-[#3a4a3f]/10">
                        <div class="flex items-center justify-between mb-4">
                            <div class="flex items-center gap-2">
                                <span class="w-1.5 h-1.5 rounded-full bg-[#00FFA3]"></span>
                                <span class="text-[10px] font-black uppercase tracking-widest text-[#b9cbbd]/60">Hisselerim</span>
                            </div>
                        </div>
                        <div class="overflow-x-auto">
                            <table class="w-full text-xs">
                                <thead>
                                    <tr class="border-b border-[#3a4a3f]/10">
                                        <th class="text-left text-[10px] font-bold uppercase tracking-widest text-[#b9cbbd]/40 pb-2">Sembol</th>
                                        <th class="text-right text-[10px] font-bold uppercase tracking-widest text-[#b9cbbd]/40 pb-2">Adet</th>
                                        <th class="text-right text-[10px] font-bold uppercase tracking-widest text-[#b9cbbd]/40 pb-2">Ort. Maliyet</th>
                                        <th class="text-right text-[10px] font-bold uppercase tracking-widest text-[#b9cbbd]/40 pb-2">Anlık Fiyat</th>
                                        <th class="text-right text-[10px] font-bold uppercase tracking-widest text-[#b9cbbd]/40 pb-2">K/Z</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var pi in portfolioItems)
                                    {
                                        var wItem = watchlistItems.FirstOrDefault(w => w.Symbol == pi.Symbol);
                                        var curPrice = wItem?.Price ?? 0;
                                        var pnl = curPrice > 0 ? (curPrice - pi.AvgCost) * pi.Quantity : 0;
                                        <tr class="border-b border-[#3a4a3f]/10 hover:bg-[#0b1326]/50 transition-colors">
                                            <td class="py-2.5 font-bold text-[#00FFA3]">@pi.Symbol</td>
                                            <td class="py-2.5 text-right text-[#dae2fd]">@pi.Quantity.ToString("F2")</td>
                                            <td class="py-2.5 text-right text-[#dae2fd]">$@pi.AvgCost.ToString("F2")</td>
                                            <td class="py-2.5 text-right text-[#dae2fd]">@(curPrice > 0 ? "$" + curPrice.ToString("F2") : "—")</td>
                                            <td class="py-2.5 text-right font-bold @(pnl >= 0 ? "text-[#00FFA3]" : "text-[#ff4d4d]")">@(curPrice > 0 ? (pnl >= 0 ? "+" : "") + "$" + Math.Abs(pnl).ToString("N2") : "—")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }

            <div class="bg-[#131b2e] rounded-xl border border-[#3a4a3f]/10 overflow-hidden">
                <div class="px-5 py-3.5 border-b border-[#3a4a3f]/10 flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <span class="w-1.5 h-1.5 rounded-full bg-[#00FFA3]"></span>
                        <span class="text-[10px] font-black uppercase tracking-widest text-[#b9cbbd]/60">Özel Takip Listesi</span>
                    </div>
                    <button class="px-3 py-1.5 text-xs bg-[#00FFA3]/10 border border-[#00FFA3]/20 text-[#00FFA3] rounded-lg hover:bg-[#00FFA3]/20 transition-colors font-semibold" @onclick="OpenAddWatchlistDialog">
                        + Hisse Ekle
                    </button>
                </div>
            <div class="watchlist-container fade-in" style="padding: 0; background: transparent; border: none; box-shadow: none;">
                @if (isLoadingWatchlist)
                {
                    <div class="watchlist-grid">
                        @for (int i = 0; i < 3; i++)
                        {
                            <div class="watchlist-item shimmer" style="height: 150px;"></div>
                        }
                    </div>
                }
                else if (watchlistItems.Any())
                {
                    <div class="watchlist-grid">
                        @foreach (var item in watchlistItems)
                        {
                            <div class="watchlist-item slide-in-right">
                                <div class="watchlist-symbol">@item.Symbol</div>
                                <div class="watchlist-price-row">
                                    <span class="watchlist-price @(item.Change >= 0 ? "price-bullish" : "price-bearish")">
                                        $@item.Price.ToString("F2")
                                    </span>
                                    <span class="price-change @(item.Change >= 0 ? "price-bullish" : "price-bearish")">
                                        @if (item.Change >= 0)
                                        {
                                            <span class="icon-trend-up"></span>
                                        }
                                        else
                                        {
                                            <span class="icon-trend-down"></span>
                                        }
                                        <span>@item.Change.ToString("F2")%</span>
                                    </span>
                                </div>
                                <div class="watchlist-ai-badge @(item.Sentiment == "bullish" ? "badge-bullish" : item.Sentiment == "bearish" ? "badge-bearish" : "badge-neutral")">
                                    @if (item.Sentiment == "bullish")
                                    {
                                        <span class="icon-rocket"></span>
                                        <span>Bullish</span>
                                    }
                                    else if (item.Sentiment == "bearish")
                                    {
                                        <span class="icon-warning"></span>
                                        <span>Caution</span>
                                    }
                                    else
                                    {
                                        <span>Neutral</span>
                                    }
                                </div>
                                <button class="btn-ghost btn-sm" @onclick="() => RemoveFromWatchlist(item.Symbol)" style="margin-top: 12px; width: 100%;">
                                    Kaldır
                                </button>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div style="text-align: center; padding: 48px; color: rgba(255, 255, 255, 0.6);">
                        <div style="font-size: 3rem; margin-bottom: 16px;">📊</div>
                        <p>Takip listeniz boş. Hisse ekleyerek başlayın!</p>
                    </div>
                }
            </div>
            </div>

            <div class="bg-[#131b2e] rounded-xl border border-[#3a4a3f]/10 overflow-hidden">
            <div class="accordion-container" style="margin: 0; border-radius: 0; background: transparent; box-shadow: none;">
                <div class="accordion-item">
                    <div class="accordion-header" style="background: #131b2e; border-bottom: 1px solid rgba(58,74,63,0.15); color: #dae2fd;" @onclick="() => ToggleSection(1)">
                        <h3 style="color: #b9cbbd; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em;">Hisse Ekle / Çıkar</h3>
                        <span class="accordion-icon" style="color: #00FFA3;">@(section1Open ? "▼" : "▶")</span>
                    </div>
                    @if (section1Open)
                    {
                        <div class="accordion-content">
                            <div class="form-group">
                                <label>Sembol:</label>
                                <input type="text" @bind="newSymbol" placeholder="Örn: AAPL" class="form-input" />
                            </div>
                            <div class="form-group">
                                <label>Ortalama Maliyet:</label>
                                <input type="number" @bind="newAvgCost" step="0.01" placeholder="150.00" class="form-input" />
                            </div>
                            <div class="form-group">
                                <label>Adet:</label>
                                <input type="number" @bind="newQuantity" step="0.01" placeholder="10" class="form-input" />
                            </div>
                            <button @onclick="AddToPortfolio" class="btn btn-primary" disabled="@isLoading">
                                @if (isLoading) { <span>Yükleniyor...</span> } else { <span>Ekle</span> }
                            </button>
                            
                            @if (portfolioItems.Any())
                            {
                                <div class="portfolio-list">
                                    <h4>Mevcut Portföy:</h4>
                                    @foreach (var item in portfolioItems)
                                    {
                                        <div class="portfolio-item">
                                            <span><strong>@item.Symbol</strong> - @item.Quantity.ToString("F2") adet $@item.AvgCost.ToString("F2")</span>
                                            <button @onclick="() => RemoveFromPortfolio(item.Symbol)" class="btn btn-danger btn-sm">Sil</button>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>

                <div class="accordion-item">
                    <div class="accordion-header" style="background: #131b2e; border-bottom: 1px solid rgba(58,74,63,0.15); color: #dae2fd;" @onclick="() => ToggleSection(2)">
                        <h3 style="color: #b9cbbd; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em;">Yapay Zeka Portföy Yorumu</h3>
                        <span class="accordion-icon" style="color: #00FFA3;">@(section2Open ? "▼" : "▶")</span>
                    </div>
                    @if (section2Open)
                    {
                        <div class="accordion-content">
                            <!-- Analysis Mode and Detail Toggles -->
                            <div style="margin-bottom: 16px; padding: 12px; background: rgba(255, 255, 255, 0.05); border-radius: 8px;">
                                <div style="margin-bottom: 12px;">
                                    <label style="display: block; margin-bottom: 8px; color: rgba(255, 255, 255, 0.8); font-weight: 600;">Analiz Modu:</label>
                                    <div style="display: flex; gap: 8px;">
                                        <button class="btn @(portfolioAnalysisMode == "quick" ? "btn-primary" : "btn-secondary")" 
                                                @onclick='@(() => { portfolioAnalysisMode = "quick"; StateHasChanged(); })'
                                                style="flex: 1;">
                                            ⚡ QUICK
                                        </button>
                                        <button class="btn @(portfolioAnalysisMode == "deep" ? "btn-primary" : "btn-secondary")" 
                                                @onclick='@(() => { portfolioAnalysisMode = "deep"; StateHasChanged(); })'
                                                style="flex: 1;">
                                            🤖 DEEP
                                        </button>
                                    </div>
                                </div>
                                <div>
                                    <label style="display: block; margin-bottom: 8px; color: rgba(255, 255, 255, 0.8); font-weight: 600;">Detay Seviyesi:</label>
                                    <div style="display: flex; gap: 8px;">
                                        <button class="btn @(portfolioDetailLevel == "basic" ? "btn-primary" : "btn-secondary")" 
                                                @onclick='@(() => { portfolioDetailLevel = "basic"; StateHasChanged(); })'
                                                style="flex: 1;">
                                            📋 Basic
                                        </button>
                                        <button class="btn @(portfolioDetailLevel == "detailed" ? "btn-primary" : "btn-secondary")" 
                                                @onclick='@(() => { portfolioDetailLevel = "detailed"; StateHasChanged(); })'
                                                style="flex: 1;">
                                            📊 Detailed
                                        </button>
                                    </div>
                                </div>
                            </div>
                            
                            <button @onclick="AnalyzePortfolio" class="btn btn-primary" disabled="@isAnalyzing">
                                @if (isAnalyzing) { <span>Analiz ediliyor...</span> } else { <span>Portföyü Analiz Et</span> }
                            </button>
                            
                            @if (isAnalyzing)
                            {
                                <div style="margin-top: 16px; padding: 16px; background: rgba(88, 166, 255, 0.1); border: 1px solid rgba(88, 166, 255, 0.3); border-radius: 8px; text-align: center;">
                                    <div style="color: #58a6ff; font-weight: 600;">⏳ Portföy analizi yapılıyor...</div>
                                    <div style="margin-top: 8px; font-size: 0.9rem; color: rgba(255, 255, 255, 0.7);">Lütfen bekleyin</div>
                                </div>
                            }
                            
                            @if (portfolioAnalysis != null && portfolioAnalysis.ContainsKey("success"))
                            {
                                bool isSuccess = portfolioAnalysis["success"].ValueKind == System.Text.Json.JsonValueKind.True;
                                
                                @if (!isSuccess)
                                {
                                    <div class="error-message" style="margin-top: 16px; padding: 12px; background: rgba(248, 81, 73, 0.2); border: 1px solid rgba(248, 81, 73, 0.5); border-radius: 8px; color: #f85149;">
                                        <strong>⚠️ Hata:</strong> 
                                        @if (portfolioAnalysis.ContainsKey("message"))
                                        {
                                            <span>@portfolioAnalysis["message"].GetString()</span>
                                        }
                                        else
                                        {
                                            <span>Portföy analizi alınamadı.</span>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <!-- Analysis Header -->
                                    <div style="margin-top: 16px; padding: 12px; background: rgba(88, 166, 255, 0.1); border-left: 4px solid #58a6ff; border-radius: 4px;">
                                        <div style="display: flex; justify-content: space-between; align-items: center;">
                                            <div>
                                                <strong style="color: #58a6ff;">Analiz Tarihi:</strong>
                                                <span style="color: rgba(255, 255, 255, 0.8); margin-left: 8px;">
                                                    @(portfolioAnalysis.TryGetValue("as_of", out var asOf) && asOf.ValueKind == System.Text.Json.JsonValueKind.String ? asOf.GetString() ?? "-" : "-")
                                                </span>
                                            </div>
                                            <div>
                                                <strong style="color: #58a6ff;">Mod:</strong>
                                                <span style="color: rgba(255, 255, 255, 0.8); margin-left: 8px; text-transform: uppercase;">
                                                    @(portfolioAnalysis.TryGetValue("mode", out var mode) && mode.ValueKind == System.Text.Json.JsonValueKind.String ? mode.GetString() ?? "QUICK" : "QUICK")
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <!-- Mentor Card (Single Source: recommendation OR mentor) -->
                                    @if (portfolioAnalysis.TryGetValue("recommendation", out var recommendationObj) && recommendationObj.ValueKind == System.Text.Json.JsonValueKind.Object)
                                    {
                                        System.Text.Json.JsonElement mentorObj = recommendationObj;
                                        
                                        string mentorDecision = mentorObj.TryGetProperty("decision", out var md) && md.ValueKind == System.Text.Json.JsonValueKind.String ? md.GetString() ?? "HOLD" : 
                                                               (mentorObj.TryGetProperty("action", out var ma) && ma.ValueKind == System.Text.Json.JsonValueKind.String ? ma.GetString() ?? "HOLD" : "HOLD");
                                        int mentorConfidence = mentorObj.TryGetProperty("confidence", out var mc) && mc.ValueKind == System.Text.Json.JsonValueKind.Number ? mc.GetInt32() : 50;
                                        int mentorHorizon = mentorObj.TryGetProperty("horizon_days", out var mh) && mh.ValueKind == System.Text.Json.JsonValueKind.Number ? mh.GetInt32() : 7;
                                        int? mentorReducePct = null;
                                        if (mentorObj.TryGetProperty("reduce_pct", out var mrp) && mrp.ValueKind == System.Text.Json.JsonValueKind.Number)
                                        {
                                            mentorReducePct = mrp.GetInt32();
                                        }
                                        string mentorTitle = mentorObj.TryGetProperty("title_tr", out var mt) && mt.ValueKind == System.Text.Json.JsonValueKind.String ? mt.GetString() ?? "" : "";
                                        string mentorSummary = mentorObj.TryGetProperty("summary_tr", out var ms) && ms.ValueKind == System.Text.Json.JsonValueKind.String ? ms.GetString() ?? "" : "";
                                        
                                        string actionBadgeClass = mentorDecision == "BUY" ? "decision-buy" : mentorDecision == "REDUCE" ? "decision-sell" : "decision-hold";
                                        string actionColor = mentorDecision == "BUY" ? "#3fb950" : mentorDecision == "REDUCE" ? "#f85149" : "#f59e0b";
                                        
                                        string modeText = portfolioAnalysis.TryGetValue("mode", out var modeVar) && modeVar.ValueKind == System.Text.Json.JsonValueKind.String ? modeVar.GetString()?.ToUpper() ?? "QUICK" : "QUICK";
                                        
                                        <div class="analysis-section" style="margin-top: 16px; padding: 16px; background: rgba(255, 255, 255, 0.05); border-radius: 12px; border-left: 4px solid @actionColor;">
                                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
                                                <h4 style="margin: 0;">🎯 Mentor Tavsiyesi (@modeText)</h4>
                                                <div class="decision-badge-large @actionBadgeClass" style="font-size: 1.2rem; padding: 10px 20px; font-weight: 700;">
                                                    @mentorDecision
                                                </div>
                                            </div>
                                            
                                            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(100px, 1fr)); gap: 12px; margin-bottom: 16px;">
                                                <div style="padding: 8px; background: rgba(255, 255, 255, 0.05); border-radius: 6px;">
                                                    <div style="font-size: 0.85rem; color: rgba(255,255,255,0.6);">Güven</div>
                                                    <div style="font-size: 0.95rem; font-weight: 600; color: #ffffff;">%@mentorConfidence</div>
                                                </div>
                                                <div style="padding: 8px; background: rgba(255, 255, 255, 0.05); border-radius: 6px;">
                                                    <div style="font-size: 0.85rem; color: rgba(255,255,255,0.6);">Vade</div>
                                                    <div style="font-size: 0.95rem; font-weight: 600; color: #ffffff;">@mentorHorizon gün</div>
                                                </div>
                                                @if (mentorReducePct.HasValue && mentorReducePct.Value > 0)
                                                {
                                                    <div style="padding: 8px; background: rgba(255, 255, 255, 0.05); border-radius: 6px;">
                                                        <div style="font-size: 0.85rem; color: rgba(255,255,255,0.6);">Oran</div>
                                                        <div style="font-size: 0.95rem; font-weight: 600; color: #ffffff;">%@mentorReducePct.Value</div>
                                                    </div>
                                                }
                                            </div>
                                            
                                            @if (!string.IsNullOrEmpty(mentorTitle))
                                            {
                                                <div style="font-size: 1.1rem; font-weight: 600; color: #ffffff; margin-bottom: 12px;">
                                                    @mentorTitle
                                                </div>
                                            }
                                            
                                            @if (!string.IsNullOrEmpty(mentorSummary))
                                            {
                                                <div style="margin-bottom: 16px; padding: 12px; background: rgba(88, 166, 255, 0.1); border-left: 3px solid #58a6ff; border-radius: 6px;">
                                                    <p style="margin: 0; color: rgba(255, 255, 255, 0.9); line-height: 1.5;">@mentorSummary</p>
                                                </div>
                                            }
                                            
                                            <!-- Plan (actionable items, max 3) -->
                                            @if (mentorObj.TryGetProperty("plan_tr", out var plan) && plan.ValueKind == System.Text.Json.JsonValueKind.Array && plan.GetArrayLength() > 0)
                                            {
                                                <div style="margin-top: 16px;">
                                                    <strong style="color: #ffffff; font-size: 1rem;">Plan:</strong>
                                                    <ul style="margin: 8px 0 0 0; padding-left: 20px; color: rgba(255, 255, 255, 0.9);">
                                                        @{
                                                            int planCount = 0;
                                                            foreach (var planItem in plan.EnumerateArray())
                                                            {
                                                                if (planCount >= 3) break;
                                                                if (planItem.ValueKind == System.Text.Json.JsonValueKind.String)
                                                                {
                                                                    <li style="margin: 6px 0; line-height: 1.5;">@planItem.GetString()</li>
                                                                    planCount++;
                                                                }
                                                            }
                                                        }
                                                    </ul>
                                                </div>
                                            }
                                            
                                            <!-- Triggers (conditions that would change decision, max 3) -->
                                            @if (mentorObj.TryGetProperty("triggers_tr", out var triggers) && triggers.ValueKind == System.Text.Json.JsonValueKind.Array && triggers.GetArrayLength() > 0)
                                            {
                                                <div style="margin-top: 12px;">
                                                    <strong style="color: #f59e0b; font-size: 0.95rem;">Tetikleyiciler:</strong>
                                                    <ul style="margin: 8px 0 0 0; padding-left: 20px; color: rgba(255, 255, 255, 0.8); font-size: 0.9rem;">
                                                        @{
                                                            int triggerCount = 0;
                                                            foreach (var trigger in triggers.EnumerateArray())
                                                            {
                                                                if (triggerCount >= 3) break;
                                                                if (trigger.ValueKind == System.Text.Json.JsonValueKind.String)
                                                                {
                                                                    <li style="margin: 4px 0; font-style: italic;">@trigger.GetString()</li>
                                                                    triggerCount++;
                                                                }
                                                            }
                                                        }
                                                    </ul>
                                                </div>
                                            }
                                            
                                            <!-- Reason Types (Neden Tipleri) -->
                                            @if (mentorObj.TryGetProperty("reason_types", out var reasonTypes) && reasonTypes.ValueKind == System.Text.Json.JsonValueKind.Array && reasonTypes.GetArrayLength() > 0)
                                            {
                                                <div style="margin-top: 16px;">
                                                    <strong style="color: #ffffff; margin-bottom: 8px; display: block;">Nedenler:</strong>
                                                    <div style="display: flex; flex-wrap: wrap; gap: 8px;">
                                                        @foreach (var reasonType in reasonTypes.EnumerateArray())
                                                        {
                                                            if (reasonType.ValueKind == System.Text.Json.JsonValueKind.Object)
                                                            {
                                                                string reasonCode = reasonType.TryGetProperty("code", out var rc) && rc.ValueKind == System.Text.Json.JsonValueKind.String ? rc.GetString() ?? "" : "";
                                                                string reasonLabel = reasonType.TryGetProperty("label_tr", out var rl) && rl.ValueKind == System.Text.Json.JsonValueKind.String ? rl.GetString() ?? "" : "";
                                                                string reasonEvidence = reasonType.TryGetProperty("evidence_tr", out var re) && re.ValueKind == System.Text.Json.JsonValueKind.String ? re.GetString() ?? "" : "";
                                                                double reasonWeight = reasonType.TryGetProperty("weight", out var rw) && rw.ValueKind == System.Text.Json.JsonValueKind.Number ? rw.GetDouble() : 0.0;
                                                                
                                                                // Color based on reason type
                                                                string badgeColor = "#58a6ff"; // Default blue
                                                                if (reasonCode.Contains("PROFIT")) badgeColor = "#3fb950";
                                                                else if (reasonCode.Contains("CONCENTRATION") || reasonCode.Contains("RISK")) badgeColor = "#f85149";
                                                                else if (reasonCode.Contains("VOLATILITY") || reasonCode.Contains("EVENT")) badgeColor = "#f59e0b";
                                                                else if (reasonCode.Contains("MOMENTUM") || reasonCode.Contains("DRAWDOWN")) badgeColor = "#f85149";
                                                                
                                                                <div style="position: relative; display: inline-block;">
                                                                    <span 
                                                                        style="padding: 6px 12px; background: @badgeColor; color: #ffffff; border-radius: 6px; font-size: 0.85rem; font-weight: 600; cursor: help; display: inline-block;"
                                                                        title="@reasonEvidence (Ağırlık: %@(Math.Round(reasonWeight * 100, 0)))">
                                                                        @reasonLabel
                                                                    </span>
                                                                </div>
                                                            }
                                                        }
                                                    </div>
                                                </div>
                                            }
                                            
                                            <!-- Events (Yaklaşan Olaylar) -->
                                            @if (mentorObj.TryGetProperty("events", out var events) && events.ValueKind == System.Text.Json.JsonValueKind.Array && events.GetArrayLength() > 0)
                                            {
                                                <div style="margin-top: 16px; padding: 12px; background: rgba(248, 81, 73, 0.1); border-left: 3px solid #f85149; border-radius: 6px;">
                                                    <strong style="color: #f85149; margin-bottom: 8px; display: block;">📅 Yaklaşan Olaylar:</strong>
                                                    @foreach (var eventItem in events.EnumerateArray())
                                                    {
                                                        if (eventItem.ValueKind == System.Text.Json.JsonValueKind.Object)
                                                        {
                                                            string eventKind = eventItem.TryGetProperty("kind", out var ek) && ek.ValueKind == System.Text.Json.JsonValueKind.String ? ek.GetString() ?? "" : "";
                                                            string eventTitle = eventItem.TryGetProperty("title_tr", out var et) && et.ValueKind == System.Text.Json.JsonValueKind.String ? et.GetString() ?? "" : "";
                                                            string eventImpact = eventItem.TryGetProperty("impact", out var ei) && ei.ValueKind == System.Text.Json.JsonValueKind.String ? ei.GetString() ?? "" : "";
                                                            string eventPlan = eventItem.TryGetProperty("plan_tr", out var ep) && ep.ValueKind == System.Text.Json.JsonValueKind.String ? ep.GetString() ?? "" : "";
                                                            int eventConfidence = eventItem.TryGetProperty("confidence", out var ec) && ec.ValueKind == System.Text.Json.JsonValueKind.Number ? ec.GetInt32() : 50;
                                                            
                                                            string impactColor = "#58a6ff";
                                                            string impactText = "Bilinmiyor";
                                                            if (eventImpact == "UP") { impactColor = "#3fb950"; impactText = "Yukarı"; }
                                                            else if (eventImpact == "DOWN") { impactColor = "#f85149"; impactText = "Aşağı"; }
                                                            else if (eventImpact == "VOLATILE") { impactColor = "#f59e0b"; impactText = "Volatil"; }
                                                            
                                                            <div style="margin-bottom: 12px; padding-bottom: 12px; border-bottom: 1px solid rgba(255, 255, 255, 0.1);">
                                                                <div style="font-weight: 600; color: #ffffff; margin-bottom: 4px;">@eventTitle</div>
                                                                <div style="font-size: 0.85rem; color: rgba(255, 255, 255, 0.7); margin-bottom: 4px;">
                                                                    Beklenen etki: <span style="color: @impactColor; font-weight: 600;">@impactText</span> | Güven: %@eventConfidence
                                                                </div>
                                                                @if (!string.IsNullOrEmpty(eventPlan))
                                                                {
                                                                    <div style="font-size: 0.85rem; color: rgba(255, 255, 255, 0.8); font-style: italic; margin-top: 4px;">Plan: @eventPlan</div>
                                                                }
                                                            </div>
                                                        }
                                                    }
                                                </div>
                                            }
                                            
                                            <!-- Timing (Zamanlama) -->
                                            @if (mentorObj.TryGetProperty("timing_tr", out var timingTr) && timingTr.ValueKind == System.Text.Json.JsonValueKind.String)
                                            {
                                                string timingText = timingTr.GetString() ?? "";
                                                if (!string.IsNullOrEmpty(timingText))
                                                {
                                                    <div style="margin-top: 16px; padding: 12px; background: rgba(88, 166, 255, 0.1); border-left: 3px solid #58a6ff; border-radius: 6px;">
                                                        <strong style="color: #58a6ff; margin-bottom: 8px; display: block;">⏰ Zamanlama Planı:</strong>
                                                        <div style="color: rgba(255, 255, 255, 0.9); font-size: 0.95rem; line-height: 1.6;">@timingText</div>
                                                    </div>
                                                }
                                            }
                                            
                                            <!-- Entry/Re-entry Conditions -->
                                            @if (mentorObj.TryGetProperty("entry_reentry_tr", out var entryReentryTr) && entryReentryTr.ValueKind == System.Text.Json.JsonValueKind.String)
                                            {
                                                string entryText = entryReentryTr.GetString() ?? "";
                                                if (!string.IsNullOrEmpty(entryText))
                                                {
                                                    <div style="margin-top: 12px; padding: 12px; background: rgba(63, 185, 80, 0.1); border-left: 3px solid #3fb950; border-radius: 6px;">
                                                        <strong style="color: #3fb950; margin-bottom: 8px; display: block;">🔄 Tekrar Alım Koşulları:</strong>
                                                        <div style="color: rgba(255, 255, 255, 0.9); font-size: 0.95rem; line-height: 1.6;">@entryText</div>
                                                    </div>
                                                }
                                            }
                                        </div>
                                    }
                                    else if (portfolioAnalysis.TryGetValue("mentor", out var mentorObjFallback) && mentorObjFallback.ValueKind == System.Text.Json.JsonValueKind.Object)
                                    {
                                        System.Text.Json.JsonElement mentorObj = mentorObjFallback;
                                        
                                        string mentorDecision = mentorObj.TryGetProperty("decision", out var md) && md.ValueKind == System.Text.Json.JsonValueKind.String ? md.GetString() ?? "HOLD" : 
                                                               (mentorObj.TryGetProperty("action", out var ma) && ma.ValueKind == System.Text.Json.JsonValueKind.String ? ma.GetString() ?? "HOLD" : "HOLD");
                                        int mentorConfidence = mentorObj.TryGetProperty("confidence", out var mc) && mc.ValueKind == System.Text.Json.JsonValueKind.Number ? mc.GetInt32() : 50;
                                        int mentorHorizon = mentorObj.TryGetProperty("horizon_days", out var mh) && mh.ValueKind == System.Text.Json.JsonValueKind.Number ? mh.GetInt32() : 7;
                                        int? mentorReducePct = null;
                                        if (mentorObj.TryGetProperty("reduce_pct", out var mrp) && mrp.ValueKind == System.Text.Json.JsonValueKind.Number)
                                        {
                                            mentorReducePct = mrp.GetInt32();
                                        }
                                        string mentorTitle = mentorObj.TryGetProperty("title_tr", out var mt) && mt.ValueKind == System.Text.Json.JsonValueKind.String ? mt.GetString() ?? "" : "";
                                        string mentorSummary = mentorObj.TryGetProperty("summary_tr", out var ms) && ms.ValueKind == System.Text.Json.JsonValueKind.String ? ms.GetString() ?? "" : "";
                                        
                                        string actionBadgeClass = mentorDecision == "BUY" ? "decision-buy" : mentorDecision == "REDUCE" ? "decision-sell" : "decision-hold";
                                        string actionColor = mentorDecision == "BUY" ? "#3fb950" : mentorDecision == "REDUCE" ? "#f85149" : "#f59e0b";
                                        
                                        string modeText = portfolioAnalysis.TryGetValue("mode", out var modeVar) && modeVar.ValueKind == System.Text.Json.JsonValueKind.String ? modeVar.GetString()?.ToUpper() ?? "QUICK" : "QUICK";
                                        
                                        <div class="analysis-section" style="margin-top: 16px; padding: 16px; background: rgba(255, 255, 255, 0.05); border-radius: 12px; border-left: 4px solid @actionColor;">
                                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
                                                <h4 style="margin: 0;">🎯 Mentor Tavsiyesi (@modeText)</h4>
                                                <div class="decision-badge-large @actionBadgeClass" style="font-size: 1.2rem; padding: 10px 20px; font-weight: 700;">
                                                    @mentorDecision
                                                </div>
                                            </div>
                                            
                                            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(100px, 1fr)); gap: 12px; margin-bottom: 16px;">
                                                <div style="padding: 8px; background: rgba(255, 255, 255, 0.05); border-radius: 6px;">
                                                    <div style="font-size: 0.85rem; color: rgba(255,255,255,0.6);">Güven</div>
                                                    <div style="font-size: 0.95rem; font-weight: 600; color: #ffffff;">%@mentorConfidence</div>
                                                </div>
                                                <div style="padding: 8px; background: rgba(255, 255, 255, 0.05); border-radius: 6px;">
                                                    <div style="font-size: 0.85rem; color: rgba(255,255,255,0.6);">Vade</div>
                                                    <div style="font-size: 0.95rem; font-weight: 600; color: #ffffff;">@mentorHorizon gün</div>
                                                </div>
                                                @if (mentorReducePct.HasValue && mentorReducePct.Value > 0)
                                                {
                                                    <div style="padding: 8px; background: rgba(255, 255, 255, 0.05); border-radius: 6px;">
                                                        <div style="font-size: 0.85rem; color: rgba(255,255,255,0.6);">Oran</div>
                                                        <div style="font-size: 0.95rem; font-weight: 600; color: #ffffff;">%@mentorReducePct.Value</div>
                                                    </div>
                                                }
                                            </div>
                                            
                                            @if (!string.IsNullOrEmpty(mentorTitle))
                                            {
                                                <div style="font-size: 1.1rem; font-weight: 600; color: #ffffff; margin-bottom: 12px;">
                                                    @mentorTitle
                                                </div>
                                            }
                                            
                                            @if (!string.IsNullOrEmpty(mentorSummary))
                                            {
                                                <div style="margin-bottom: 16px; padding: 12px; background: rgba(88, 166, 255, 0.1); border-left: 3px solid #58a6ff; border-radius: 6px;">
                                                    <p style="margin: 0; color: rgba(255, 255, 255, 0.9); line-height: 1.5;">@mentorSummary</p>
                                                </div>
                                            }
                                            
                                            @if (mentorObj.TryGetProperty("plan_tr", out var plan) && plan.ValueKind == System.Text.Json.JsonValueKind.Array && plan.GetArrayLength() > 0)
                                            {
                                                <div style="margin-top: 16px;">
                                                    <strong style="color: #ffffff; font-size: 1rem;">Plan:</strong>
                                                    <ul style="margin: 8px 0 0 0; padding-left: 20px; color: rgba(255, 255, 255, 0.9);">
                                                        @{
                                                            int planCount = 0;
                                                            foreach (var planItem in plan.EnumerateArray())
                                                            {
                                                                if (planCount >= 3) break;
                                                                if (planItem.ValueKind == System.Text.Json.JsonValueKind.String)
                                                                {
                                                                    <li style="margin: 6px 0; line-height: 1.5;">@planItem.GetString()</li>
                                                                    planCount++;
                                                                }
                                                            }
                                                        }
                                                    </ul>
                                                </div>
                                            }
                                            
                                            @if (mentorObj.TryGetProperty("triggers_tr", out var triggers) && triggers.ValueKind == System.Text.Json.JsonValueKind.Array && triggers.GetArrayLength() > 0)
                                            {
                                                <div style="margin-top: 12px;">
                                                    <strong style="color: #f59e0b; font-size: 0.95rem;">Tetikleyiciler:</strong>
                                                    <ul style="margin: 8px 0 0 0; padding-left: 20px; color: rgba(255, 255, 255, 0.8); font-size: 0.9rem;">
                                                        @{
                                                            int triggerCount = 0;
                                                            foreach (var trigger in triggers.EnumerateArray())
                                                            {
                                                                if (triggerCount >= 3) break;
                                                                if (trigger.ValueKind == System.Text.Json.JsonValueKind.String)
                                                                {
                                                                    <li style="margin: 4px 0; font-style: italic;">@trigger.GetString()</li>
                                                                    triggerCount++;
                                                                }
                                                            }
                                                        }
                                                    </ul>
                                                </div>
                                            }
                                            
                                            @if (mentorObj.TryGetProperty("reason_types", out var reasonTypes) && reasonTypes.ValueKind == System.Text.Json.JsonValueKind.Array && reasonTypes.GetArrayLength() > 0)
                                            {
                                                <div style="margin-top: 16px;">
                                                    <strong style="color: #ffffff; margin-bottom: 8px; display: block;">Nedenler:</strong>
                                                    <div style="display: flex; flex-wrap: wrap; gap: 8px;">
                                                        @foreach (var reasonType in reasonTypes.EnumerateArray())
                                                        {
                                                            if (reasonType.ValueKind == System.Text.Json.JsonValueKind.Object)
                                                            {
                                                                string reasonCode = reasonType.TryGetProperty("code", out var rc) && rc.ValueKind == System.Text.Json.JsonValueKind.String ? rc.GetString() ?? "" : "";
                                                                string reasonLabel = reasonType.TryGetProperty("label_tr", out var rl) && rl.ValueKind == System.Text.Json.JsonValueKind.String ? rl.GetString() ?? "" : "";
                                                                string reasonEvidence = reasonType.TryGetProperty("evidence_tr", out var re) && re.ValueKind == System.Text.Json.JsonValueKind.String ? re.GetString() ?? "" : "";
                                                                double reasonWeight = reasonType.TryGetProperty("weight", out var rw) && rw.ValueKind == System.Text.Json.JsonValueKind.Number ? rw.GetDouble() : 0.0;
                                                                
                                                                string badgeColor = "#58a6ff";
                                                                if (reasonCode.Contains("PROFIT")) badgeColor = "#3fb950";
                                                                else if (reasonCode.Contains("CONCENTRATION") || reasonCode.Contains("RISK")) badgeColor = "#f85149";
                                                                else if (reasonCode.Contains("VOLATILITY") || reasonCode.Contains("EVENT")) badgeColor = "#f59e0b";
                                                                else if (reasonCode.Contains("MOMENTUM") || reasonCode.Contains("DRAWDOWN")) badgeColor = "#f85149";
                                                                
                                                                <div style="position: relative; display: inline-block;">
                                                                    <span 
                                                                        style="padding: 6px 12px; background: @badgeColor; color: #ffffff; border-radius: 6px; font-size: 0.85rem; font-weight: 600; cursor: help; display: inline-block;"
                                                                        title="@reasonEvidence (Ağırlık: %@(Math.Round(reasonWeight * 100, 0)))">
                                                                        @reasonLabel
                                                                    </span>
                                                                </div>
                                                            }
                                                        }
                                                    </div>
                                                </div>
                                            }
                                            
                                            @if (mentorObj.TryGetProperty("events", out var events) && events.ValueKind == System.Text.Json.JsonValueKind.Array && events.GetArrayLength() > 0)
                                            {
                                                <div style="margin-top: 16px; padding: 12px; background: rgba(248, 81, 73, 0.1); border-left: 3px solid #f85149; border-radius: 6px;">
                                                    <strong style="color: #f85149; margin-bottom: 8px; display: block;">📅 Yaklaşan Olaylar:</strong>
                                                    @foreach (var eventItem in events.EnumerateArray())
                                                    {
                                                        if (eventItem.ValueKind == System.Text.Json.JsonValueKind.Object)
                                                        {
                                                            string eventKind = eventItem.TryGetProperty("kind", out var ek) && ek.ValueKind == System.Text.Json.JsonValueKind.String ? ek.GetString() ?? "" : "";
                                                            string eventTitle = eventItem.TryGetProperty("title_tr", out var et) && et.ValueKind == System.Text.Json.JsonValueKind.String ? et.GetString() ?? "" : "";
                                                            string eventImpact = eventItem.TryGetProperty("impact", out var ei) && ei.ValueKind == System.Text.Json.JsonValueKind.String ? ei.GetString() ?? "" : "";
                                                            string eventPlan = eventItem.TryGetProperty("plan_tr", out var ep) && ep.ValueKind == System.Text.Json.JsonValueKind.String ? ep.GetString() ?? "" : "";
                                                            int eventConfidence = eventItem.TryGetProperty("confidence", out var ec) && ec.ValueKind == System.Text.Json.JsonValueKind.Number ? ec.GetInt32() : 50;
                                                            
                                                            string impactColor = "#58a6ff";
                                                            string impactText = "Bilinmiyor";
                                                            if (eventImpact == "UP") { impactColor = "#3fb950"; impactText = "Yukarı"; }
                                                            else if (eventImpact == "DOWN") { impactColor = "#f85149"; impactText = "Aşağı"; }
                                                            else if (eventImpact == "VOLATILE") { impactColor = "#f59e0b"; impactText = "Volatil"; }
                                                            
                                                            <div style="margin-bottom: 12px; padding-bottom: 12px; border-bottom: 1px solid rgba(255, 255, 255, 0.1);">
                                                                <div style="font-weight: 600; color: #ffffff; margin-bottom: 4px;">@eventTitle</div>
                                                                <div style="font-size: 0.85rem; color: rgba(255, 255, 255, 0.7); margin-bottom: 4px;">
                                                                    Beklenen etki: <span style="color: @impactColor; font-weight: 600;">@impactText</span> | Güven: %@eventConfidence
                                                                </div>
                                                                @if (!string.IsNullOrEmpty(eventPlan))
                                                                {
                                                                    <div style="font-size: 0.85rem; color: rgba(255, 255, 255, 0.8); font-style: italic; margin-top: 4px;">Plan: @eventPlan</div>
                                                                }
                                                            </div>
                                                        }
                                                    }
                                                </div>
                                            }
                                            
                                            @if (mentorObj.TryGetProperty("timing_tr", out var timingTr) && timingTr.ValueKind == System.Text.Json.JsonValueKind.String)
                                            {
                                                string timingText = timingTr.GetString() ?? "";
                                                if (!string.IsNullOrEmpty(timingText))
                                                {
                                                    <div style="margin-top: 16px; padding: 12px; background: rgba(88, 166, 255, 0.1); border-left: 3px solid #58a6ff; border-radius: 6px;">
                                                        <strong style="color: #58a6ff; margin-bottom: 8px; display: block;">⏰ Zamanlama Planı:</strong>
                                                        <div style="color: rgba(255, 255, 255, 0.9); font-size: 0.95rem; line-height: 1.6;">@timingText</div>
                                                    </div>
                                                }
                                            }
                                            
                                            @if (mentorObj.TryGetProperty("entry_reentry_tr", out var entryReentryTr) && entryReentryTr.ValueKind == System.Text.Json.JsonValueKind.String)
                                            {
                                                string entryText = entryReentryTr.GetString() ?? "";
                                                if (!string.IsNullOrEmpty(entryText))
                                                {
                                                    <div style="margin-top: 12px; padding: 12px; background: rgba(63, 185, 80, 0.1); border-left: 3px solid #3fb950; border-radius: 6px;">
                                                        <strong style="color: #3fb950; margin-bottom: 8px; display: block;">🔄 Tekrar Alım Koşulları:</strong>
                                                        <div style="color: rgba(255, 255, 255, 0.9); font-size: 0.95rem; line-height: 1.6;">@entryText</div>
                                                    </div>
                                                }
                                            }
                                        </div>
                                    }
                                    
                                    <!-- Quick Actions (Derived from positions table - Max 4, prioritized by action != HOLD, then by risk/concentration) -->
                                    @if (portfolioAnalysis.TryGetValue("positions", out var positionsForQuick) && positionsForQuick.ValueKind == System.Text.Json.JsonValueKind.Array && positionsForQuick.GetArrayLength() > 0)
                                    {
                                        var quickActionsFromTable = new List<System.Text.Json.JsonElement>();
                                        
                                        // First: Collect non-HOLD actions (max 4)
                                        foreach (var pos in positionsForQuick.EnumerateArray())
                                        {
                                            if (pos.ValueKind == System.Text.Json.JsonValueKind.Object && quickActionsFromTable.Count < 4)
                                            {
                                                string posAction = pos.TryGetProperty("action", out var pa) && pa.ValueKind == System.Text.Json.JsonValueKind.String ? pa.GetString() ?? "HOLD" : "HOLD";
                                                if (posAction != "HOLD")
                                                {
                                                    quickActionsFromTable.Add(pos);
                                                }
                                            }
                                        }
                                        
                                        // Fallback: If no non-HOLD actions or less than 4, add highest risk/concentration positions
                                        if (quickActionsFromTable.Count < 4)
                                        {
                                            var remainingPositions = new List<(System.Text.Json.JsonElement pos, double priority)>();
                                            foreach (var pos in positionsForQuick.EnumerateArray())
                                            {
                                                if (pos.ValueKind == System.Text.Json.JsonValueKind.Object)
                                                {
                                                    string posAction = pos.TryGetProperty("action", out var pa) && pa.ValueKind == System.Text.Json.JsonValueKind.String ? pa.GetString() ?? "HOLD" : "HOLD";
                                                    if (posAction == "HOLD") // Only consider HOLD positions for fallback
                                                    {
                                                        double weight = pos.TryGetProperty("weight_pct", out var pw) && pw.ValueKind == System.Text.Json.JsonValueKind.Number ? pw.GetDouble() : 0;
                                                        double pnl = pos.TryGetProperty("pnl_pct", out var pp) && pp.ValueKind == System.Text.Json.JsonValueKind.Number ? Math.Abs(pp.GetDouble()) : 0;
                                                        string riskTag = pos.TryGetProperty("risk_tag", out var prt) && prt.ValueKind == System.Text.Json.JsonValueKind.String ? prt.GetString() ?? "LOW" : "LOW";
                                                        
                                                        // Priority: high weight (concentration) + high risk + high abs(pnl)
                                                        double priority = (weight * 0.5) + (pnl * 0.2) + (riskTag == "HIGH" ? 30 : riskTag == "MED" ? 15 : 0);
                                                        remainingPositions.Add((pos, priority));
                                                    }
                                                }
                                            }
                                            
                                            // Sort by priority descending and add top positions
                                            remainingPositions.Sort((a, b) => b.priority.CompareTo(a.priority));
                                            foreach (var (pos, _) in remainingPositions)
                                            {
                                                if (quickActionsFromTable.Count >= 4) break;
                                                quickActionsFromTable.Add(pos);
                                            }
                                        }
                                        
                                        @if (quickActionsFromTable.Count > 0)
                                        {
                                            <div class="analysis-section" style="margin-top: 16px;">
                                                <h4>⚡ Öne Çıkan Aksiyonlar</h4>
                                                <div style="display: grid; gap: 8px;">
                                                    @foreach (var action in quickActionsFromTable)
                                                    {
                                                        string symbol = action.TryGetProperty("symbol", out var asym) && asym.ValueKind == System.Text.Json.JsonValueKind.String ? asym.GetString() ?? "-" : "-";
                                                        string actionType = action.TryGetProperty("action", out var aact) && aact.ValueKind == System.Text.Json.JsonValueKind.String ? aact.GetString() ?? "HOLD" : "HOLD";
                                                        int actionPct = action.TryGetProperty("action_pct", out var apct) && apct.ValueKind == System.Text.Json.JsonValueKind.Number ? apct.GetInt32() : 0;
                                                        int horizon = action.TryGetProperty("horizon_days", out var ahor) && ahor.ValueKind == System.Text.Json.JsonValueKind.Number ? ahor.GetInt32() : 7;
                                                        string mentorNote = action.TryGetProperty("mentor_note_tr", out var amn) && amn.ValueKind == System.Text.Json.JsonValueKind.String ? amn.GetString() ?? "" : "";
                                                        
                                                        string actionColor = actionType == "BUY" ? "#3fb950" : actionType == "REDUCE" ? "#f85149" : "#f59e0b";
                                                        
                                                        <div style="padding: 12px; background: rgba(255, 255, 255, 0.05); border-left: 3px solid @actionColor; border-radius: 4px;">
                                                            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px;">
                                                                <div style="flex: 1;">
                                                                    <strong style="color: #ffffff; font-size: 1.1rem;">@symbol</strong>
                                                                    <span style="color: @actionColor; font-weight: 600; margin-left: 8px;">@actionType</span>
                                                                    @if (actionPct > 0)
                                                                    {
                                                                        <span style="color: rgba(255, 255, 255, 0.7); margin-left: 8px;">(%@actionPct, @horizon gün)</span>
                                                                    }
                                                                    else
                                                                    {
                                                                        <span style="color: rgba(255, 255, 255, 0.7); margin-left: 8px;">(@horizon gün)</span>
                                                                    }
                                                                </div>
                                                                <div style="color: rgba(255, 255, 255, 0.8); font-size: 0.9rem;">
                                                                    → @mentorNote
                                                                </div>
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    }
                                    
                                    <!-- Risk Summary -->
                                    @if (portfolioAnalysis.TryGetValue("risk", out var riskObj) && riskObj.ValueKind == System.Text.Json.JsonValueKind.Object)
                                    {
                                        <div class="analysis-section" style="margin-top: 16px;">
                                            <h4>⚠️ Risk Analizi</h4>
                                            
                                            @if (riskObj.TryGetProperty("concentration", out var conc) && conc.ValueKind == System.Text.Json.JsonValueKind.Object)
                                            {
                                                bool concFlag = conc.TryGetProperty("flag", out var cf) && cf.ValueKind == System.Text.Json.JsonValueKind.True;
                                                string concNote = conc.TryGetProperty("note_tr", out var cn) && cn.ValueKind == System.Text.Json.JsonValueKind.String ? cn.GetString() ?? "" : "";
                                                <div style="padding: 8px; margin: 4px 0; background: rgba(255, 255, 255, 0.05); border-radius: 4px;">
                                                    <strong>Konsantrasyon Riski:</strong> @(concFlag ? "⚠️ YÜKSEK" : "✅ DÜŞÜK")
                                                    <p style="margin: 4px 0 0 0; font-size: 0.9rem;">@concNote</p>
                                                </div>
                                            }
                                            
                                            @if (riskObj.TryGetProperty("volatility", out var vol) && vol.ValueKind == System.Text.Json.JsonValueKind.Object)
                                            {
                                                bool volFlag = vol.TryGetProperty("flag", out var vf) && vf.ValueKind == System.Text.Json.JsonValueKind.True;
                                                string volNote = vol.TryGetProperty("note_tr", out var vn) && vn.ValueKind == System.Text.Json.JsonValueKind.String ? vn.GetString() ?? "" : "";
                                                <div style="padding: 8px; margin: 4px 0; background: rgba(255, 255, 255, 0.05); border-radius: 4px;">
                                                    <strong>Volatilite Riski:</strong> @(volFlag ? "⚠️ YÜKSEK" : "✅ DÜŞÜK")
                                                    <p style="margin: 4px 0 0 0; font-size: 0.9rem;">@volNote</p>
                                                </div>
                                            }
                                            
                                            @if (riskObj.TryGetProperty("news", out var newsRisk) && newsRisk.ValueKind == System.Text.Json.JsonValueKind.Object)
                                            {
                                                string newsNote = newsRisk.TryGetProperty("note_tr", out var nn) && nn.ValueKind == System.Text.Json.JsonValueKind.String ? nn.GetString() ?? "" : "";
                                                <div style="padding: 8px; margin: 4px 0; background: rgba(255, 255, 255, 0.05); border-radius: 4px;">
                                                    <strong>Haber Riski:</strong>
                                                    <p style="margin: 4px 0 0 0; font-size: 0.9rem;">@newsNote</p>
                                                </div>
                                            }
                                        </div>
                                    }
                                    
                                    
                                    <!-- Portfolio Summary Stats -->
                                    @if (portfolioAnalysis.TryGetValue("portfolio", out var portfolio) && portfolio.ValueKind == System.Text.Json.JsonValueKind.Object)
                                    {
                                        double totalVal = portfolio.TryGetProperty("total_value", out var tv) && tv.ValueKind == System.Text.Json.JsonValueKind.Number ? tv.GetDouble() : 0;
                                        double totalPnL = portfolio.TryGetProperty("total_pnl", out var tp) && tp.ValueKind == System.Text.Json.JsonValueKind.Number ? tp.GetDouble() : 0;
                                        double totalPnLPct = portfolio.TryGetProperty("total_pnl_percent", out var tpp) && tpp.ValueKind == System.Text.Json.JsonValueKind.Number ? tpp.GetDouble() : 0;
                                        int holdingsCnt = portfolio.TryGetProperty("holdings_count", out var hc) && hc.ValueKind == System.Text.Json.JsonValueKind.Number ? hc.GetInt32() : 0;
                                        
                                        <div class="analysis-section" style="margin-top: 16px;">
                                            <h4>📊 Portföy Özeti</h4>
                                            <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; margin-top: 8px;">
                                                <div style="padding: 12px; background: rgba(255, 255, 255, 0.05); border-radius: 8px;">
                                                    <div style="font-size: 0.85rem; color: rgba(255,255,255,0.6);">Toplam Değer</div>
                                                    <div style="font-size: 1.2rem; font-weight: 600; color: #ffffff;">$@FormatCurrency(totalVal)</div>
                                                </div>
                                                <div style="padding: 12px; background: rgba(255, 255, 255, 0.05); border-radius: 8px;">
                                                    <div style="font-size: 0.85rem; color: rgba(255,255,255,0.6);">Toplam P/L</div>
                                                    <div style="font-size: 1.2rem; font-weight: 600; color: @(totalPnL >= 0 ? "#3fb950" : "#f85149");">
                                                        $@FormatCurrency(totalPnL) (@totalPnLPct.ToString("F2")%)
                                                    </div>
                                                </div>
                                                <div style="padding: 12px; background: rgba(255, 255, 255, 0.05); border-radius: 8px;">
                                                    <div style="font-size: 0.85rem; color: rgba(255,255,255,0.6);">Pozisyon Sayısı</div>
                                                    <div style="font-size: 1.2rem; font-weight: 600; color: #ffffff;">@holdingsCnt</div>
                                                </div>
                                                <div style="padding: 12px; background: rgba(255, 255, 255, 0.05); border-radius: 8px;">
                                                    <div style="font-size: 0.85rem; color: rgba(255,255,255,0.6);">Analiz Modu</div>
                                                    <div style="font-size: 1.2rem; font-weight: 600; color: #58a6ff;">
                                                        @(portfolioAnalysis.TryGetValue("mode", out var mode2) && mode2.ValueKind == System.Text.Json.JsonValueKind.String ? mode2.GetString()?.ToUpper() ?? "QUICK" : "QUICK")
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                    
                                    <!-- Stress Test (NEW: mentorized, with explanation) -->
                                    @if (portfolioAnalysis.TryGetValue("stress_test", out var stressTest) && stressTest.ValueKind == System.Text.Json.JsonValueKind.Object)
                                    {
                                        <div class="analysis-section" style="margin-top: 16px;">
                                            <h4>📉 Stres Testi (Şok Senaryosu)</h4>
                                            <p style="font-size: 0.9rem; color: rgba(255, 255, 255, 0.7); margin-bottom: 12px;">
                                                Bu tablo, seçili şoklarda portföyün yaklaşık kaybını gösterir. Amaç: kırılganlığı görmek ve risk planını netleştirmek.
                                            </p>
                                            
                                            @if (stressTest.TryGetProperty("rows", out var stressRows) && stressRows.ValueKind == System.Text.Json.JsonValueKind.Array && stressRows.GetArrayLength() > 0)
                                            {
                                                <div style="overflow-x: auto; margin-top: 12px;">
                                                    <table style="width: 100%; border-collapse: collapse;">
                                                        <thead>
                                                            <tr style="background: rgba(255, 255, 255, 0.05); border-bottom: 1px solid rgba(255, 255, 255, 0.1);">
                                                                <th style="padding: 10px; text-align: left; color: #ffffff; font-weight: 600;">Senaryo</th>
                                                                <th style="padding: 10px; text-align: right; color: #ffffff; font-weight: 600;">Tahmini P/L (USD)</th>
                                                                <th style="padding: 10px; text-align: right; color: #ffffff; font-weight: 600;">Portföy Etkisi %</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            @foreach (var row in stressRows.EnumerateArray())
                                                            {
                                                                if (row.ValueKind == System.Text.Json.JsonValueKind.Object)
                                                                {
                                                                    string scenario = row.TryGetProperty("scenario", out var rs) && rs.ValueKind == System.Text.Json.JsonValueKind.String ? rs.GetString() ?? "-" : "-";
                                                                    double impactUsd = row.TryGetProperty("impact_usd", out var riu) && riu.ValueKind == System.Text.Json.JsonValueKind.Number ? riu.GetDouble() : 0;
                                                                    double impactPct = row.TryGetProperty("impact_pct", out var rip) && rip.ValueKind == System.Text.Json.JsonValueKind.Number ? rip.GetDouble() : 0;
                                                                    
                                                                    <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.05);">
                                                                        <td style="padding: 10px; color: #ffffff; font-weight: 600;">@scenario</td>
                                                                        <td style="padding: 10px; text-align: right; color: @(impactUsd < 0 ? "#f85149" : "#3fb950"); font-weight: 600;">
                                                                            $@FormatCurrency(Math.Abs(impactUsd))
                                                                        </td>
                                                                        <td style="padding: 10px; text-align: right; color: @(impactPct < 0 ? "#f85149" : "#3fb950"); font-weight: 600;">
                                                                            @impactPct.ToString("F2")%
                                                                        </td>
                                                                    </tr>
                                                                }
                                                            }
                                                        </tbody>
                                                    </table>
                                                </div>
                                            }
                                            
                                            @if (stressTest.TryGetProperty("worst_case", out var worstCase) && worstCase.ValueKind == System.Text.Json.JsonValueKind.Object)
                                            {
                                                double worstImpactUsd = worstCase.TryGetProperty("impact_usd", out var wiu) && wiu.ValueKind == System.Text.Json.JsonValueKind.Number ? wiu.GetDouble() : 0;
                                                double worstImpactPct = worstCase.TryGetProperty("impact_pct", out var wip) && wip.ValueKind == System.Text.Json.JsonValueKind.Number ? wip.GetDouble() : 0;
                                                string worstDriver = worstCase.TryGetProperty("driver", out var wd) && wd.ValueKind == System.Text.Json.JsonValueKind.String ? wd.GetString() ?? "-" : "-";
                                                
                                                <div style="margin-top: 16px; padding: 12px; background: rgba(248, 81, 73, 0.15); border-left: 4px solid #f85149; border-radius: 8px;">
                                                    <strong style="color: #f85149;">⚠️ En Kötü Senaryo:</strong>
                                                    <div style="margin-top: 8px; display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px;">
                                                        <div>
                                                            <div style="font-size: 0.85rem; color: rgba(255,255,255,0.6);">Tahmini Kayıp</div>
                                                            <div style="font-size: 1.1rem; font-weight: 600; color: #f85149;">$@FormatCurrency(Math.Abs(worstImpactUsd))</div>
                                                        </div>
                                                        <div>
                                                            <div style="font-size: 0.85rem; color: rgba(255,255,255,0.6);">Portföy Etkisi</div>
                                                            <div style="font-size: 1.1rem; font-weight: 600; color: #f85149;">@worstImpactPct.ToString("F2")%</div>
                                                        </div>
                                                    </div>
                                                    <div style="margin-top: 8px; font-size: 0.9rem; color: rgba(255, 255, 255, 0.8);">
                                                        <strong>Kaynak:</strong> @worstDriver
                                                    </div>
                                                </div>
                                            }
                                            
                                            @if (stressTest.TryGetProperty("action_tr", out var actionTr) && actionTr.ValueKind == System.Text.Json.JsonValueKind.String)
                                            {
                                                string actionText = actionTr.GetString() ?? "";
                                                if (!string.IsNullOrEmpty(actionText))
                                                {
                                                    <div style="margin-top: 12px; padding: 10px; background: rgba(245, 158, 11, 0.1); border-left: 4px solid #f59e0b; border-radius: 8px;">
                                                        <strong style="color: #f59e0b;">⚡ Aksiyon:</strong>
                                                        <p style="margin: 4px 0 0 0; color: rgba(255, 255, 255, 0.9);">@actionText</p>
                                                    </div>
                                                }
                                            }
                                        </div>
                                    }
                                    else if (portfolioAnalysis.TryGetValue("scenarios", out var scenarios) && scenarios.ValueKind == System.Text.Json.JsonValueKind.Array && scenarios.GetArrayLength() > 0)
                                    {
                                        <!-- Fallback to old scenarios format -->
                                        <div class="analysis-section" style="margin-top: 16px;">
                                            <h4>📉 Senaryo Analizi</h4>
                                            <p style="font-size: 0.9rem; color: rgba(255, 255, 255, 0.7); margin-bottom: 12px;">
                                                En büyük 3 pozisyonda -5% ve -10% şok senaryolarının portföy etkisi:
                                            </p>
                                            <div style="display: grid; gap: 8px;">
                                                @foreach (var scenario in scenarios.EnumerateArray())
                                                {
                                                    string symbol = scenario.TryGetProperty("symbol", out var sym) && sym.ValueKind == System.Text.Json.JsonValueKind.String ? sym.GetString() ?? "-" : "-";
                                                    double shock = scenario.TryGetProperty("shock", out var sh) && sh.ValueKind == System.Text.Json.JsonValueKind.Number ? sh.GetDouble() : 0;
                                                    double impactUsd = scenario.TryGetProperty("portfolio_impact_usd", out var iu) && iu.ValueKind == System.Text.Json.JsonValueKind.Number ? iu.GetDouble() : 0;
                                                    double impactPct = scenario.TryGetProperty("portfolio_impact_pct", out var ip) && ip.ValueKind == System.Text.Json.JsonValueKind.Number ? ip.GetDouble() : 0;
                                                    
                                                    <div style="padding: 10px; background: rgba(255, 255, 255, 0.05); border-left: 3px solid @(shock < 0 ? "#f85149" : "#3fb950"); border-radius: 4px;">
                                                        <div style="display: flex; justify-content: space-between; align-items: center;">
                                                            <div>
                                                                <strong style="color: #ffffff;">@symbol</strong>
                                                                <span style="color: rgba(255, 255, 255, 0.7); margin-left: 8px;">@(shock * 100)%</span>
                                                            </div>
                                                            <div style="text-align: right;">
                                                                <div style="color: @(impactUsd < 0 ? "#f85149" : "#3fb950"); font-weight: 600;">
                                                                    $@FormatCurrency(Math.Abs(impactUsd))
                                                                </div>
                                                                <div style="font-size: 0.85rem; color: rgba(255, 255, 255, 0.6);">
                                                                    (@impactPct.ToString("F2")% portföy etkisi)
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                    
                                    <!-- Positions Table (NEW: unified, single source, new format) -->
                                    @if (portfolioAnalysis.TryGetValue("positions", out var positions) && positions.ValueKind == System.Text.Json.JsonValueKind.Array && positions.GetArrayLength() > 0)
                                    {
                                        <div class="analysis-section" style="margin-top: 16px;">
                                            <h4>📊 Pozisyonlar</h4>
                                            <div style="overflow-x: auto;">
                                                <table style="width: 100%; border-collapse: collapse; margin-top: 8px;">
                                                    <thead>
                                                        <tr style="background: rgba(255, 255, 255, 0.05); border-bottom: 1px solid rgba(255, 255, 255, 0.1);">
                                                            <th style="padding: 10px; text-align: left; color: #ffffff; font-weight: 600;">Sembol</th>
                                                            <th style="padding: 10px; text-align: right; color: #ffffff; font-weight: 600;">Ağırlık %</th>
                                                            <th style="padding: 10px; text-align: right; color: #ffffff; font-weight: 600;">P/L %</th>
                                                            <th style="padding: 10px; text-align: right; color: #ffffff; font-weight: 600;">RSI</th>
                                                            <th style="padding: 10px; text-align: center; color: #ffffff; font-weight: 600;">Vol</th>
                                                            <th style="padding: 10px; text-align: center; color: #ffffff; font-weight: 600;">Risk</th>
                                                            <th style="padding: 10px; text-align: center; color: #ffffff; font-weight: 600;">Aksiyon</th>
                                                            <th style="padding: 10px; text-align: left; color: #ffffff; font-weight: 600;">Mentor Notu</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var pos in positions.EnumerateArray())
                                                        {
                                                            if (pos.ValueKind == System.Text.Json.JsonValueKind.Object)
                                                            {
                                                                string symbol = pos.TryGetProperty("symbol", out var psym) && psym.ValueKind == System.Text.Json.JsonValueKind.String ? psym.GetString() ?? "-" : "-";
                                                                double weight = pos.TryGetProperty("weight_pct", out var pw) && pw.ValueKind == System.Text.Json.JsonValueKind.Number ? pw.GetDouble() : 0;
                                                                double pnl = pos.TryGetProperty("pnl_pct", out var pp) && pp.ValueKind == System.Text.Json.JsonValueKind.Number ? pp.GetDouble() : 0;
                                                                string rsiStr = "-";
                                                                if (pos.TryGetProperty("rsi", out var pr))
                                                                {
                                                                    if (pr.ValueKind == System.Text.Json.JsonValueKind.Number)
                                                                    {
                                                                        rsiStr = pr.GetDouble().ToString("F1");
                                                                    }
                                                                    else if (pr.ValueKind == System.Text.Json.JsonValueKind.Null)
                                                                    {
                                                                        rsiStr = "-";
                                                                    }
                                                                }
                                                                string volTag = pos.TryGetProperty("vol_tag", out var pvt) && pvt.ValueKind == System.Text.Json.JsonValueKind.String ? pvt.GetString() ?? "LOW" : 
                                                                              (pos.TryGetProperty("vol_flag", out var pvf) && pvf.ValueKind == System.Text.Json.JsonValueKind.String ? pvf.GetString() ?? "LOW" : "LOW");
                                                                string riskTag = pos.TryGetProperty("risk_tag", out var prt) && prt.ValueKind == System.Text.Json.JsonValueKind.String ? prt.GetString() ?? "LOW" : 
                                                                               (pos.TryGetProperty("risk_label_tr", out var prl) && prl.ValueKind == System.Text.Json.JsonValueKind.String ? prl.GetString() ?? "LOW" : "LOW");
                                                                string action = pos.TryGetProperty("action", out var pa) && pa.ValueKind == System.Text.Json.JsonValueKind.String ? pa.GetString() ?? "HOLD" : 
                                                                               (pos.TryGetProperty("mentor_action", out var pma) && pma.ValueKind == System.Text.Json.JsonValueKind.String ? pma.GetString() ?? "HOLD" : "HOLD");
                                                                int actionPct = pos.TryGetProperty("action_pct", out var pap) && pap.ValueKind == System.Text.Json.JsonValueKind.Number ? pap.GetInt32() : 
                                                                               (pos.TryGetProperty("mentor_allocation_pct", out var pma2) && pma2.ValueKind == System.Text.Json.JsonValueKind.Number ? pma2.GetInt32() : 0);
                                                                int horizonDays = pos.TryGetProperty("horizon_days", out var phd) && phd.ValueKind == System.Text.Json.JsonValueKind.Number ? phd.GetInt32() : 7;
                                                                string mentorNote = pos.TryGetProperty("mentor_note_tr", out var pmn) && pmn.ValueKind == System.Text.Json.JsonValueKind.String ? pmn.GetString() ?? "" : "";
                                                                
                                                                string volColor = volTag == "HIGH" ? "#f85149" : volTag == "MED" ? "#f59e0b" : "#3fb950";
                                                                string riskColor = riskTag == "HIGH" ? "#f85149" : riskTag == "MED" ? "#f59e0b" : "#3fb950";
                                                                string actionColor = action == "BUY" ? "#3fb950" : action == "REDUCE" ? "#f85149" : "#f59e0b";
                                                                
                                                                // Get reason_types and events for this position
                                                                var posReasonTypes = new List<System.Text.Json.JsonElement>();
                                                                var posEvents = new List<System.Text.Json.JsonElement>();
                                                                if (pos.TryGetProperty("reason_types", out var prtReasonTypes) && prtReasonTypes.ValueKind == System.Text.Json.JsonValueKind.Array)
                                                                {
                                                                    foreach (var rt in prtReasonTypes.EnumerateArray())
                                                                    {
                                                                        posReasonTypes.Add(rt);
                                                                    }
                                                                }
                                                                if (pos.TryGetProperty("events", out var pev) && pev.ValueKind == System.Text.Json.JsonValueKind.Array)
                                                                {
                                                                    foreach (var ev in pev.EnumerateArray())
                                                                    {
                                                                        posEvents.Add(ev);
                                                                    }
                                                                }
                                                                
                                                                <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.05);">
                                                                    <td style="padding: 10px; color: #ffffff; font-weight: 600;">@symbol</td>
                                                                    <td style="padding: 10px; text-align: right; color: rgba(255, 255, 255, 0.8);">@weight.ToString("F1")%</td>
                                                                    <td style="padding: 10px; text-align: right; color: @(pnl >= 0 ? "#3fb950" : "#f85149"); font-weight: @(Math.Abs(pnl) >= 10 ? "600" : "400");">@pnl.ToString("F1")%</td>
                                                                    <td style="padding: 10px; text-align: right; color: rgba(255, 255, 255, 0.8);">@rsiStr</td>
                                                                    <td style="padding: 10px; text-align: center;">
                                                                        <span style="color: @volColor; font-weight: 600; font-size: 0.85rem;">@volTag</span>
                                                                    </td>
                                                                    <td style="padding: 10px; text-align: center;">
                                                                        <span style="color: @riskColor; font-weight: 600; font-size: 0.85rem;">@riskTag</span>
                                                                    </td>
                                                                    <td style="padding: 10px; text-align: center;">
                                                                        <span style="color: @actionColor; font-weight: 600; font-size: 0.9rem;">@action</span>
                                                                        @if (actionPct > 0)
                                                                        {
                                                                            <span style="color: rgba(255, 255, 255, 0.7); font-size: 0.8rem;">(%@actionPct, @horizonDays gün)</span>
                                                                        }
                                                                    </td>
                                                                    <td style="padding: 10px; color: rgba(255, 255, 255, 0.8); font-size: 0.9rem; line-height: 1.4;">
                                                                        @mentorNote
                                                                        @if (posReasonTypes.Count > 0 || posEvents.Count > 0)
                                                                        {
                                                                            <div style="margin-top: 8px;">
                                                                                @if (posReasonTypes.Count > 0)
                                                                                {
                                                                                    <div style="display: flex; flex-wrap: wrap; gap: 4px; margin-bottom: 4px;">
                                                                                        @foreach (var rt in posReasonTypes)
                                                                                        {
                                                                                            if (rt.ValueKind == System.Text.Json.JsonValueKind.Object)
                                                                                            {
                                                                                                string rtLabel = rt.TryGetProperty("label_tr", out var rtl) && rtl.ValueKind == System.Text.Json.JsonValueKind.String ? rtl.GetString() ?? "" : "";
                                                                                                string rtEvidence = rt.TryGetProperty("evidence_tr", out var rte) && rte.ValueKind == System.Text.Json.JsonValueKind.String ? rte.GetString() ?? "" : "";
                                                                                                string rtCode = rt.TryGetProperty("code", out var rtc) && rtc.ValueKind == System.Text.Json.JsonValueKind.String ? rtc.GetString() ?? "" : "";
                                                                                                
                                                                                                string rtColor = "#58a6ff";
                                                                                                if (rtCode.Contains("PROFIT")) rtColor = "#3fb950";
                                                                                                else if (rtCode.Contains("CONCENTRATION") || rtCode.Contains("RISK")) rtColor = "#f85149";
                                                                                                else if (rtCode.Contains("VOLATILITY") || rtCode.Contains("EVENT")) rtColor = "#f59e0b";
                                                                                                
                                                                                                <span 
                                                                                                    style="padding: 3px 8px; background: @rtColor; color: #ffffff; border-radius: 4px; font-size: 0.75rem; font-weight: 500; cursor: help;"
                                                                                                    title="@rtEvidence">
                                                                                                    @rtLabel
                                                                                                </span>
                                                                                            }
                                                                                        }
                                                                                    </div>
                                                                                }
                                                                                @if (posEvents.Count > 0)
                                                                                {
                                                                                    <div style="font-size: 0.8rem; color: rgba(248, 81, 73, 0.9); margin-top: 4px;">
                                                                                        📅 @foreach (var ev in posEvents)
                                                                                        {
                                                                                            if (ev.ValueKind == System.Text.Json.JsonValueKind.Object)
                                                                                            {
                                                                                                string evTitle = ev.TryGetProperty("title_tr", out var evt) && evt.ValueKind == System.Text.Json.JsonValueKind.String ? evt.GetString() ?? "" : "";
                                                                                                <span>@evTitle</span>
                                                                                                break; // Show only first event
                                                                                            }
                                                                                        }
                                                                                    </div>
                                                                                }
                                                                            </div>
                                                                        }
                                                                    </td>
                                                                </tr>
                                                            }
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    }
                                }
                            }
                            else if (portfolioAnalysis != null)
                            {
                                <!-- Fallback: Show raw response if structure is unexpected -->
                                <div style="margin-top: 16px; padding: 12px; background: rgba(248, 81, 73, 0.1); border: 1px solid rgba(248, 81, 73, 0.3); border-radius: 8px;">
                                    <strong style="color: #f85149;">⚠️ Beklenmeyen yanıt formatı</strong>
                                    <p style="margin-top: 8px; font-size: 0.9rem; color: rgba(255, 255, 255, 0.7);">
                                        Yanıt alındı ancak beklenen yapıda değil. Lütfen konsolu kontrol edin.
                                    </p>
                                    <details style="margin-top: 8px;">
                                        <summary style="cursor: pointer; color: #58a6ff;">Yanıt detayları (debug)</summary>
                                        <pre style="margin-top: 8px; padding: 8px; background: rgba(0, 0, 0, 0.3); border-radius: 4px; font-size: 0.8rem; overflow-x: auto;">
@string.Join(", ", portfolioAnalysis.Keys)
                                        </pre>
                                    </details>
                                </div>
                            }
                        </div>
                    }
                </div>

                <!-- Section 3: Backtest Results -->
                <div class="accordion-item">
                    <div class="accordion-header" @onclick="() => ToggleSection(3)">
                        <h3>📈 Simülasyon (Backtest) Sonuçları</h3>
                        <span class="accordion-icon">@(section3Open ? "▼" : "▶")</span>
                    </div>
                    @if (section3Open)
                    {
                        <div class="accordion-content">
                            <button @onclick="RunBacktest" class="btn btn-primary" disabled="@isBacktesting">
                                @if (isBacktesting) { <span>Hesaplanıyor...</span> } else { <span>Backtest Çalıştır (1 Aylık)</span> }
                            </button>
                            
                            @if (backtestResult != null)
                            {
                                double portfolioReturn = 0;
                                double sp500Return = 0;
                                double outperformance = 0;
                                string portfolioClass = "negative";
                                string outperfClass = "negative";
                                
                                if (backtestResult.ContainsKey("portfolio_return") && backtestResult["portfolio_return"].ValueKind == System.Text.Json.JsonValueKind.Number)
                                {
                                    portfolioReturn = backtestResult["portfolio_return"].GetDouble();
                                    portfolioClass = portfolioReturn >= 0 ? "positive" : "negative";
                                }
                                
                                if (backtestResult.ContainsKey("sp500_return") && backtestResult["sp500_return"].ValueKind == System.Text.Json.JsonValueKind.Number)
                                {
                                    sp500Return = backtestResult["sp500_return"].GetDouble();
                                }
                                
                                if (backtestResult.ContainsKey("outperformance") && backtestResult["outperformance"].ValueKind == System.Text.Json.JsonValueKind.Number)
                                {
                                    outperformance = backtestResult["outperformance"].GetDouble();
                                    outperfClass = outperformance >= 0 ? "positive" : "negative";
                                }
                                
                                <div class="backtest-result">
                                    <div class="backtest-metric">
                                        <span class="metric-label">Portföy Getirisi:</span>
                                        <span class="metric-value @portfolioClass">@portfolioReturn.ToString("F2")%</span>
                                    </div>
                                    <div class="backtest-metric">
                                        <span class="metric-label">S&P 500 Getirisi:</span>
                                        <span class="metric-value">@sp500Return.ToString("F2")%</span>
                                    </div>
                                    <div class="backtest-metric">
                                        <span class="metric-label">Outperformance:</span>
                                        <span class="metric-value @outperfClass">@outperformance.ToString("F2")%</span>
                                    </div>
                                    
                                    @if (backtestResult.ContainsKey("stock_breakdown") && backtestResult["stock_breakdown"].ValueKind == System.Text.Json.JsonValueKind.Array)
                                    {
                                        <div class="backtest-breakdown">
                                            <h4>📊 Hisse Bazlı Detaylar:</h4>
                                            <table class="breakdown-table">
                                                <thead>
                                                    <tr>
                                                        <th>Hisse</th>
                                                        <th>Başlangıç Fiyatı (1M önce)</th>
                                                        <th>Güncel Fiyat</th>
                                                        <th>Değişim %</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var stock in backtestResult["stock_breakdown"].EnumerateArray())
                                                    {
                                                        string symbol = "-";
                                                        double startPrice = 0;
                                                        double currentPrice = 0;
                                                        double changePercent = 0;
                                                        string changeClass = "negative";
                                                        
                                                        if (stock.TryGetProperty("symbol", out var sym) && sym.ValueKind == System.Text.Json.JsonValueKind.String)
                                                            symbol = sym.GetString() ?? "-";
                                                        
                                                        if (stock.TryGetProperty("start_price", out var sp) && sp.ValueKind == System.Text.Json.JsonValueKind.Number)
                                                            startPrice = sp.GetDouble();
                                                        
                                                        if (stock.TryGetProperty("current_price", out var cp) && cp.ValueKind == System.Text.Json.JsonValueKind.Number)
                                                            currentPrice = cp.GetDouble();
                                                        
                                                        if (stock.TryGetProperty("change_percent", out var chg) && chg.ValueKind == System.Text.Json.JsonValueKind.Number)
                                                        {
                                                            changePercent = chg.GetDouble();
                                                            changeClass = changePercent >= 0 ? "positive" : "negative";
                                                        }
                                                        
                                                        <tr>
                                                            <td><strong>@symbol</strong></td>
                                                            <td>$@startPrice.ToString("F2")</td>
                                                            <td>$@currentPrice.ToString("F2")</td>
                                                            <td class="@changeClass">@changePercent.ToString("F2")%</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                        
                                        @if (backtestResult.ContainsKey("ai_commentary"))
                                        {
                                            string commentary = "-";
                                            string bestPerf = "-";
                                            string worstPerf = "-";
                                            string recommendation = "-";
                                            
                                            var aiComm = backtestResult["ai_commentary"];
                                            if (aiComm.ValueKind == System.Text.Json.JsonValueKind.Object)
                                            {
                                                if (aiComm.TryGetProperty("yorum", out var yorum) && yorum.ValueKind == System.Text.Json.JsonValueKind.String)
                                                    commentary = yorum.GetString() ?? "-";
                                                
                                                if (aiComm.TryGetProperty("en_iyi_performans", out var best) && best.ValueKind == System.Text.Json.JsonValueKind.String)
                                                    bestPerf = best.GetString() ?? "-";
                                                
                                                if (aiComm.TryGetProperty("en_kotu_performans", out var worst) && worst.ValueKind == System.Text.Json.JsonValueKind.String)
                                                    worstPerf = worst.GetString() ?? "-";
                                                
                                                if (aiComm.TryGetProperty("oneri", out var rec) && rec.ValueKind == System.Text.Json.JsonValueKind.String)
                                                    recommendation = rec.GetString() ?? "-";
                                            }
                                            
                                            <div class="backtest-commentary">
                                                <h4>🤖 AI Yorumu:</h4>
                                                <p class="commentary-text">@commentary</p>
                                                <div class="commentary-details">
                                                    <p><strong>En İyi Performans:</strong> @bestPerf</p>
                                                    <p><strong>En Kötü Performans:</strong> @worstPerf</p>
                                                    <p><strong>Öneri:</strong> @recommendation</p>
                                                </div>
                                            </div>
                                        }
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>

                <!-- Section 4: Whale Watch -->
                <div class="accordion-item">
                    <div class="accordion-header" @onclick="() => ToggleSection(4)">
                        <h3>🐋 Balina (Whale) Radar</h3>
                        <span class="accordion-icon">@(section4Open ? "▼" : "▶")</span>
                    </div>
                    @if (section4Open)
                    {
                        <div class="accordion-content">
                            <button @onclick="WatchWhales" class="btn btn-primary" disabled="@isWatching">
                                @if (isWatching) { <span>Taranıyor...</span> } else { <span>Balina Aktivitesini Kontrol Et</span> }
                            </button>
                            
                            @if (whaleData != null && whaleData.ContainsKey("whale_activity"))
                            {
                                <div class="whale-list">
                                    <h4>🐋 Büyük Fon Pozisyonları:</h4>
                                    @if (whaleData["whale_activity"].GetArrayLength() == 0)
                                    {
                                        <p class="no-data">Balina aktivitesi bulunamadı.</p>
                                    }
                                    else
                                    {
                                        <table class="whale-table" style="width: 100%; border-collapse: collapse; margin-top: 16px;">
                                            <thead>
                                                <tr style="background: rgba(255, 255, 255, 0.05); border-bottom: 1px solid rgba(255, 255, 255, 0.1);">
                                                    <th style="padding: 12px; text-align: left; color: #ffffff; font-weight: 600;">Sembol</th>
                                                    <th style="padding: 12px; text-align: left; color: #ffffff; font-weight: 600;">Fon</th>
                                                    <th style="padding: 12px; text-align: right; color: #ffffff; font-weight: 600;">Hisse</th>
                                                    <th style="padding: 12px; text-align: right; color: #ffffff; font-weight: 600;">Değer</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var whale in whaleData["whale_activity"].EnumerateArray())
                                                {
                                                    string symbol = "-";
                                                    string holder = "-";
                                                    string sharesDisplay = "-";
                                                    string valueDisplay = "-";
                                                    
                                                    if (whale.TryGetProperty("symbol", out var sym) && sym.ValueKind == System.Text.Json.JsonValueKind.String)
                                                    {
                                                        symbol = sym.GetString() ?? "-";
                                                    }
                                                    
                                                    if (whale.TryGetProperty("holder", out var holderProp) && holderProp.ValueKind == System.Text.Json.JsonValueKind.String)
                                                    {
                                                        holder = holderProp.GetString() ?? "-";
                                                    }
                                                    
                                                    if (whale.TryGetProperty("shares", out var sharesProp) && sharesProp.ValueKind == System.Text.Json.JsonValueKind.Number)
                                                    {
                                                        long shares = sharesProp.GetInt64();
                                                        sharesDisplay = FormatNumber(shares);
                                                    }
                                                    
                                                    if (whale.TryGetProperty("value", out var valueProp) && valueProp.ValueKind == System.Text.Json.JsonValueKind.Number)
                                                    {
                                                        double value = valueProp.GetDouble();
                                                        valueDisplay = FormatCurrency(value);
                                                    }
                                                    
                                                    <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.05);">
                                                        <td style="padding: 12px; color: #ffffff; font-weight: 600;">@symbol</td>
                                                        <td style="padding: 12px; color: rgba(255, 255, 255, 0.8);">@holder</td>
                                                        <td style="padding: 12px; text-align: right; color: rgba(255, 255, 255, 0.8);">@sharesDisplay</td>
                                                        <td style="padding: 12px; text-align: right; color: #3fb950; font-weight: 600;">@valueDisplay</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    }
                                    
                                    <!-- Insider Transactions Table -->
                                    @if (whaleData != null && whaleData.ContainsKey("insider_transactions"))
                                    {
                                        <div style="margin-top: 32px;">
                                            <h4>👔 Son Insider İşlemleri:</h4>
                                            @if (whaleData["insider_transactions"].GetArrayLength() == 0)
                                            {
                                                <p class="no-data">Insider işlemi bulunamadı.</p>
                                            }
                                            else
                                            {
                                                <table class="whale-table" style="width: 100%; border-collapse: collapse; margin-top: 16px;">
                                                    <thead>
                                                        <tr style="background: rgba(255, 255, 255, 0.05); border-bottom: 1px solid rgba(255, 255, 255, 0.1);">
                                                            <th style="padding: 12px; text-align: left; color: #ffffff; font-weight: 600;">Sembol</th>
                                                            <th style="padding: 12px; text-align: left; color: #ffffff; font-weight: 600;">Kişi</th>
                                                            <th style="padding: 12px; text-align: center; color: #ffffff; font-weight: 600;">Tip</th>
                                                            <th style="padding: 12px; text-align: right; color: #ffffff; font-weight: 600;">Hisse</th>
                                                            <th style="padding: 12px; text-align: left; color: #ffffff; font-weight: 600;">Tarih</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var insider in whaleData["insider_transactions"].EnumerateArray())
                                                        {
                                                            string symbol = "-";
                                                            string person = "-";
                                                            string type = "-";
                                                            string sharesDisplay = "-";
                                                            string date = "-";
                                                            string typeClass = "";
                                                            
                                                            if (insider.TryGetProperty("symbol", out var sym) && sym.ValueKind == System.Text.Json.JsonValueKind.String)
                                                            {
                                                                symbol = sym.GetString() ?? "-";
                                                            }
                                                            
                                                            if (insider.TryGetProperty("person", out var personProp) && personProp.ValueKind == System.Text.Json.JsonValueKind.String)
                                                            {
                                                                person = personProp.GetString() ?? "-";
                                                            }
                                                            
                                                            if (insider.TryGetProperty("type", out var typeProp) && typeProp.ValueKind == System.Text.Json.JsonValueKind.String)
                                                            {
                                                                type = typeProp.GetString() ?? "-";
                                                                typeClass = type == "BUY" ? "positive" : "negative";
                                                            }
                                                            
                                                            if (insider.TryGetProperty("shares", out var sharesProp) && sharesProp.ValueKind == System.Text.Json.JsonValueKind.Number)
                                                            {
                                                                long shares = sharesProp.GetInt64();
                                                                sharesDisplay = FormatNumber(shares);
                                                            }
                                                            
                                                            if (insider.TryGetProperty("date", out var dateProp) && dateProp.ValueKind == System.Text.Json.JsonValueKind.String)
                                                            {
                                                                date = dateProp.GetString() ?? "-";
                                                            }
                                                            
                                                            <tr style="border-bottom: 1px solid rgba(255, 255, 255, 0.05);">
                                                                <td style="padding: 12px; color: #ffffff; font-weight: 600;">@symbol</td>
                                                                <td style="padding: 12px; color: rgba(255, 255, 255, 0.8);">@person</td>
                                                                <td style="padding: 12px; text-align: center;">
                                                                    <span class="@typeClass" style="font-weight: 600;">@type</span>
                                                                </td>
                                                                <td style="padding: 12px; text-align: right; color: rgba(255, 255, 255, 0.8);">@sharesDisplay</td>
                                                                <td style="padding: 12px; color: rgba(255, 255, 255, 0.6); font-size: 0.9rem;">@date</td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                            else if (whaleData != null && whaleData.ContainsKey("success"))
                            {
                                string errorMessage = "Veri yüklenemedi.";
                                if (whaleData["success"].ValueKind == System.Text.Json.JsonValueKind.False)
                                {
                                    if (whaleData.ContainsKey("message") && whaleData["message"].ValueKind == System.Text.Json.JsonValueKind.String)
                                    {
                                        errorMessage = whaleData["message"].GetString() ?? "Veri yüklenemedi.";
                                    }
                                    <p class="no-data">@errorMessage</p>
                                }
                            }
                        </div>
                    }
                </div>
            </div>
            </div>
            </div>
    }
    else if (activeTab == "Geçmiş")
    {
            <div class="max-w-5xl mx-auto space-y-8">
                <div class="flex items-end justify-between border-b border-[#3a4a3f]/20 pb-6">
