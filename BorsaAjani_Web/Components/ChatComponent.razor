@rendermode @(RenderMode.InteractiveServer)
@using System.Text.Json
@using BorsaAjani_Web.Services
@using Microsoft.AspNetCore.Components.Web
@inject IHttpClientFactory HttpClientFactory
@inject ChatContextService ContextService
@implements IAsyncDisposable

<div class="chat-container">
    <!-- Floating Action Button -->
    <button class="chat-fab" @onclick="ToggleChat" type="button" title="AI Investment Mentor">
        💬
    </button>

    <!-- Chat Window -->
    @if (isOpen)
    {
        <div class="chat-window">
            <div class="chat-header">
                <h3>🤖 AI Investment Mentor</h3>
                <button class="chat-close" @onclick="ToggleChat">✕</button>
            </div>

            @if (!string.IsNullOrWhiteSpace(chatUnavailableReason))
            {
                <div class="chat-banner" role="alert">
                    <div class="chat-banner__title">Chat unavailable</div>
                    <div class="chat-banner__text">@chatUnavailableReason</div>
                    <div class="chat-banner__hint">Try again, or use QUICK analysis from the main screen.</div>
                </div>
            }
            
            <div class="chat-messages" @ref="messagesContainer">
                @foreach (var message in messages)
                {
                    <div class="message @message.Type">
                        <div class="message-content">@message.Text</div>
                        <div class="message-time">@message.Time.ToString("HH:mm")</div>
                    </div>
                }
                @if (isLoading)
                {
                    <div class="message bot">
                        <div class="message-content">
                            <span class="typing-indicator">...</span>
                        </div>
                    </div>
                }
            </div>
            
            <div class="chat-input-container">
                <input 
                    @bind="currentMessage" 
                    @bind:event="oninput"
                    @onkeypress="HandleKeyPress"
                    placeholder="Sorunuzu yazın... (örn: Bu hisseyi şimdi almalı mıyım?)"
                    class="chat-input"
                    disabled="@isLoading"
                />
                <button 
                    @onclick="SendMessage" 
                    class="chat-send"
                    disabled="@(isLoading || string.IsNullOrWhiteSpace(currentMessage))"
                >
                    ➤
                </button>
            </div>
        </div>
    }
</div>

@code {
    private bool isOpen = false;
    private string currentMessage = "";
    private bool isLoading = false;
    private ElementReference messagesContainer;
    private List<ChatMessage> messages = new();
    private string? chatUnavailableReason;

    private class ChatMessage
    {
        public string Text { get; set; } = "";
        public string Type { get; set; } = "user"; // CSS class: "user" or "bot"
        public string Role { get; set; } = "user"; // API role: "user" or "assistant"
        public DateTime Time { get; set; } = DateTime.Now;
    }

    private void ToggleChat(MouseEventArgs e)
    {
        isOpen = !isOpen;
        if (isOpen && messages.Count == 0)
        {
            messages.Add(new ChatMessage
            {
                Text = "Merhaba! Ben Mentor — kıdemli portföy yöneticiniz. Hangi hisse ya da yatırım konusunda konuşalım?",
                Type = "bot",
                Role = "assistant",
                Time = DateTime.Now
            });
        }
        StateHasChanged();
    }
    
    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(currentMessage) || isLoading) return;

        var userText = currentMessage.Trim();
        messages.Add(new ChatMessage { Text = userText, Type = "user", Role = "user", Time = DateTime.Now });
        currentMessage = "";
        isLoading = true;
        chatUnavailableReason = null;
        StateHasChanged();
        await ScrollToBottom();

        try
        {
            var client = HttpClientFactory.CreateClient("BackendApi");

            // Build conversation history for multi-turn context (all but last user msg)
            var history = messages
                .Take(messages.Count - 1)
                .Select(m => new { role = m.Role, text = m.Text })
                .ToList();

            // Context from current analysis (symbol, price, decision etc)
            var contextDict = ContextService.GetContext() ?? new Dictionary<string, object>();

            var requestBody = new { user_message = userText, context_data = contextDict, history };
            var json = JsonSerializer.Serialize(requestBody);
            var content = new StringContent(json, System.Text.Encoding.UTF8, "application/json");

            var response = await client.PostAsync("/mentor/chat", content);
            string reply;

            if (response.IsSuccessStatusCode)
            {
                var respJson = await response.Content.ReadAsStringAsync();
                using var doc = JsonDocument.Parse(respJson);
                reply = doc.RootElement.TryGetProperty("reply", out var r)
                    ? r.GetString() ?? "Cevap alınamadı."
                    : "Cevap alınamadı.";
            }
            else
            {
                reply = $"Bağlantı hatası ({(int)response.StatusCode}).";
                chatUnavailableReason = reply;
            }

            messages.Add(new ChatMessage { Text = reply, Type = "bot", Role = "assistant", Time = DateTime.Now });

        }
        catch (Exception ex)
        {
            messages.Add(new ChatMessage { Text = $"Hata: {ex.Message}", Type = "bot", Role = "assistant", Time = DateTime.Now });
            chatUnavailableReason = ex.Message;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
            await ScrollToBottom();
        }
    }
    
    private async Task HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SendMessage();
        }
    }
    
    private async Task ScrollToBottom()
    {
        try
        {
            await Task.Delay(50);
            // Use JS interop to scroll
            // For now, just trigger StateHasChanged
        }
        catch { }
    }
    
    public ValueTask DisposeAsync()
    {
        // Cleanup if needed
        return ValueTask.CompletedTask;
    }
}

<style>
    .chat-container {
        position: fixed;
        bottom: 20px;
        right: 20px;
        z-index: 10000;
        pointer-events: none;
    }
    
    .chat-container * {
        pointer-events: auto;
    }

    .chat-fab {
        width: 52px;
        height: 52px;
        border-radius: 50%;
        background: #00FFA3;
        border: none;
        color: #003920;
        font-size: 22px;
        cursor: pointer;
        box-shadow: 0 4px 16px rgba(0, 255, 163, 0.35);
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        z-index: 1001;
        pointer-events: auto;
        font-weight: 700;
    }

    .chat-fab:hover {
        transform: scale(1.08);
        box-shadow: 0 6px 24px rgba(0, 255, 163, 0.5);
        background: #52ffac;
    }

    .chat-window {
        position: absolute;
        bottom: 68px;
        right: 0;
        width: 380px;
        height: 560px;
        background: #171f33;
        backdrop-filter: blur(10px);
        border: 1px solid rgba(0, 255, 163, 0.12);
        border-radius: 12px;
        display: flex;
        flex-direction: column;
        box-shadow: 0 8px 40px rgba(0, 0, 0, 0.6);
    }

    .chat-banner{
        margin: 12px 16px 0 16px;
        padding: 10px 12px;
        border-radius: 10px;
        background: rgba(248, 81, 73, 0.15);
        border: 1px solid rgba(248, 81, 73, 0.35);
        color: #fff;
    }
    .chat-banner__title{
        font-weight: 800;
        font-size: .9rem;
        margin-bottom: 4px;
    }
    .chat-banner__text{
        color: rgba(255,255,255,.85);
        font-size: .85rem;
        line-height: 1.35;
    }
    .chat-banner__hint{
        margin-top: 6px;
        color: rgba(255,255,255,.7);
        font-size: .8rem;
    }

    .chat-header {
        padding: 14px 16px;
        border-bottom: 1px solid rgba(0, 255, 163, 0.1);
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: #131b2e;
        border-radius: 12px 12px 0 0;
    }

    .chat-header h3 {
        margin: 0;
        color: #fff;
        font-size: 1rem;
    }

    .chat-close {
        background: none;
        border: none;
        color: #8b949e;
        font-size: 20px;
        cursor: pointer;
        padding: 4px 8px;
        border-radius: 4px;
        transition: all 0.2s;
    }

    .chat-close:hover {
        background: rgba(248, 81, 73, 0.2);
        color: #f85149;
    }

    .chat-messages {
        flex: 1;
        overflow-y: auto;
        padding: 16px;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .message {
        display: flex;
        flex-direction: column;
        max-width: 80%;
        animation: fadeIn 0.3s ease;
    }

    .message.user {
        align-self: flex-end;
    }

    .message.bot {
        align-self: flex-start;
    }

    .message-content {
        padding: 10px 14px;
        border-radius: 12px;
        word-wrap: break-word;
        line-height: 1.5;
    }

    .message.user .message-content {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border-bottom-right-radius: 4px;
    }

    .message.bot .message-content {
        background: rgba(48, 54, 61, 0.6);
        color: #c9d1d9;
        border-bottom-left-radius: 4px;
        white-space: pre-wrap;
    }

    .message-time {
        font-size: 0.7rem;
        color: #8b949e;
        margin-top: 4px;
        padding: 0 4px;
    }

    .typing-indicator {
        display: inline-block;
        animation: typing 1.4s infinite;
    }

    @@keyframes typing {
        0%, 60%, 100% { opacity: 0.3; }
        30% { opacity: 1; }
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .chat-input-container {
        padding: 12px;
        border-top: 1px solid rgba(48, 54, 61, 0.5);
        display: flex;
        gap: 8px;
        background: rgba(33, 38, 45, 0.6);
        border-radius: 0 0 12px 12px;
    }

    .chat-input {
        flex: 1;
        padding: 10px 14px;
        background: rgba(13, 17, 23, 0.6);
        border: 1px solid rgba(48, 54, 61, 0.5);
        border-radius: 8px;
        color: #c9d1d9;
        font-size: 0.9rem;
        outline: none;
    }

    .chat-input:focus {
        border-color: #667eea;
    }

    .chat-input:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    .chat-send {
        padding: 10px 16px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none;
        border-radius: 8px;
        color: white;
        font-size: 18px;
        cursor: pointer;
        transition: all 0.2s;
    }

    .chat-send:hover:not(:disabled) {
        transform: scale(1.05);
    }

    .chat-send:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    /* Scrollbar styling */
    .chat-messages::-webkit-scrollbar {
        width: 6px;
    }

    .chat-messages::-webkit-scrollbar-track {
        background: rgba(13, 17, 23, 0.3);
        border-radius: 3px;
    }

    .chat-messages::-webkit-scrollbar-thumb {
        background: rgba(48, 54, 61, 0.6);
        border-radius: 3px;
    }

    .chat-messages::-webkit-scrollbar-thumb:hover {
        background: rgba(48, 54, 61, 0.8);
    }
</style>
